{
 "namespace": "Navigate",
 "cpp2lean": [
  "--nest",
  "--world",
  "--param-class",
  "Param=float",
  "--boundary-fn",
  "clk::now_ms",
  "--lib-dir",
  "examples/navlib",
  "--drop",
  "printf",
  "--drop",
  "Navigator::step::logged"
 ],
 "world": {
  "globals": [
   "#include \"navigate_env.h\""
  ],
  "cxx_include": [
   "\"navigate.cpp\""
  ],
  "inputs": {
   "navigator.now_ms": "nav_now = %s;"
  },
  "quiet_console": true,
  "monotonic": {
   "navigator.now_ms": [
    0,
    10
   ]
  },
  "ranges": {
   "speed": [
    0.5,
    10
   ],
   "dt": [
    0.0025,
    0.1
   ],
   "v": [
    -5,
    5
   ],
   "t": [
    0,
    10
   ],
   "first": [
    0,
    6
   ],
   "last": [
    0,
    6
   ],
   "a": [
    -10,
    10
   ],
   "b": [
    -10,
    10
   ]
  },
  "domains": {
   "navigator.fill.first": [
    0,
    255
   ],
   "navigator.fill.last": [
    0,
    254
   ]
  },
  "weights": {
   "navigator.step": 6,
   "navigator.start": 2
  },
  "calls": 20000
 }
}