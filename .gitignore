# build products
lean/.lake/
contracts/.lake/
build/
__pycache__/
sim/__pycache__/
*.olean
*.ilean

# local links (ArduPilot checkout, python venv)
ardupilot/src
ardupilot/*_driver.cpp
sim/.venv

# flight traces and render work files are large; keep the summaries
sim/out/*
!sim/out/README.md
!sim/out/montecarlo*/
sim/out/montecarlo*/runs/
sim/out/montecarlo*/*.csv.gz
!sim/out/lean-course-1ms/
!sim/out/ref-course-1ms/
sim/out/lean-course-1ms/*.png
sim/out/ref-course-1ms/*.png
sim/out/lean-course-1ms/trace.txt
sim/out/ref-course-1ms/trace.txt
!sim/out/gorge-port-x500/
!sim/out/gorge-port-x500-fast/
sim/out/gorge-port-x500*/*
!sim/out/gorge-port-x500*/gorge-port.mp4
!sim/out/gorge-port-x500*/gorge-port-*.png
sim/figs/out/

