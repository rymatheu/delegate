  idx := Int64.toUInt64 (Int32.toInt64 (2 : Int32)) * (ki % Int64.toUInt64 (Int32.toInt64 ((1 : Int32) <<< (7 : Int32))))
  top := ki <<< Int64.toUInt64 (Int32.toInt64 ((52 : Int32) - (7 : Int32)))
  tail := Binary64.ofBits __exp_data.tab[UInt64.toNat idx]!
  sbits := __exp_data.tab[UInt64.toNat (idx + Int64.toUInt64 (Int32.toInt64 (1 : Int32)))]! + top
  r2 := r * r
  tmp := tail + r + r2 * (__exp_data.poly[Int32.toNatClampNeg ((5 : Int32) - (5 : Int32))]! + r * __exp_data.poly[Int32.toNatClampNeg ((6 : Int32) - (5 : Int32))]!) + r2 * r2 * (__exp_data.poly[Int32.toNatClampNeg ((7 : Int32) - (5 : Int32))]! + r * __exp_data.poly[Int32.toNatClampNeg ((8 : Int32) - (5 : Int32))]!)
  if abstop == Int32.toUInt32 (0 : Int32) then
    return specialcase tmp sbits ki
  scale := Binary64.ofBits sbits
  return eval_as_double (scale + scale * tmp)

end Musl.exp
