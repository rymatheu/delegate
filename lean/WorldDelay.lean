/-- C++ `bool Baro::healthy() const`, `examples/worlddelay.cpp:157`. -/
def healthy (s : State) (w : World) : Bool := Id.run do
  return decide (UInt32.toInt32 (UInt8.toUInt32 s._num_sensors) > (0 : Int32)) && decide (WorldDelay.millis w - s._last_ms[Int32.toNatClampNeg (0 : Int32)]! < Int32.toUInt32 (100 : Int32)) && decide (s._count > Int32.toUInt32 (0 : Int32))

/-- C++ `void Baro::calibrate()`, `examples/worlddelay.cpp:206-227`. -/
def calibrate (s : State) (w : World) : State × World := Id.run do
  let mut s := s
  let mut w := w
  s := { s with _failed := false }
  for _ in [0:2] do
    let tstart : UInt32 := WorldDelay.millis w
    for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
      let (t'1, t'2) := update s w
      w := t'2
      s := t'1
      if decide (WorldDelay.millis w - tstart > Int32.toUInt32 (50 : Int32)) || Scheduler.exhausted w.hal_scheduler then
        s := { s with _failed := true }
        return (s, w)
      w := { w with barometer := s }  -- this object's state into the World: the call reaches it
      let (t'3, t'4) := Scheduler.delay w.hal_scheduler w (Int16.toUInt16 (Int32.toInt16 (10 : Int32)))
      w := t'4
      w := { w with hal_scheduler := t'3 }
      s := w.barometer  -- this object's state as the call left it
      if !(!(healthy s w)) then break
  let mut sum : Binary32 := (Binary32.ofBits 0x00000000 /- 0 -/)
  for _ in [0:3] do
    let (t'5, t'6) := update s w
    w := t'6
    s := t'5
    sum := sum + s._pressure[Int32.toNatClampNeg (0 : Int32)]!
    w := { w with barometer := s }  -- this object's state into the World: the call reaches it
    let (t'7, t'8) := Scheduler.delay w.hal_scheduler w (Int16.toUInt16 (Int32.toInt16 (20 : Int32)))
    w := t'8
    w := { w with hal_scheduler := t'7 }
    s := w.barometer  -- this object's state as the call left it
  s := { s with _ground := sum / (Binary32.ofBits 0x40400000 /- 3 -/) }
  return (s, w)

