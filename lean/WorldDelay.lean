/-- C++ `void Baro::init()`, `examples/worlddelay.cpp:198-203`. -/
def init (s : State) (w : World) : State × World := Id.run do
  let mut s := s
  let mut w := w
  if UInt32.toInt32 (UInt8.toUInt32 s._num_drivers) < (2 : Int32) then
