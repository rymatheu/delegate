/-- C++ `void Scheduler::step()`, `examples/worlddelay.cpp:95-109`. -/
def step (s : State) (w : World) : State × World := Id.run do
  let mut s := s
  let mut w := w
  if UInt32.toInt32 (UInt16.toUInt32 s._count) == (0 : Int32) then
    s := { s with _exhausted := true }
    return (s, w)
  s := { s with _in := s._recs[UInt16.toNat s._head]! }
  s := { s with _head := Int16.toUInt16 (Int32.toInt16 ((UInt32.toInt32 (UInt16.toUInt32 s._head) + (1 : Int32)) % (48 : Int32))) }
  s := { s with _count := s._count - (1 : UInt16) }
  s := { s with _clock_us := s._in.t_us }
  let mut i : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    if !(decide (UInt32.toInt32 (UInt8.toUInt32 i) < UInt32.toInt32 (UInt8.toUInt32 s._num_timer))) then break
    if (s._timer_proc[UInt8.toNat i]! != WFun.null) then
      w := { w with hal_scheduler := s }  -- this object's state into the World: the call reaches it
      w := WFun.call s._timer_proc[UInt8.toNat i]! w
      s := w.hal_scheduler  -- this object's state as the call left it
    i := i + (1 : UInt8)
  return (s, w)

/-- C++ `void Scheduler::delay_microseconds(uint16_t usec)`, `examples/worlddelay.cpp:64-69`. -/
def delay_microseconds (s : State) (w : World) (usec : UInt16) : State × World := Id.run do
  let mut s := s
  let mut w := w
  let start : UInt64 := s._clock_us
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    if !(decide (s._clock_us - start < UInt16.toUInt64 usec) && !s._exhausted) then break
    let (t'1, t'2) := step s w
    w := t'2
    s := t'1
  return (s, w)

/-- C++ `void Scheduler::delay(uint16_t ms)`, `examples/worlddelay.cpp:71-78`. -/
def delay (s : State) (w : World) (ms : UInt16) : State × World := Id.run do
  let mut s := s
  let mut w := w
  let start : UInt32 := UInt64.toUInt32 (s._clock_us / Int64.toUInt64 (Int32.toInt64 (1000 : Int32)))
  let mut now : UInt32 := start
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    let (t'1, t'2) := delay_microseconds s w (Int16.toUInt16 (Int32.toInt16 (1000 : Int32)))
    w := t'2
    s := t'1
    now := UInt64.toUInt32 (s._clock_us / Int64.toUInt64 (Int32.toInt64 (1000 : Int32)))
    if !(decide (now - start < UInt16.toUInt32 ms) && !s._exhausted) then break
  return (s, w)

/-- C++ `void Scheduler::register_timer_process(MemberProc proc)`, `examples/worlddelay.cpp:79-88`. -/
def register_timer_process (s : State) (proc : WFun) : State := Id.run do
  let mut s := s
  let mut i : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    if !(decide (UInt32.toInt32 (UInt8.toUInt32 i) < UInt32.toInt32 (UInt8.toUInt32 s._num_timer))) then break
    if s._timer_proc[UInt8.toNat i]! == proc then
      return s
    i := i + (1 : UInt8)
  if UInt32.toInt32 (UInt8.toUInt32 s._num_timer) < (4 : Int32) then
    let t'1 := s._num_timer
    s := { s with _num_timer := s._num_timer + (1 : UInt8) }
    s := { s with _timer_proc := s._timer_proc.set! (UInt8.toNat t'1) proc }
  return s

