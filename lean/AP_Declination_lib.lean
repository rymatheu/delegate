  if latitude_deg ≥ SAMPLING_MAX_LAT then
    min_lat := Int32.toBinary32 (Binary32.toInt32 (Int32.toBinary32 (Binary32.toInt32 (latitude_deg / SAMPLING_RES)) * SAMPLING_RES - SAMPLING_RES))
    valid_input_data := false
  if longitude_deg ≤ SAMPLING_MIN_LON then
    min_lon := Int32.toBinary32 (Binary32.toInt32 SAMPLING_MIN_LON)
    valid_input_data := false
  if longitude_deg ≥ SAMPLING_MAX_LON then
    min_lon := Int32.toBinary32 (Binary32.toInt32 (Int32.toBinary32 (Binary32.toInt32 (longitude_deg / SAMPLING_RES)) * SAMPLING_RES - SAMPLING_RES))
    valid_input_data := false
