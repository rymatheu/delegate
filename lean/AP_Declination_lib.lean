  let sp : Binary32 := Musl.sinf.sinf pitch
  let sr : Binary32 := Musl.sinf.sinf roll
  let cr : Binary32 := Musl.cosf.cosf roll
  let sy : Binary32 := Musl.sinf.sinf yaw
  let cy : Binary32 := Musl.cosf.cosf yaw
  s := { s with a.x := cp * cy }
  s := { s with a.y := (sr * sp * cy) - (cr * sy) }
  s := { s with a.z := (cr * sp * cy) + (sr * sy) }
  s := { s with b.x := cp * sy }
  s := { s with b.y := (sr * sp * sy) + (cr * cy) }
  s := { s with b.z := (cr * sp * sy) - (sr * cy) }
  s := { s with c.x := -sp }
  s := { s with c.y := sr * cp }
  s := { s with c.z := cr * cp }
  return s

end Matrix3f

namespace Vector3f

/-- C++ `Vector3<float>::Vector3(const float x0, const float y0, const float z0)`, `AP_Math/vector3.h:85-88`. -/
def init_float3 (x0 : Binary32) (y0 : Binary32) (z0 : Binary32) : State := Id.run do
  let mut s : State := {}
  s := { s with x := x0 }
  s := { s with y := y0 }
  s := { s with z := z0 }
  return s

end Vector3f

namespace Matrix3f

/-- C++ `Vector3<float> Matrix3<float>::operator*(const Vector3<float> & v) const`, `AP_Math/matrix3.cpp:146-151`. -/
def op_mul_Vector3f (s : State) (v : Vector3f.State) : Vector3f.State := Id.run do
  return Vector3f.init_float3 (s.a.x * v.x + s.a.y * v.y + s.a.z * v.z) (s.b.x * v.x + s.b.y * v.y + s.b.z * v.z) (s.c.x * v.x + s.c.y * v.y + s.c.z * v.z)

end Matrix3f

namespace AP_Declination

/-- C++ `static Vector3f AP_Declination::get_earth_field_ga(const Location & loc)`, `AP_Declination/AP_Declination.cpp:134-146`. -/
def get_earth_field_ga (loc : Location.State) : Vector3f.State := Id.run do
  let mut declination_deg : Binary32 := (Binary32.ofBits 0x00000000 /- 0 -/)
  let mut inclination_deg : Binary32 := (Binary32.ofBits 0x00000000 /- 0 -/)
  let mut intensity_gauss : Binary32 := (Binary32.ofBits 0x00000000 /- 0 -/)
  let (t'1, t'2, t'3, _) := get_mag_field_ef (Int32.toBinary32 loc.lat * (Binary32.ofBits 0x33d6bf95 /- 1.0e-7f -/)) (Int32.toBinary32 loc.lng * (Binary32.ofBits 0x33d6bf95 /- 1.0e-7f -/)) intensity_gauss declination_deg inclination_deg
  intensity_gauss := t'1
  declination_deg := t'2
  inclination_deg := t'3
  let mut mag_ef : Vector3f.State := Vector3f.init_float3 intensity_gauss (Binary32.ofBits 0x00000000 /- 0.0 -/) (Binary32.ofBits 0x00000000 /- 0.0 -/)
  let mut R : Matrix3f.State := Matrix3f.init_void
  R := Matrix3f.from_euler R (Binary32.ofBits 0x00000000 /- 0.0f -/) (-(AP_Declination_lib.radians_float inclination_deg)) (AP_Declination_lib.radians_float declination_deg)
  mag_ef := Matrix3f.op_mul_Vector3f R mag_ef
  return mag_ef

/-- C++ `static float AP_Declination::get_declination(float latitude_deg, float longitude_deg)`, `AP_Declination/AP_Declination.cpp:122-129`. -/
def get_declination (latitude_deg longitude_deg : Binary32) : Binary32 := Id.run do
  let mut declination_deg : Binary32 := (Binary32.ofBits 0x00000000 /- 0 -/)
  let mut inclination_deg : Binary32 := (Binary32.ofBits 0x00000000 /- 0 -/)
  let mut intensity_gauss : Binary32 := (Binary32.ofBits 0x00000000 /- 0 -/)
  let (t'1, t'2, t'3, _) := get_mag_field_ef latitude_deg longitude_deg intensity_gauss declination_deg inclination_deg
  intensity_gauss := t'1
  declination_deg := t'2
  inclination_deg := t'3
  return declination_deg

end AP_Declination

