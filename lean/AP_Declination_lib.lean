  data_ne := (declination_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  data_nw := (declination_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat min_lon_index]!
  data_min := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_se - data_sw) + data_sw
  data_max := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_ne - data_nw) + data_nw
  declination_deg := ((latitude_deg - min_lat) / SAMPLING_RES) * (data_max - data_min) + data_min
  data_sw := (inclination_table[UInt32.toNat min_lat_index]!)[UInt32.toNat min_lon_index]!
  data_se := (inclination_table[UInt32.toNat min_lat_index]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  data_ne := (inclination_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
