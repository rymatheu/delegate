  let min_lon_index : UInt32 := Int32.toUInt32 (AP_Declination_lib.constrain_int32 (UInt32.toInt32 (Binary32.toUInt32 ((-SAMPLING_MIN_LON + min_lon) / SAMPLING_RES))) (0 : Int32) (UInt32.toInt32 (LON_TABLE_SIZE - Int32.toUInt32 (2 : Int32))))
  let mut data_sw : Binary32 := (intensity_table[UInt32.toNat min_lat_index]!)[UInt32.toNat min_lon_index]!
  let mut data_se : Binary32 := (intensity_table[UInt32.toNat min_lat_index]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  let mut data_ne : Binary32 := (intensity_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  let mut data_nw : Binary32 := (intensity_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat min_lon_index]!
  let mut data_min : Binary32 := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_se - data_sw) + data_sw
  let mut data_max : Binary32 := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_ne - data_nw) + data_nw
  intensity_gauss := ((latitude_deg - min_lat) / SAMPLING_RES) * (data_max - data_min) + data_min
