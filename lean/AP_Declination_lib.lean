def get_mag_field_ef (latitude_deg longitude_deg intensity_gauss declination_deg inclination_deg : Binary32) : Binary32 × Binary32 × Binary32 × Bool := Id.run do
  let mut intensity_gauss := intensity_gauss
  let mut declination_deg := declination_deg
  let mut inclination_deg := inclination_deg
  let mut valid_input_data : Bool := true
  let mut min_lat : Binary32 := Int32.toBinary32 (Binary32.toInt32 (Int32.toBinary32 (Binary32.toInt32 (Binary32.floor (latitude_deg / SAMPLING_RES))) * SAMPLING_RES))
  let mut min_lon : Binary32 := Int32.toBinary32 (Binary32.toInt32 (Int32.toBinary32 (Binary32.toInt32 (Binary32.floor (longitude_deg / SAMPLING_RES))) * SAMPLING_RES))
  if latitude_deg ≤ SAMPLING_MIN_LAT then
    min_lat := Int32.toBinary32 (Binary32.toInt32 SAMPLING_MIN_LAT)
