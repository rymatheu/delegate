  else
    let fac'2 : Binary32 := -(temp_slope * Sensors_lib.R_specific) / (Binary32.ofBits 0x411ce80a /- 9.80665016 -/)
    alt := Sensors_lib.atmospheric_1976_consts[UInt8.toNat idx]!.amsl_m + (Sensors_lib.atmospheric_1976_consts[UInt8.toNat idx]!.temp_K / Sensors_lib.atmospheric_1976_consts[UInt8.toNat idx]!.temp_lapse) * (Musl.powf.powf pressure_ratio fac'2 - (Binary32.ofBits 0x3f800000 /- 1 -/))
