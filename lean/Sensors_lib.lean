/-- C++ `void AP_Baro::update_calibration()`, `AP_Baro/AP_Baro.cpp:397-418`. -/
def update_calibration (s : State) (w : World) : State := Id.run do
  let mut s := s
  let now : UInt32 := Sensors_lib.millis w
  let do_notify : Bool := decide (now - s._last_notify_ms > Int32.toUInt32 (10000 : Int32))
  if do_notify then
    s := { s with _last_notify_ms := now }
  let t'1 : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  let t'2 : Int32 := UInt32.toInt32 (UInt8.toUInt32 s._num_sensors)
  for i' in [0:(t'2.toInt - (Int.ofNat t'1.toNat)).toNat] do  -- C++ loop bounded by a runtime value (--runtime-loops)
    let i : UInt8 := t'1 + Nat.toUInt8 i'
    if healthy_uint8_t s i then
      let corrected_pressure : Binary32 := get_sealevel_pressure s (get_pressure_uint8_t s i + s.sensors[UInt8.toNat i]!.p_correction) s._field_elevation_active
      s := { s with sensors := s.sensors.set! (UInt8.toNat i) ({ s.sensors[UInt8.toNat i]! with ground_pressure := AP_ParamT_float_4.set s.sensors[UInt8.toNat i]!.ground_pressure corrected_pressure }) }
    if do_notify then
      pure ()  -- C++ `AP_Param::notify(...)`: left out (--drop)
  s := { s with _guessed_ground_temperature := get_external_temperature_void s w }
  return s

/-- C++ `void AP_Baro::update_field_elevation()`, `AP_Baro/AP_Baro.cpp:1000-1038`. -/
def update_field_elevation (s : State) (w : World) (o : Outputs) (inp : Inputs) : State × Outputs := Id.run do
  let mut s := s
  let mut o := o
  let now_ms : UInt32 := Sensors_lib.millis w
  let mut new_field_elev : Bool := false
  let armed : Bool := inp.get_soft_armed
  if now_ms - s._field_elevation_last_ms ≥ Int32.toUInt32 (1000 : Int32) then
    if Sensors_lib.is_zero_float s._field_elevation_active && Sensors_lib.is_zero_AP_ParamT_float_4 s._field_elevation then
      let mut origin : Location.State := Location.init_void
      let mut t'1 := !armed
      if t'1 then
        origin := inp.get_origin_ret
        t'1 := inp.get_origin
      if t'1 then
        s := { s with _field_elevation_active := Int32.toBinary32 origin.alt * (Binary32.ofBits 0x3c23d70a /- 0.01 -/) }
        if Sensors_lib.is_zero_float s._field_elevation_active then
          s := { s with _field_elevation_active := (Binary32.ofBits 0x3a83126f /- 0.001f -/) }
        new_field_elev := true
    else if decide (Binary32.abs (s._field_elevation_active - AP_ParamT_float_4.op_to_float s._field_elevation) > (Binary32.ofBits 0x3f800000 /- 1.0 -/)) && !(Sensors_lib.is_zero_AP_ParamT_float_4 s._field_elevation) then
      if !armed then
        s := { s with _field_elevation_active := AP_ParamT_float_4.op_to_float s._field_elevation }
        new_field_elev := true
      else
        s := { s with _field_elevation := AP_ParamT_float_4.set s._field_elevation s._field_elevation_active }
        pure ()  -- C++ `AP_Param::notify(...)`: left out (--drop)
        pure ()  -- C++ `GCS::send_text(...)`: left out (--drop)
  if new_field_elev && !armed then
    s := { s with _field_elevation_last_ms := now_ms }
    o := o.push (Output.resetHeightDatum)
    s := update_calibration s w
    pure ()  -- C++ `GCS::send_text(...)`: left out (--drop)
  return (s, o)

