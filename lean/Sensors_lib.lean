def get_altitude_from_pressure (s : State) (pressure : Binary32) : Binary32 := Id.run do
  let idx : UInt8 := Sensors_lib.find_atmosphere_layer_by_pressure pressure
  let pressure_ratio : Binary32 := pressure / Sensors_lib.atmospheric_1976_consts[UInt8.toNat idx]!.pressure_Pa
  if !(Sensors_lib.is_positive_float pressure_ratio) then
    pure ()  -- C++ `AP_InternalError::error(...)`: left out (--drop)
    return get_altitude_AMSL_void s
  let mut alt : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0 -/)  -- uninitialized in C++; assigned before every read
  let temp_slope : Binary32 := Sensors_lib.atmospheric_1976_consts[UInt8.toNat idx]!.temp_lapse
  if Sensors_lib.is_zero_float temp_slope then
    let fac : Binary32 := -(Sensors_lib.atmospheric_1976_consts[UInt8.toNat idx]!.temp_K * Sensors_lib.R_specific) / (Binary32.ofBits 0x411ce80a /- 9.80665016 -/)
