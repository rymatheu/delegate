/-- C++ `static float AP_Baro::get_temperature_by_altitude_layer(float alt, int8_t idx)`, `AP_Baro/AP_Baro_atmosphere.cpp:149-155`. -/
def get_temperature_by_altitude_layer (alt : Binary32) (idx : Int8) : Binary32 := Id.run do
