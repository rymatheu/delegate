def coreBetterScore (s : State) (w : World) (new_core : UInt8) (current_core : UInt8) : Bool := Id.run do
  if !(NavEKF3_core.healthy w.heap'NavEKF3_core[((WPtr.index s.core) + (UInt8.toNat new_core))]!) then
