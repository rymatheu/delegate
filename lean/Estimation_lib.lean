  s := { s with accel_prev := accel }
  s := { s with accel_diff := (Binary64.ofBits 0x3fefae1480000000 /- 0.99f -/) * s.accel_diff + (Binary64.ofBits 0x3f847ae140000000 /- 0.01f -/) * Vector3p.length temp }
