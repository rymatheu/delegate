    r := { r with baro := decide (UInt32.toInt32 (UInt8.toUInt32 k) > (0 : Int32)) && UInt32.toInt32 (UInt16.toUInt32 i) % UInt32.toInt32 (UInt8.toUInt32 k) == (0 : Int32) }
