/-- C++ `Front::Front()`, `examples/insgps.cpp:125-131`. -/
def construct : State := Id.run do
  let mut s : State := {}
  s := { s with groups := (Array.replicate 2 Group.init) }
  s := { s with _avg := Vec.init_void }
  if false /- C++ `_singleton` -/ then
    s := { s with _count := Int8.toUInt8 (Int32.toInt8 (9 : Int32)) }
  pure ()  -- C++ `_singleton = this`: the pointer is the class's one World object (--world)
  return s

/-- C++ `void Front::init()`, `examples/insgps.cpp:133-146`. -/
def init (s : State) (inp : Inputs) : State := Id.run do
  let mut s := s
  let mut i : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    if !(decide (UInt32.toInt32 (UInt8.toUInt32 i) < (2 : Int32)) && decide (UInt32.toInt32 (UInt8.toUInt32 i) < (3 : Int32))) then break
    if decide (Int16.toInt32 s.groups[UInt8.toNat i]!.rate ≤ (0 : Int32)) || decide (Int16.toInt32 s.groups[UInt8.toNat i]!.rate > (20 : Int32)) then
      s := { s with groups := s.groups.set! (UInt8.toNat i) ({ s.groups[UInt8.toNat i]! with rate := Int32.toInt16 (20 : Int32) }) }
    i := i + (1 : UInt8)
  for i'2' in [0:2] do
    let i'2 : UInt8 := Nat.toUInt8 i'2'
    s := { s with ports := s.ports.set! (UInt8.toNat i'2) (if (inp.find_found_at.getD (UInt8.toNat i'2) false) then WPtr.port else WPtr.null) }
    s := { s with filters := s.filters.set! (UInt8.toNat i'2) (Filter.set_gain s.filters[UInt8.toNat i'2]! s.groups[UInt8.toNat i'2]!.gain) }
  return s

/-- C++ `Driver * Front::create(uint8_t i)`, `examples/insgps.cpp:148-158`. -/
def create (s : State) (w : World) (i : UInt8) : State × World × WPtr := Id.run do
  let mut s := s
  let mut w := w
  let mut port' : WPtr := s.ports[UInt8.toNat i]!
  if port' == WPtr.null then
    return (s, w, WPtr.null)
  if PortImpl.baud w.port < Int32.toUInt32 (19200 : Int32) then
    w := { w with port := PortImpl.begin w.port (Int32.toUInt32 (19200 : Int32)) }
  w := { w with front := s }  -- this object's state into the World: the call reaches it
  let (t'1, t'2) := SimDriver.init w (UInt8.toNat i) (UInt8.toNat i) port'
  w := t'2
  s := w.front  -- this object's state as the call left it
  let t'3 := w.heap'SimDriver.size
  w := { w with heap'SimDriver := w.heap'SimDriver.push t'1 }
  return (s, w, (WPtr.heap'SimDriver t'3))

/-- C++ `void Front::average(float v)`, `examples/insgps.cpp:198-206`. -/
def average (s : State) (v : Binary32) : State := Id.run do
  let mut s := s
  let mut acc : Array Vec.State := Array.replicate 2 {}  -- each element default-constructed (zero)
  for k' in [0:2] do
    let k : UInt8 := Nat.toUInt8 k'
    let (t'1, t'2) := Filter.apply s.filters[UInt8.toNat k]! (v + UInt8.toBinary32 k)
    s := { s with filters := s.filters.set! (UInt8.toNat k) t'1 }
    acc := acc.set! (UInt8.toNat k) ({ acc[UInt8.toNat k]! with x := t'2 })
    acc := acc.set! (UInt8.toNat k) ({ acc[UInt8.toNat k]! with y := s.fixes[UInt8.toNat k]!.speed })
  s := { s with _avg := Vec.init_float2 ((acc[0]!.x + acc[1]!.x) * (Binary32.ofBits 0x3f000000 /- 0.5f -/)) ((acc[0]!.y + acc[1]!.y) * (Binary32.ofBits 0x3f000000 /- 0.5f -/)) }
  return s

/-- C++ `void Front::update(float v)`, `examples/insgps.cpp:172-196`. -/
def update (s : State) (w : World) (v : Binary32) : State × World := Id.run do
  let mut s := s
  let mut w := w
  s := { s with _input := v }
  for i' in [0:2] do
    let i : UInt8 := Nat.toUInt8 i'
    if s.drivers[UInt8.toNat i]! == WPtr.null then
      let (t'1, t'2, t'3) := create s w (InsGps.pick i)
      w := t'2
      s := t'1
      s := { s with drivers := s.drivers.set! (UInt8.toNat i) t'3 }
      continue
    let t'4 := (WPtr.index s.drivers[UInt8.toNat i]!)
    w := { w with front := s }  -- this object's state into the World: the call reaches it
    let (t'5, t'6, t'7) := SimDriver.read w.heap'SimDriver[t'4]! w
    w := t'6
    w := { w with heap'SimDriver := w.heap'SimDriver.set! t'4 t'5 }
    s := w.front  -- this object's state as the call left it
    if t'7 && decide (FixType.toInt s.fixes[UInt8.toNat i]!.status ≥ FixType.toInt FixType.FIX_2D) then
      s := { s with _hits := s._hits + (1 : UInt8) }
    if FixType.toInt s.fixes[UInt8.toNat i]!.status < FixType.toInt FixType.FIX_3D then
      s := { s with fixes := s.fixes.set! (UInt8.toNat i) ({ s.fixes[UInt8.toNat i]! with «have» := true }) }
    pure ()  -- C++ `const uint8_t *data`: used only where the code cannot run, left out
    pure ()  -- C++ `uint16_t len`: used only where the code cannot run, left out
    pure ()  -- C++ `if (drivers[i]->rtcm(data, len))`: false (every overrider the call can reach returns `false`; --ins-gps)
    let mut t'8 := s._calib != WPtr.null
    if t'8 then
      pure ()  -- C++ `_calib->status(...)`: not reached (a pointer to `Calib`, of which the World has no object, is null)
      t'8 := (0 : Int32) == (1 : Int32)
    if t'8 then
      s := { s with _hits := Int8.toUInt8 (Int32.toInt8 (0 : Int32)) }
  s := average s s._input
  return (s, w)

/-- C++ `float Front::speed(uint8_t i) const`, `examples/insgps.cpp:111`. -/
def speed (s : State) (i : UInt8) : Binary32 := Id.run do
  return s.fixes[UInt8.toNat i]!.speed

end Front

/-- The construction of the file-scope objects, in definition order (C++ static initialization). -/
def World.init : World := Id.run do
  let mut w : World := {}
  w := { w with front := Front.construct }
  return w

end InsGps
