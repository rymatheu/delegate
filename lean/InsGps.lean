/-- C++ `bool SimDriver::read()`, `examples/insgps.cpp:160-170`. -/
def read (s : State) (w : World) : State × World × Bool := Id.run do
  let mut s := s
  let mut w := w
  s := { s with _reads := s._reads + (1 : UInt32) }
  w := { w with front.fixes := w.front.fixes.set! s._fix'i ({ w.front.fixes[s._fix'i]! with reads := w.front.fixes[s._fix'i]!.reads + (1 : UInt32) }) }
  w := { w with front.fixes := w.front.fixes.set! s._fix'i ({ w.front.fixes[s._fix'i]! with speed := w.front._input * Int16.toBinary32 w.front.groups[s._group'i]!.rate }) }
  w := { w with front.fixes := w.front.fixes.set! s._fix'i ({ w.front.fixes[s._fix'i]! with course := w.front.fixes[s._fix'i]!.speed * (Binary32.ofBits 0x40000000 /- 2.0f -/) }) }
  w := { w with front.fixes := w.front.fixes.set! s._fix'i ({ w.front.fixes[s._fix'i]! with status := if w.front.fixes[s._fix'i]!.speed > (Binary32.ofBits 0x3f800000 /- 1.0f -/) then FixType.FIX_3D else FixType.FIX_2D }) }
  w := { w with front.fixes := w.front.fixes.set! s._fix'i (Driver.halve w.front.fixes[s._fix'i]!) }
  s := { s with _last := s._reads }
  return (s, w, decide (w.front.fixes[s._fix'i]!.speed > (Binary32.ofBits 0x00000000 /- 0.0f -/)))

