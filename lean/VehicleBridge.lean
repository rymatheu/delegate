/-- `Estimator_lib.NavFilterStatusBit` from its value (the enumerators' values from its toInt) -/
def ofInt'NavFilterStatusBit (v : Int32) : Estimator_lib.NavFilterStatusBit :=
  if v == (1 : Int32) then .ATTITUDE_VALID
  else if v == (2 : Int32) then .HORIZ_VEL
  else if v == (4 : Int32) then .VERT_VEL
  else if v == (8 : Int32) then .HORIZ_POS_REL
  else if v == (16 : Int32) then .HORIZ_POS_ABS
  else if v == (32 : Int32) then .VERT_POS
  else if v == (64 : Int32) then .TERRAIN_ALT
  else if v == (128 : Int32) then .CONST_POS_MODE
  else if v == (256 : Int32) then .PRED_HORIZ_POS_REL
  else if v == (512 : Int32) then .PRED_HORIZ_POS_ABS
  else if v == (1024 : Int32) then .TAKEOFF_DETECTED
  else if v == (2048 : Int32) then .TAKEOFF_EXPECTED
  else if v == (4096 : Int32) then .TOUCHDOWN_EXPECTED
  else if v == (8192 : Int32) then .USING_GPS
  else if v == (16384 : Int32) then .GPS_GLITCHING
  else if v == (32768 : Int32) then .GPS_QUALITY_GOOD
  else if v == (65536 : Int32) then .INITALIZED
  else if v == (131072 : Int32) then .REJECTING_AIRSPEED
  else if v == (262144 : Int32) then .DEAD_RECKONING
  else default

