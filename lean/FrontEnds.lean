def first_unhealthy (s : State) : UInt8 := Id.run do
  let mut i : SlotIndex.State := SlotIndex.init (Int8.toUInt8 (Int32.toInt8 (0 : Int32)))
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    if !(SlotIndex.op_lt i (Int8.toUInt8 (Int32.toInt8 (3 : Int32)))) then break
    let t'1 := i
    if !s._slots._priv_instance[UInt8.toNat (SlotIndex.get_int t'1)]!.healthy then
      return SlotIndex.get_int i
    let (t'2, _) := SlotIndex.op_inc i (0 : Int32)
    i := t'2
  return Int8.toUInt8 (Int32.toInt8 (3 : Int32))

/-- C++ `uint8_t Front::count() const`, `examples/frontends.cpp:155`. -/
def count (s : State) : UInt8 := Id.run do
  return s._count

end Front

/-- C++ `float scaled_weight(float s)`, `examples/frontends.cpp:275-278`. -/
def scaled_weight (w : World) (s : Binary32) : Binary32 := Id.run do
  return Front.weighted w.front true s + Front.weighted w.front false (Binary32.ofBits 0x00000000 /- 0.0 -/)

/-- The construction of the file-scope objects, in definition order (C++ static initialization). -/
def World.init : World := Id.run do
  let mut w : World := {}
  w := { w with sim := SimNS.Sim.init }
  return w

end FrontEnds
