/-- C++ `bool StorageAccess::copy_area(const StorageAccess & source) const`, `StorageManager/StorageManager.cpp:321-338`. -/
def copy_area (s : State) (source : StorageAccess.State) (hal'storage : Array UInt8) : (Array UInt8) × Bool := Id.run do
  let mut hal'storage := hal'storage
  let mut total : UInt16 := StorageManager_lib.MIN_uint16_t2 (StorageAccess.size source) (size s)
  let mut ofs : UInt16 := Int16.toUInt16 (Int32.toInt16 (0 : Int32))
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    if !(decide (UInt32.toInt32 (UInt16.toUInt32 total) > (0 : Int32))) then break
    let mut block : Array UInt8 := Array.replicate 32 (0 : UInt8)  -- uninitialized in C; every element is written before it is read
    let n : UInt16 := UInt64.toUInt16 (StorageManager_lib.MIN_uint64_t_uint16_t (32 : UInt64) total)
    let (t'1, t'2) := StorageAccess.read_block source block ofs (UInt64.toUSize (UInt16.toUInt64 n)) hal'storage
    block := t'1
    let mut t'5 := !t'2
    if !t'5 then
      let (t'3, t'4) := write_block s ofs block (UInt64.toUSize (UInt16.toUInt64 n)) hal'storage
      hal'storage := t'3
      t'5 := !t'4
    if t'5 then
      return (hal'storage, false)
    total := Int16.toUInt16 (Int32.toInt16 (UInt32.toInt32 (UInt16.toUInt32 total) - UInt32.toInt32 (UInt16.toUInt32 n)))
    ofs := Int16.toUInt16 (Int32.toInt16 (UInt32.toInt32 (UInt16.toUInt32 ofs) + UInt32.toInt32 (UInt16.toUInt32 n)))
  return (hal'storage, true)

end StorageAccess

