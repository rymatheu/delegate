def ops (w : World) (o : List Char) (arg : Int) : World × String := Id.run do
  let mut w := w
  let mut r := ""
  for c in o do
    r := r ++ " " ++ c.toString
    if c == 'B' then
      let (w1, s1) := call_create_view w
      let (w2, _) := call_init w1
      let (w3, _) := call_set_vehicle_class w2
      let (w4, _) := call_reset w3
      w := w4
      r := r ++ s1
    else if c == 'U' then
      w := (call_update w).1
    else if c == 'H' then
      let (l, ok) := AP_AHRS.get_location w.ahrs {}
      r := r ++ tB ok
      if ok then
        let (w1, s1) := call_set_home w l
        w := w1
        r := r ++ s1
    else if c == 'L' then
      w := (call_lock_home w).1
    else if c == 'O' then
      let (w1, s1) := call_set_origin w
      w := w1
      r := r ++ s1
    else if c == 'D' then
      w := (call_resetHeightDatum w).1
    else if c == 'T' then
      w := (call_T w arg).1
    else if c == 'K' then
      w := (call_K w arg).1
    else if c == 'W' then
      w := (call_W w arg).1
    else if c == 'Y' then
      w := (call_request_yaw_reset w).1
    else if c == 'C' then
      w := (call_check_lane_switch w).1
    else if c == 'E' then
      w := { w with ahrs'p := { w.ahrs'p with _ekf_type := AHRS_lib.AP_AHRS.EKFType.ofInt'' arg } }
    else
      r := r ++ "?"
  return (w, r)

partial def loop (h : IO.FS.Stream) (o : IO.FS.Stream) (w : World) (n : Nat) : IO Unit := do
  let line ← h.getLine
  if line.isEmpty then return
  let t := (((line.trimAscii.toString).splitOn " ").filter (· ≠ "")).toArray
  let w := setInputs w t
  let (w, r) := ops w t[0]!.toList (inInt t[1]!)
  let (w, g) := getters w
  o.putStr (toString (n + 1) ++ r ++ g ++ " |" ++ dump w ++ "\n")
  o.flush
  loop h o w (n + 1)

def main : IO Unit := do
  let w := World.init
  let o ← IO.getStdout
  o.putStr ("0 init |" ++ dump w ++ "\n")
  loop (← IO.getStdin) o w 0
