namespace Pointers

/-- C++ `float grid_demo(float a, float b, uint8_t i)`, `examples/pointers.cpp:235-244`. -/
def grid_demo (a b : Binary32) (i : UInt8) : Binary32 := Id.run do
  let mut g : Grid.State := Grid.init
  g := Grid.put g i a
  g := Grid.put g (Int8.toUInt8 (Int32.toInt8 (UInt32.toInt32 (UInt8.toUInt32 i) + (1 : Int32)))) b
  let mut h : Grid.State := Grid.init
  let (t'1, _) := Grid.op_assign h g
  h := t'1
  h := Grid.put h i b
  return Grid.weighted g h + Grid.get h i

end Pointers
