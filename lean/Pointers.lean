namespace Grid

/-- State of C++ `Grid` (`examples/pointers.cpp:200-230`): its data members. -/
structure State where
  /-- `float cells[4]` of `Grid` (`examples/pointers.cpp:228`). -/
  cells : Array Binary32 := Array.replicate 4 (Binary32.ofBits 0x00000000 /- 0.0 -/)
  /-- `uint16_t count` of `Grid` (`examples/pointers.cpp:229`). -/
  count : UInt16 := (0 : UInt16)
deriving Inhabited

/-- C++ `void Grid::clear()`, `examples/pointers.cpp:203`. -/
def clear (s : State) : State := Id.run do
  let mut s := s
  s := { cells := Array.replicate 4 (Binary32.ofBits 0x00000000 /- 0.0 -/), count := (0 : UInt16) }
  return s

/-- C++ `Grid::Grid()`, `examples/pointers.cpp:202`. -/
def init : State := Id.run do
  let mut s : State := {}
  s := clear s
  return s

/-- C++ `void Grid::put(uint8_t i, float v)`, `examples/pointers.cpp:210-216`. -/
def put (s : State) (i : UInt8) (v : Binary32) : State := Id.run do
  let mut s := s
  for _ in [0:1] do
    s := { s with cells := s.cells.set! (Int32.toNatClampNeg (UInt32.toInt32 (UInt8.toUInt32 i) % (4 : Int32))) v }
    s := { s with count := s.count + (1 : UInt16) }
  return s

/-- C++ `Grid & Grid::operator=(const Grid & other)`, `examples/pointers.cpp:204-208`. -/
def op_assign (s : State) (other : Grid.State) : State × Grid.State := Id.run do
  let mut s := s
  s := { s with cells := (other.cells.extract 0 (0 + (Int64.toUInt64 (Int32.toInt64 (4 : Int32))).toNat)) ++ s.cells.extract ((Int64.toUInt64 (Int32.toInt64 (4 : Int32))).toNat) s.cells.size }
  return (s, s)

/-- C++ `static const float Grid::SCALE`, `examples/pointers.cpp:232`. -/
def SCALE : Binary32 := (Binary32.ofBits 0x3f000000 /- 0.5f -/)

/-- C++ `static float Grid::unit(uint8_t i)`, `examples/pointers.cpp:209`. -/
def unit (i : UInt8) : Binary32 := Id.run do
  return SCALE * Int32.toBinary32 (UInt32.toInt32 (UInt8.toUInt32 i) % (4 : Int32))

/-- C++ `static const float Grid::OFFSETS[2]`, `examples/pointers.cpp:233`. -/
def OFFSETS : Array Binary32 := #[(Binary32.ofBits 0x3f800000 /- 1.0f -/), -(Binary32.ofBits 0x3f800000 /- 1.0f -/)]

