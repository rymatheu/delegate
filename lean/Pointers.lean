/-- C++ `float written_first(float a, float b)`, `examples/pointers.cpp:128-140`. -/
def written_first (a b : Binary32) : Binary32 := Id.run do
  let mut w : Array Binary32 := Array.replicate 3 (Binary32.ofBits 0x00000000 /- 0.0 -/)  -- uninitialized in C++; every element is assigned before any read (checked)
  w := w.set! (Int32.toNatClampNeg (0 : Int32)) a
  w := w.set! (Int32.toNatClampNeg (2 : Int32)) b
  w := w.set! (Int32.toNatClampNeg (1 : Int32)) (a * b)
  let mut p : Pair := {}
  p := { p with x := a }
  p := { p with y := b }
  p := { p with y := p.y + w[Int32.toNatClampNeg (1 : Int32)]! }
  return w[Int32.toNatClampNeg (0 : Int32)]! + w[Int32.toNatClampNeg (1 : Int32)]! - w[Int32.toNatClampNeg (2 : Int32)]! + p.y

