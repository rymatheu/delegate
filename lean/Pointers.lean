/-- C++ `float Grid::weighted(const Grid & other) const`, `examples/pointers.cpp:217-224`. -/
def weighted (s : State) (other : Grid.State) : Binary32 := Id.run do
  let mut acc : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0f -/)
  for i' in [0:4] do
    let i : UInt8 := Nat.toUInt8 i'
    acc := acc + (s.cells[UInt8.toNat i]! * unit i + OFFSETS[Int32.toNatClampNeg (UInt32.toInt32 (UInt8.toUInt32 i) % (2 : Int32))]!)
  return acc

