  s := { s with kinds := Int8.toUInt8 (Int32.toInt8 (t'29 + UInt32.toInt32 (UInt8.toUInt32 t'28))) }
  return (s, w)

/-- C++ `void Ahrs::reset()`, `examples/memberptrs.cpp:137-142`. -/
def reset (s : State) : State := Id.run do
  let mut s := s
  for t'1 in [0:2] do
    let t'2 := s.backends_and_estimates[t'1]!.backend
    match t'2 with
    | .ahrs'fallback =>  -- C++ `ahrs.fallback`
        s := { s with fallback := Fallback.reset s.fallback }
    | .ahrs'main =>  -- C++ `ahrs.main`
        pure ()  -- C++ `reset`: no effect in the model
    | _ => pure ()  -- (no other object: undefined in C++)
  s := { s with done_origin := false }
  return s

/-- C++ `bool Ahrs::set_origin(double o)`, `examples/memberptrs.cpp:143-152`. -/
def set_origin (s : State) (o : Binary64) : State × Bool := Id.run do
  let mut s := s
  for t'1 in [0:2] do
    let backend := s.backends_and_estimates[t'1]!.backend
    if backend == s.active_backend then
      continue
    let t'2 := backend
    let mut t'5 : Bool := false
    match t'2 with
    | .ahrs'fallback =>  -- C++ `ahrs.fallback`
        t'5 := Fallback.set_origin o
    | .ahrs'main =>  -- C++ `ahrs.main`
        let (t'3, t'4) := Main.set_origin s.main o
        s := { s with main := t'3 }
        t'5 := t'4
    | _ => pure ()  -- (no other object: undefined in C++)
  let t'6 := s.active_backend
  let mut t'9 : Bool := false
  match t'6 with
  | .ahrs'fallback =>  -- C++ `ahrs.fallback`
      t'9 := Fallback.set_origin o
  | .ahrs'main =>  -- C++ `ahrs.main`
      let (t'7, t'8) := Main.set_origin s.main o
      s := { s with main := t'7 }
      t'9 := t'8
  | _ => pure ()  -- (no other object: undefined in C++)
  return (s, t'9)

/-- C++ `bool Ahrs::healthy() const`, `examples/memberptrs.cpp:153`. -/
def healthy (s : State) : Bool := Id.run do
  return ((match s.configured_estimates with | .ahrs'fallback_estimates => s.fallback_estimates | _ => s.main_estimates) : Backend.Estimates.State).healthy

/-- C++ `bool Ahrs::get_origin(double & o) const`, `examples/memberptrs.cpp:154-160`. -/
def get_origin (s : State) (o : Binary64) : Binary64 × Bool := Id.run do
  let mut o := o
  let b : WPtr := backend_for s._type
  if b == WPtr.null then
    return (o, false)
  let t'1 := b
  let mut t'6 : Bool := false
  match t'1 with
  | .ahrs'fallback =>  -- C++ `ahrs.fallback`
      let (t'2, t'3) := Fallback.get_origin o
      o := t'2
      t'6 := t'3
  | .ahrs'main =>  -- C++ `ahrs.main`
      let (t'4, t'5) := Main.get_origin s.main o
      o := t'4
      t'6 := t'5
  | _ => pure ()  -- (no other object: undefined in C++)
  return (o, t'6)

/-- C++ `Ahrs::Ahrs()`, `examples/memberptrs.cpp:109-112`. -/
def init : State := Id.run do
  let mut s : State := {}
  s := update_configured s
  s := update_active s
  return s

end Ahrs

/-- The construction of the file-scope objects, in definition order (C++ static initialization). -/
def World.init : World := Id.run do
  let mut w : World := {}
  w := { w with ahrs := Ahrs.init }
  return w

end MemberPtrs
