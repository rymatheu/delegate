partial def loopMission_lib_World_defaults (h : IO.FS.Stream) (out : IO.FS.Stream) (w : Mission_lib.World) (hs : Array UInt8) (n : Nat) : IO Unit := do
  let line ← h.getLine
  if line.isEmpty then return
  let t := (((line.trimAscii.toString).splitOn " ").filter (· ≠ "")).toArray
  let w := inputsMission_lib_World_defaults w t (t.size - 10)
  let (w, hs, o) := match t[0]! with
    | "tester.t_boot" => callMission_lib_World_defaults_0 w hs t
    | "tester.t_add" => callMission_lib_World_defaults_1 w hs t
    | "tester.t_replace" => callMission_lib_World_defaults_2 w hs t
    | "tester.t_raw" => callMission_lib_World_defaults_3 w hs t
    | "tester.t_read" => callMission_lib_World_defaults_4 w hs t
    | "tester.t_clear" => callMission_lib_World_defaults_5 w hs t
    | "tester.t_truncate" => callMission_lib_World_defaults_6 w hs t
    | "tester.t_home" => callMission_lib_World_defaults_7 w hs t
    | "tester.t_next" => callMission_lib_World_defaults_8 w hs t
    | "tester.t_conv" => callMission_lib_World_defaults_9 w hs t
    | "tester.t_item" => callMission_lib_World_defaults_10 w hs t
    | "tester.t_get" => callMission_lib_World_defaults_11 w hs t
    | _ => (w, hs, " ?")
  out.putStr (toString (n + 1) ++ " " ++ t[0]! ++ o ++ " |" ++ dumpMission_lib_World_defaults w ++ "\n")
  loopMission_lib_World_defaults h out w hs (n + 1)

def runMission_lib_World_defaults : IO Unit := do
  let w := Mission_lib.World.init
  let out ← IO.getStdout
  out.putStr ("0 init |" ++ dumpMission_lib_World_defaults w ++ "\n")
  loopMission_lib_World_defaults (← IO.getStdin) out w (Array.replicate 16384 (0 : UInt8)) 0

partial def loop (h : IO.FS.Stream) (out : IO.FS.Stream) (run : Nat → Array String → String) (n : Nat) : IO Unit := do
  let line ← h.getLine
  if line.isEmpty then return
  let toks := ((line.trimAscii.toString).splitOn " ").filter (· ≠ "")
  out.putStr (run (n + 1) toks.toArray)
  loop h out run (n + 1)

