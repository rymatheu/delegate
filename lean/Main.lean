  let mut o := ""
  o := o ++ toString line ++ " header_word" ++ " " ++ toString (BitFields.header_word s0 s5 s2) ++ "\n"
  o := o ++ toString line ++ " header_fields" ++ " " ++ toString (BitFields.header_fields s2 s5) ++ "\n"
  o := o ++ toString line ++ " frame_bytes" ++ " " ++ toString (BitFields.frame_bytes s0 s2 s3 s5 s1 s4) ++ "\n"
