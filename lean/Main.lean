def dumpFrame_Frame_Host (p : Frame.Host.Params) (s : Frame.Host.State) (ob : Frame.Outputs) : String :=
  "" ++ tF32 (p.lin.expo) ++ tF32 (p._gain) ++ tI (toString (Frame.Host.Mode.toInt (p._mode))) ++ tF32 (s.trim) ++ tF32 (s.lin.lift) ++ tB (s._armed) ++ tF32 (s._roll_in) ++ tB (s._enabled[0]!) ++ tB (s._enabled[1]!) ++ tB (s._enabled[2]!) ++ tB (s._enabled[3]!) ++ tF32 (s._roll[0]!) ++ tF32 (s._roll[1]!) ++ tF32 (s._roll[2]!) ++ tF32 (s._roll[3]!) ++ tI (toString (s._order[0]!)) ++ tI (toString (s._order[1]!)) ++ tI (toString (s._order[2]!)) ++ tI (toString (s._order[3]!)) ++ tF32 (s._out[0]!) ++ tF32 (s._out[1]!) ++ tF32 (s._out[2]!) ++ tF32 (s._out[3]!) ++ tS (s._name) ++ tI (toString (s._scaled.mask)) ++ tF32 (s._scaled.offset) ++ tI (toString (s._note_count)) ++ ob.foldl (fun acc e => acc ++ outTokFrame_Frame_Host e) ""

partial def loopFrame_Frame_Host (h : IO.FS.Stream) (out : IO.FS.Stream) (p : Frame.Host.Params) (s : Frame.Host.State) (ob : Frame.Outputs) (n : Nat) : IO Unit := do
  let line ← h.getLine
  if line.isEmpty then return
  let t := (((line.trimAscii.toString).splitOn " ").filter (· ≠ "")).toArray
  let mut p := p
  let mut s := s
  let mut ob := ob
  let mut o := toString (n + 1) ++ " " ++ t[0]!
  match t[0]! with
  | "Host.gain" =>
    let c0 := Frame.Host.gain p
    o := o ++ tF32 (c0)
  | "Host.scale" =>
    let c0 := Frame.Host.scale p
    o := o ++ tF32 (c0)
  | "Host.setup" =>
    let a0 : UInt8 := UInt8.ofNat (inNat t[1]!)
    let (c0, c1) := Frame.Host.setup s a0
    s := c0
    o := o ++ tB (c1)
  | "Host.step" =>
    let a0 : Float32 := inF32 t[1]!
    let (c0, c1) := Frame.Host.step p s ob a0
    s := c0
    ob := c1
  | "Host.arm" =>
    let a0 : Bool := (t[1]! != "0")
    let (c0, c1) := Frame.Host.arm s ob a0
    s := c0
    ob := c1
  | "Host.set_mode" =>
    let a0 : UInt8 := UInt8.ofNat (inNat t[1]!)
    let (c0, c1) := Frame.Host.set_mode p s ob a0
    p := c0
    ob := c1
  | "Host.set_roll" =>
    let a0 : Float32 := inF32 t[1]!
    let c0 := Frame.Host.set_roll s a0
    s := c0
  | "Host.configure" =>
    let inp : Frame.Host.Inputs := { _gain_configured := (t[1]! != "0"), lin_expo_configured := (t[2]! != "0"), read_at := inF32 t[3]!, channel_mask_2 := UInt32.ofNat (inNat t[4]!) }
    let c0 := Frame.Host.configure p inp
    p := c0
  | "Host.sample" =>
    let a0 : Int32 := Int32.ofInt (inInt t[1]!)
    let inp : Frame.Host.Inputs := { _gain_configured := (t[2]! != "0"), lin_expo_configured := (t[3]! != "0"), read_at := inF32 t[4]!, channel_mask_2 := UInt32.ofNat (inNat t[5]!) }
    let c0 := Frame.Host.sample p inp a0
    o := o ++ tF32 (c0)
  | "Host.name" =>
    let c0 := Frame.Host.name s
    o := o ++ tS (c0)
  | "Lin.actuator" =>
    let a0 : Float32 := inF32 t[1]!
    let c0 := Frame.Lin.actuator p.lin s.lin (Frame.Host.owner_lin p s) a0
    o := o ++ tF32 (c0)
  | "Lin.relax" =>
    let a0 : Float32 := inF32 t[1]!
    let c0 := Frame.Lin.relax s.lin a0
    s := { s with lin := c0 }
  | _ => o := o ++ " ?"
  out.putStr (o ++ " |" ++ dumpFrame_Frame_Host p s ob ++ "\n")
  loopFrame_Frame_Host h out p s #[] (n + 1)

