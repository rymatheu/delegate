def enumOf_Mode (v : Int) : Mode :=
  if v == 0 then Mode.Angle
  else if v == 1 then Mode.Rate
  else if v == 2 then Mode.Both
  else default

def dumpControl_Hold (s : Hold.State) : String :=
  "" ++ tF32 (s._pos.x) ++ tF32 (s._pos.y) ++ tF32 (s._pos.z) ++ tF32 (s._last) ++ tF32 (s._heading) ++ tF32 (s._gain._k)

partial def loopControl_Hold (h : IO.FS.Stream) (out : IO.FS.Stream) (s : Hold.State) (n : Nat) : IO Unit := do
  let line ← h.getLine
  if line.isEmpty then return
  let t := (((line.trimAscii.toString).splitOn " ").filter (· ≠ "")).toArray
  let mut s := s
  let mut o := toString (n + 1) ++ " " ++ t[0]!
  match t[0]! with
  | "boost" =>
    let a0 : Float32 := inF32 t[1]!
    let c0 := Hold.boost s a0
    s := c0
  | "output" =>
    let a0 : Float32 := inF32 t[1]!
    let c0 := Hold.output s a0
    o := o ++ tF32 (c0)
  | "gain_k" =>
    let c0 := Hold.gain_k s
    o := o ++ tF32 (c0)
  | "go_home" =>
    let c0 := Hold.go_home s
    s := c0
  | "gain" =>
    let c0 := Hold.gain s
    o := o ++ tF32 (c0._k)
  | "run" =>
    let a0 : Float32 := inF32 t[1]!
    let inp : Hold.Inputs := { target := { x := inF32 t[2]!, y := inF32 t[3]!, z := inF32 t[4]! }, armed := (t[5]! != "0"), trim := inF32 t[6]! }
    let c0 := Hold.run s inp a0
    s := c0
  | "place" =>
    let a0 : Float32 := inF32 t[1]!
    let a1 : Float32 := inF32 t[2]!
    let c0 := Hold.place s a0 a1
    s := c0
  | "apply" =>
    let a0 : Command := { angle := inF32 t[1]!, rate := inF32 t[2]!, mode := enumOf_Mode (inInt t[3]!) }
    let c0 := Hold.apply s a0
    s := c0
  | "last" =>
    let c0 := Hold.last s
    o := o ++ tF32 (c0)
  | "speed" =>
    let c0 := Hold.speed s
    o := o ++ tF32 (c0)
  | _ => o := o ++ " ?"
  out.putStr (o ++ " |" ++ dumpControl_Hold s ++ "\n")
  loopControl_Hold h out s (n + 1)

def runControl_Hold : IO Unit := do
  let s : Hold.State := Hold.init 
  let out ← IO.getStdout
  out.putStr ("0 init |" ++ dumpControl_Hold s ++ "\n")
  loopControl_Hold (← IO.getStdin) out s 0

