    return (Binary32.ofBits 0x00000000 /- 0.0 -/)
  let linear_velocity : Binary32 := D_max / p
  if Binary32.abs output < linear_velocity then
    return output / p
  let linear_dist : Binary32 := D_max / sq_float p
  let stopping_dist : Binary32 := (linear_dist * (Binary32.ofBits 0x3f000000 /- 0.5f -/)) + sq_float output / ((Binary32.ofBits 0x40000000 /- 2.0 -/) * D_max)
  return if is_positive_float output then stopping_dist else -stopping_dist

