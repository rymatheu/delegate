/-- C++ `float safe_sqrt(const float v)`, `AP_Math/AP_Math.cpp:72-81`. -/
def safe_sqrt_float (v : Binary32) : Binary32 := Id.run do
  let val : Binary32 := v
  if decide (Binary32.toBinary64 val ≥ Int32.toBinary64 (0 : Int32)) then
    return Binary32.sqrt val
  return (Binary32.ofBits 0x00000000 /- 0 -/)

/-- C++ `float sqrt_controller(float error, float p, float second_ord_lim, float dt)`, `AP_Math/control.cpp:575-610`. -/
def sqrt_controller_float4 (error p second_ord_lim dt : Binary32) : Binary32 := Id.run do
  let mut correction_rate : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0 -/)  -- uninitialized in C++; assigned before every read
  if is_negative_float second_ord_lim || is_zero_float second_ord_lim then
    correction_rate := error * p
  else if is_zero_float p then
    if is_positive_float error then
      correction_rate := safe_sqrt_float ((Binary32.ofBits 0x40000000 /- 2.0 -/) * second_ord_lim * error)
    else if is_negative_float error then
      correction_rate := -(safe_sqrt_float ((Binary32.ofBits 0x40000000 /- 2.0 -/) * second_ord_lim * (-error)))
    else
      correction_rate := (Binary32.ofBits 0x00000000 /- 0.0 -/)
  else
    let linear_dist : Binary32 := second_ord_lim / sq_float p
    if error > linear_dist then
      correction_rate := safe_sqrt_float ((Binary32.ofBits 0x40000000 /- 2.0 -/) * second_ord_lim * (error - (linear_dist / (Binary32.ofBits 0x40000000 /- 2.0 -/))))
    else if error < -linear_dist then
      correction_rate := -(safe_sqrt_float ((Binary32.ofBits 0x40000000 /- 2.0 -/) * second_ord_lim * (-error - (linear_dist / (Binary32.ofBits 0x40000000 /- 2.0 -/)))))
    else
      correction_rate := error * p
  if is_positive_float dt then
    return constrain_value_line_float correction_rate (-(Binary32.abs error) / dt) (Binary32.abs error / dt) (Int32.toUInt32 (606 : Int32))
  else
    return correction_rate

