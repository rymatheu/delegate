/-- C++ `float inv_sqrt_controller(float output, float p, float D_max)`, `AP_Math/control.cpp:630-659`. -/
def inv_sqrt_controller (output p D_max : Binary32) : Binary32 := Id.run do
  if is_positive_float D_max && is_zero_float p then
    return (output * output) / ((Binary32.ofBits 0x40000000 /- 2.0 -/) * D_max)
