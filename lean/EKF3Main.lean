def callInit (w : World) : World × String := Id.run do
  let (i_0, i_1, i_2, i_3) := NavEKF3.InitialiseFilter w.EKF3'p w.EKF3 w
  let w := i_2
  let w := { w with EKF3'p := i_0 }
  let w := { w with EKF3 := i_1 }
  return (w, "" ++ tB (i_3))

def callUpdate (w : World) : World := Id.run do
  let (u_0, u_1) := NavEKF3.UpdateFilter w.EKF3'p w.EKF3 w
  let w := u_1
  let w := { w with EKF3 := u_0 }
  return w

partial def loop (h : IO.FS.Stream) (o : IO.FS.Stream) (w : World) (n : Nat) (started : Bool) : IO Unit := do
  let line ← h.getLine
  if line.isEmpty then return
  let t := (((line.trimAscii.toString).splitOn " ").filter (· ≠ "")).toArray
  let w := setInputs w t
  -- `A`: as AP_AHRS::update_EKF3, InitialiseFilter until it succeeds, then UpdateFilter
  let (w, r, started) := if t[0]! == "I" then (let (w, r) := callInit w; (w, r, started))
    else if t[0]! == "U" then (callUpdate w, "", started)
    else if t[0]! == "A" then (if started then (callUpdate w, " update", started) else
      (let (w, r) := callInit w; (w, " init" ++ r, r == " b:1")))
    else (w, " ?", started)
  let (w, g) := getters w
  o.putStr (toString (n + 1) ++ " " ++ t[0]! ++ r ++ g ++ " |" ++ dump w ++ "\n")
  o.flush
  loop h o w (n + 1) started

def main : IO Unit := do
  let w := World.init
  let o ← IO.getStdout
  o.putStr ("0 init |" ++ dump w ++ "\n")
  loop (← IO.getStdin) o w 0 false
