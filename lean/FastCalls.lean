/-- C++ `static void Common::zero_range(double * v, uint8_t n1, uint8_t n2)`, `examples/fastcalls.cpp:19-21`. -/
def zero_range (v : Array Binary64) (v'o : Nat) (n1 n2 : UInt8) : (Array Binary64) := Id.run do
  let mut v := v
  for t'1 in [0:((Int64.toUInt64 (Int32.toInt64 ((1 : Int32) + (UInt32.toInt32 (UInt8.toUInt32 n2) - UInt32.toInt32 (UInt8.toUInt32 n1))))).toNat)] do  -- C++ `memset` of k elements
    v := v.set! (v'o + UInt8.toNat n1 + t'1) (Binary64.ofBits 0x0000000000000000 /- 0.0 -/)
  return v

/-- C++ `static double Common::scale(double * v, uint8_t k, double g)`, `examples/fastcalls.cpp:23-31`. -/
def scale (v : Array Binary64) (v'o : Nat) (k : UInt8) (g : Binary64) : (Array Binary64) × Binary64 := Id.run do
  let mut v := v
  let mut v'o := v'o  -- the offset of pointer `v` moves
  let mut acc : Binary64 := (Binary64.ofBits 0x0000000000000000 /- 0 -/)
  for _ in [0:k.toNat] do
    v := v.set! v'o (v[v'o]! * g)
    acc := acc + v[v'o]!
    v'o := v'o + 1
  return (v, acc)

/-- C++ `static void Common::copy_into(double * dst, const double * src, uint8_t k)`, `examples/fastcalls.cpp:32-34`. -/
def copy_into (dst : Array Binary64) (dst'o : Nat) (src : Array Binary64) (src'o : Nat) (k : UInt8) : (Array Binary64) := Id.run do
  let mut dst := dst
  for t'1 in [0:((UInt8.toUInt64 k).toNat)] do  -- C++ `memcpy` of k elements
    dst := dst.set! (dst'o + t'1) (src[src'o + t'1]!)
  return dst

/-- C++ `static double Common::total(const double * v, uint8_t k)`, `examples/fastcalls.cpp:35-41`. -/
def total (v : Array Binary64) (v'o : Nat) (k : UInt8) : Binary64 := Id.run do
  let mut a : Binary64 := (Binary64.ofBits 0x0000000000000000 /- 0 -/)
  for i' in [0:k.toNat] do
    let i : UInt8 := Nat.toUInt8 i'
    a := a + v[v'o + UInt8.toNat i]!
  return a

end Common

