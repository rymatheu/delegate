  let mut s := s
  for r' in [0:6] do
    let r : UInt8 := Nat.toUInt8 r'
    for c' in [0:6] do
      let c : UInt8 := Nat.toUInt8 c'
      s := { s with P := s.P.set! (UInt8.toNat r * 6 + UInt8.toNat c) (s.P[UInt8.toNat r * 6 + UInt8.toNat c]! + (x * Int32.toBinary64 (UInt32.toInt32 (UInt8.toUInt32 r) + (1 : Int32)) - (Binary64.ofBits 0x3fd0000000000000 /- 0.25 -/) * Int32.toBinary64 (UInt32.toInt32 (UInt8.toUInt32 c)))) }
