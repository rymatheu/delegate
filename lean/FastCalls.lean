/-- C++ `bool Front::init(uint8_t n)`, `examples/fastcalls.cpp:94-104`. -/
def init (s : State) (w : World) (n : UInt8) : State × World × Bool := Id.run do
  let mut s := s
  let mut w := w
  if s.core != WPtr.null || UInt32.toInt32 (UInt8.toUInt32 n) == (0 : Int32) || decide (UInt32.toInt32 (UInt8.toUInt32 n) > (2 : Int32)) then
    return (s, w, false)
  let t'1 := w.heap'Core.size
  w := { w with heap'Core := w.heap'Core ++ Array.replicate (UInt64.toNat (UInt8.toUInt64 n)) ({} : Core.State) }  -- C++ `(Core *)malloc(sizeof(Core) * n)`: k slots, constructed by placement new
  s := { s with core := (WPtr.heap'Core t'1) }
  s := { s with num_cores := n }
  let t'2 : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  let t'3 : Int32 := UInt32.toInt32 (UInt8.toUInt32 s.num_cores)
  for i' in [0:(t'3.toInt - (Int.ofNat t'2.toNat)).toNat] do  -- C++ loop bounded by a runtime value (--runtime-loops)
    let i : UInt8 := t'2 + Nat.toUInt8 i'
    let t'4 := Core.init i
    w := { w with heap'Core := w.heap'Core.set! ((WPtr.index s.core) + (UInt8.toNat i)) t'4 }
  return (s, w, true)

/-- C++ `void Front::update(double x, uint8_t first, uint8_t last)`, `examples/fastcalls.cpp:105-114`. -/
def update (s : State) (w : World) (x : Binary64) (first : UInt8) (last : UInt8) : State × World := Id.run do
  let mut s := s
  let mut w := w
  let mut s' : Binary64 := (Binary64.ofBits 0x0000000000000000 /- 0 -/)
  let t'1 : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  let t'2 : Int32 := UInt32.toInt32 (UInt8.toUInt32 s.num_cores)
  for i' in [0:(t'2.toInt - (Int.ofNat t'1.toNat)).toNat] do  -- C++ loop bounded by a runtime value (--runtime-loops)
    let i : UInt8 := t'1 + Nat.toUInt8 i'
    let t'3 := w.heap'Core[((WPtr.index s.core) + (UInt8.toNat i))]!  -- the object out of its slot for the call (--swap-out)
    w := { w with heap'Core := w.heap'Core.set! ((WPtr.index s.core) + (UInt8.toNat i)) default }
    w := { w with heap'Core := w.heap'Core.set! ((WPtr.index s.core) + (UInt8.toNat i)) (Core.update t'3 x first last) }
    s' := s' + w.heap'Core[((WPtr.index s.core) + (UInt8.toNat i))]!.sum
  let t'4 := w.monitor  -- the object out of the World for the call (--swap-out)
  w := { w with monitor := default }
  w := { w with monitor := Monitor.note t'4 s' }
  s := { s with best := if s' > s.best then s' else s.best }
  let t'5 := w.tally  -- the object out of the World for the call (--swap-out)
  w := { w with tally := default }
  w := { w with tally := Monitor.note t'5 (s.best - s') }
  return (s, w)

