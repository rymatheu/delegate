    mav_cmd := { mav_cmd with y := Binary32.toInt32 packet.y }
  else
    if !(Mission_lib.check_lat_float packet.x) then
      return (mav_cmd, MAV_MISSION_RESULT.MAV_MISSION_INVALID_PARAM5_X)
    if !(Mission_lib.check_lng_float packet.y) then
      return (mav_cmd, MAV_MISSION_RESULT.MAV_MISSION_INVALID_PARAM6_Y)
