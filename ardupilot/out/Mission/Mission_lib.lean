  mav_cmd := { mav_cmd with param4 := packet.param4 }
  mav_cmd := { mav_cmd with z := packet.z }
  mav_cmd := { mav_cmd with seq := packet.seq }
  mav_cmd := { mav_cmd with command := packet.command }
  mav_cmd := { mav_cmd with target_system := packet.target_system }
  mav_cmd := { mav_cmd with target_component := packet.target_component }
  mav_cmd := { mav_cmd with frame := packet.frame }
  mav_cmd := { mav_cmd with current := packet.current }
  mav_cmd := { mav_cmd with autocontinue := packet.autocontinue }
