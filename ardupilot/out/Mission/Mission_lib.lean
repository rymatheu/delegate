def convert_MISSION_ITEM_INT_to_MISSION_ITEM (item_int : __mavlink_mission_item_int_t) (item : __mavlink_mission_item_t) : __mavlink_mission_item_t × MAV_MISSION_RESULT := Id.run do
  let mut item := item
  item := { item with param1 := item_int.param1 }
  item := { item with param2 := item_int.param2 }
  item := { item with param3 := item_int.param3 }
  item := { item with param4 := item_int.param4 }
  item := { item with z := item_int.z }
  item := { item with seq := item_int.seq }
  item := { item with command := item_int.command }
  item := { item with target_system := item_int.target_system }
  item := { item with target_component := item_int.target_component }
  item := { item with frame := item_int.frame }
  item := { item with current := item_int.current }
  item := { item with autocontinue := item_int.autocontinue }
  item := { item with mission_type := item_int.mission_type }
  if !(cmd_has_location item_int.command) then
    item := { item with x := Int32.toBinary32 item_int.x }
    item := { item with y := Int32.toBinary32 item_int.y }
  else
    item := { item with x := Int32.toBinary32 item_int.x * (Binary32.ofBits 0x33d6bf95 /- 1.0e-7f -/) }
    item := { item with y := Int32.toBinary32 item_int.y * (Binary32.ofBits 0x33d6bf95 /- 1.0e-7f -/) }
    if !(Mission_lib.check_lat_float item.x) then
      return (item, MAV_MISSION_RESULT.MAV_MISSION_INVALID_PARAM5_X)
    if !(Mission_lib.check_lng_float item.y) then
      return (item, MAV_MISSION_RESULT.MAV_MISSION_INVALID_PARAM6_Y)
  return (item, MAV_MISSION_RESULT.MAV_MISSION_ACCEPTED)

