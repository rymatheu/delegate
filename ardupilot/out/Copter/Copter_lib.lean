/-- C++ `void AC_Circle::calc_velocities(bool init_velocity)`, `AC_WPNav/AC_Circle.cpp:345-369`. -/
def calc_velocities (s : State) (w : World) (init_velocity : Bool) : State := Id.run do
  let mut s := s
  if s._radius_m ≤ (Binary32.ofBits 0x00000000 /- 0 -/) then
    s := { s with _angular_vel_max_rads := s._rotation_rate_max_rads }
    s := { s with _angular_accel_radss := Copter_lib.MAX_float2 (Binary32.abs s._angular_vel_max_rads) (Copter_lib.radians_float (Binary32.ofBits 0x40000000 /- 2 -/)) }
  else
