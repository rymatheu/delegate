def update_vel_accel (vel accel dt limit vel_error : Binary32) : Binary32 := Id.run do
  let mut vel := vel
  let mut delta_vel : Binary32 := accel * dt
  if is_positive_float (delta_vel * limit) && is_positive_float (vel_error * limit) then
    if is_negative_float (vel * limit) then
      delta_vel := constrain_value_line_float delta_vel (-(Binary32.abs vel)) (Binary32.abs vel) (Int32.toUInt32 (53 : Int32))
    else
      delta_vel := (Binary32.ofBits 0x00000000 /- 0.0 -/)
  vel := vel + delta_vel
  return vel

