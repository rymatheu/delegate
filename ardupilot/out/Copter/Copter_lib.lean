/-- C++ `void AP_MotorsMatrix::normalise_rpy_factors()`, `AP_Motors/AP_MotorsMatrix.cpp:1354-1388`. -/
def normalise_rpy_factors (s : State) : State := Id.run do
  let mut s := s
  let mut roll_fac : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0f -/)
  let mut pitch_fac : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0f -/)
  let mut yaw_fac : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0f -/)
  let mut throttle_fac : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0f -/)
  for i' in [0:32] do
    let i : UInt8 := Nat.toUInt8 i'
    if s.motor_enabled[UInt8.toNat i]! then
      roll_fac := Copter_lib.MAX_float2 roll_fac (Binary32.abs s._roll_factor[UInt8.toNat i]!)
      pitch_fac := Copter_lib.MAX_float2 pitch_fac (Binary32.abs s._pitch_factor[UInt8.toNat i]!)
      yaw_fac := Copter_lib.MAX_float2 yaw_fac (Binary32.abs s._yaw_factor[UInt8.toNat i]!)
      throttle_fac := Copter_lib.MAX_float2 throttle_fac (Copter_lib.MAX_float2 (Binary32.ofBits 0x00000000 /- 0.0f -/) s._throttle_factor[UInt8.toNat i]!)
  for i' in [0:32] do
    let i : UInt8 := Nat.toUInt8 i'
    if s.motor_enabled[UInt8.toNat i]! then
      if !(Copter_lib.is_zero_float roll_fac) then
        s := { s with _roll_factor := s._roll_factor.set! (UInt8.toNat i) ((Binary32.ofBits 0x3f000000 /- 0.5f -/) * s._roll_factor[UInt8.toNat i]! / roll_fac) }
      if !(Copter_lib.is_zero_float pitch_fac) then
        s := { s with _pitch_factor := s._pitch_factor.set! (UInt8.toNat i) ((Binary32.ofBits 0x3f000000 /- 0.5f -/) * s._pitch_factor[UInt8.toNat i]! / pitch_fac) }
      if !(Copter_lib.is_zero_float yaw_fac) then
        s := { s with _yaw_factor := s._yaw_factor.set! (UInt8.toNat i) ((Binary32.ofBits 0x3f000000 /- 0.5f -/) * s._yaw_factor[UInt8.toNat i]! / yaw_fac) }
      if !(Copter_lib.is_zero_float throttle_fac) then
        s := { s with _throttle_factor := s._throttle_factor.set! (UInt8.toNat i) (Copter_lib.MAX_float2 (Binary32.ofBits 0x00000000 /- 0.0f -/) (s._throttle_factor[UInt8.toNat i]! / throttle_fac)) }
  return s

