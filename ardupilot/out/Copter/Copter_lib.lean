/-- C++ `void AP_MotorsMatrix::set_update_rate(uint16_t speed_hz)`, `AP_Motors/AP_MotorsMatrix.cpp:116-128`. -/
def set_update_rate (s : State) (o : Outputs) (speed_hz : UInt16) : State × Outputs := Id.run do
