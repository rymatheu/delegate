/-- C++ `Vector3f AC_PosControl::lean_angles_rad_to_accel_NED_mss(const Vector3f & att_target_euler_rad) const`, `AC_AttitudeControl/AC_PosControl.cpp:1200-1215`. -/
def lean_angles_rad_to_accel_NED_mss (att_target_euler_rad : Vector3f.State) : Vector3f.State := Id.run do
  let sin_roll : Binary32 := Musl.sinf.sinf att_target_euler_rad.x
  let cos_roll : Binary32 := Musl.cosf.cosf att_target_euler_rad.x
  let sin_pitch : Binary32 := Musl.sinf.sinf att_target_euler_rad.y
  let cos_pitch : Binary32 := Musl.cosf.cosf att_target_euler_rad.y
