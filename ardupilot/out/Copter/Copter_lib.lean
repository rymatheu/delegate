def lean_angles_to_accel_NE_mss (w : World) (inp : Inputs) (accel_n_mss : Binary32) (accel_e_mss : Binary32) : Binary32 × Binary32 := Id.run do
  let mut accel_n_mss := accel_n_mss
  let mut accel_e_mss := accel_e_mss
  let mut att_target_euler_rad : Vector3f.State := AC_AttitudeControl_Multi.get_att_target_euler_rad w.attitude_control
  att_target_euler_rad := { att_target_euler_rad with z := inp.yaw }
  let accel_ne_mss : Vector3f.State := lean_angles_rad_to_accel_NED_mss att_target_euler_rad
  accel_n_mss := accel_ne_mss.x
  accel_e_mss := accel_ne_mss.y
