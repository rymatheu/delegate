    s := { s with _angular_vel_max_rads := vel_max_ms / s._radius_m }
    s := { s with _angular_vel_max_rads := Copter_lib.constrain_value_line_float s._rotation_rate_max_rads (-s._angular_vel_max_rads) s._angular_vel_max_rads (Int32.toUInt32 (359 : Int32)) }
    s := { s with _angular_accel_radss := Copter_lib.MAX_float2 (AC_PosControl.NE_get_max_accel_mss w.pos_control / s._radius_m) (Copter_lib.radians_float (Binary32.ofBits 0x40000000 /- 2 -/)) }
  if init_velocity then
