/-- C++ `void AC_Circle::get_closest_point_on_circle_NED_m(Vector3p & result_ned_m, float & dist_m) const`, `AC_WPNav/AC_Circle.cpp:308-340`. -/
def get_closest_point_on_circle_NED_m (s : State) (w : World) (inp : Inputs) (result_ned_m : Vector3p.State) (dist_to_edge_m : Binary32) : Vector3p.State × Binary32 := Id.run do
  let mut result_ned_m := result_ned_m
  let mut dist_to_edge_m := dist_to_edge_m
  let mut stopping_point_ned_m : Vector3p.State := Vector3p.init_void
  let t'1 := AC_PosControl.get_stopping_point_NE_m w.pos_control'p w.pos_control ({ x := stopping_point_ned_m.x, y := stopping_point_ned_m.y } : Vector2p.State)
  stopping_point_ned_m := { stopping_point_ned_m with x := t'1.x, y := t'1.y }
  stopping_point_ned_m := { stopping_point_ned_m with z := AC_PosControl.get_stopping_point_D_m w.pos_control'p w.pos_control stopping_point_ned_m.z }
  let mut vec_from_center_ned_m : Vector3f.State := Vector3p.tofloat (Vector3p.op_sub_Vector3p stopping_point_ned_m s._center_ned_m)
  if !(Copter_lib.is_positive_float s._radius_m) then
    result_ned_m := s._center_ned_m
    dist_to_edge_m := (Binary32.ofBits 0x00000000 /- 0 -/)
    return (result_ned_m, dist_to_edge_m)
  let dist_to_center_m_sq : Binary32 := Vector3f.length_squared vec_from_center_ned_m
  if dist_to_center_m_sq < Copter_lib.sq_float (Binary32.ofBits 0x3f000000 /- 0.5 -/) then
    result_ned_m := { result_ned_m with x := s._center_ned_m.x - Binary32.toBinary64 (s._radius_m * inp.cos_yaw) }
    result_ned_m := { result_ned_m with y := s._center_ned_m.y - Binary32.toBinary64 (s._radius_m * inp.sin_yaw) }
    result_ned_m := { result_ned_m with z := s._center_ned_m.z }
    dist_to_edge_m := Binary64.toBinary32 (Vector3p.length (Vector3p.op_sub_Vector3p stopping_point_ned_m result_ned_m))
    return (result_ned_m, dist_to_edge_m)
