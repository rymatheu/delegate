    s := t'7
    o := t'8
    success := t'9
  | .MOTOR_FRAME_OCTAQUAD =>
    let (t'10, t'11, t'12) := setup_octaquad_matrix s o frame_type
    s := t'10
    o := t'11
    success := t'12
  | .MOTOR_FRAME_DODECAHEXA =>
    let (t'13, t'14, t'15) := setup_dodecahexa_matrix s o frame_type
    s := t'13
    o := t'14
    success := t'15
  | .MOTOR_FRAME_Y6 =>
    let (t'16, t'17, t'18) := setup_y6_matrix s o frame_type
    s := t'16
    o := t'17
    success := t'18
  | .MOTOR_FRAME_DECA =>
    let (t'19, t'20, t'21) := setup_deca_matrix s o frame_type
