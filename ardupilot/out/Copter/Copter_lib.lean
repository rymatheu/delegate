/-- C++ `bool AC_Circle::update_ms(float climb_rate_ms)`, `AC_WPNav/AC_Circle.cpp:206-286`. -/
def update_ms (p : Params) (s : State) (w : World) (inp : Inputs) (climb_rate_ms : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0f -/)) : State × World × Bool := Id.run do
  let mut s := s
  let mut w := w
  s := calc_velocities s w false
  let dt : Binary32 := AC_PosControl.get_dt_s w.pos_control
  if s._angular_vel_rads < s._angular_vel_max_rads then
    s := { s with _angular_vel_rads := s._angular_vel_rads + Binary32.abs s._angular_accel_radss * dt }
    s := { s with _angular_vel_rads := Copter_lib.MIN_float2 s._angular_vel_rads s._angular_vel_max_rads }
  if s._angular_vel_rads > s._angular_vel_max_rads then
    s := { s with _angular_vel_rads := s._angular_vel_rads - Binary32.abs s._angular_accel_radss * dt }
    s := { s with _angular_vel_rads := Copter_lib.MAX_float2 s._angular_vel_rads s._angular_vel_max_rads }
  let angle_change_rad : Binary32 := s._angular_vel_rads * dt
  s := { s with _angle_rad := s._angle_rad + angle_change_rad }
  s := { s with _angle_rad := Copter_lib.wrap_PI_float s._angle_rad }
  s := { s with _angle_total_rad := s._angle_total_rad + angle_change_rad }
  let mut terrain_u_m : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0f -/)
  let mut t'3 := s._is_terrain_alt
  if t'3 then
    let (t'1, t'2) := get_terrain_U_m s terrain_u_m
    terrain_u_m := t'1
    t'3 := !t'2
  if t'3 then
    return (s, w, false)
  let mut target_d_m : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0 -/)  -- uninitialized in C++; assigned before every read
  if s._is_terrain_alt then
    target_d_m := Binary64.toBinary32 (s._center_ned_m.z - Binary32.toBinary64 terrain_u_m)
  else
    target_d_m := -(AC_PosControl.get_pos_desired_U_m w.pos_control)
  let mut target_ned_m : Vector3p.State := Vector3p.init_double3 s._center_ned_m.x s._center_ned_m.y (Binary32.toBinary64 target_d_m)
  if !(Copter_lib.is_zero_float s._radius_m) then
    target_ned_m := { target_ned_m with x := target_ned_m.x + Binary32.toBinary64 (s._radius_m * Musl.cosf.cosf (-s._angle_rad)) }
    target_ned_m := { target_ned_m with y := target_ned_m.y + Binary32.toBinary64 (-s._radius_m * Musl.sinf.sinf (-s._angle_rad)) }
    s := { s with _yaw_rad := Copter_lib.get_bearing_rad (Vector2p.tofloat ({ x := w.pos_control._pos_desired_ned_m.x, y := w.pos_control._pos_desired_ned_m.y } : Vector2p.State)) (Vector2p.tofloat ({ x := s._center_ned_m.x, y := s._center_ned_m.y } : Vector2p.State)) }
    if (UInt32.toInt32 (UInt16.toUInt32 p._options) &&& UInt32.toInt32 (AC_Circle.CircleOptions.toInt AC_Circle.CircleOptions.FACE_DIRECTION_OF_TRAVEL)) != (0 : Int32) then
      s := { s with _yaw_rad := s._yaw_rad + (if Copter_lib.is_positive_float s._rotation_rate_max_rads then -(Copter_lib.radians_float (Binary32.ofBits 0x42b40000 /- 90.0 -/)) else Copter_lib.radians_float (Binary32.ofBits 0x42b40000 /- 90.0 -/)) }
      s := { s with _yaw_rad := Copter_lib.wrap_2PI_float s._yaw_rad }
  else
    s := { s with _yaw_rad := s._angle_rad }
  let mut zero_ne : Vector2f.State := Vector2f.init_void
  let (t'4, t'5, t'6) := AC_PosControl.input_pos_vel_accel_NE_m w.pos_control ({ x := target_ned_m.x, y := target_ned_m.y } : Vector2p.State) zero_ne zero_ne true
  w := { w with pos_control := t'4 }
  target_ned_m := { target_ned_m with x := t'5.x, y := t'5.y }
  zero_ne := t'6
  if s._is_terrain_alt then
    let mut vel_zero : Binary32 := (Binary32.ofBits 0x00000000 /- 0 -/)
    let mut target_pos_d_m : Binary32 := Binary64.toBinary32 target_ned_m.z
    let (t'7, t'8, t'9) := AC_PosControl.input_pos_vel_accel_D_m w.pos_control target_pos_d_m vel_zero (Binary32.ofBits 0x00000000 /- 0 -/) true
    w := { w with pos_control := t'7 }
    target_pos_d_m := t'8
    vel_zero := t'9
  else
    w := { w with pos_control := AC_PosControl.D_set_pos_target_from_climb_rate_ms w.pos_control climb_rate_ms false }
  w := { w with pos_control := AC_PosControl.NE_update_controller w.pos_control'p w.pos_control w w.pos_control'inp }
  s := { s with _last_update_ms := inp.millis }
  return (s, w, true)

/-- C++ `bool AC_Circle::update_cms(float climb_rate_cms)`, `AC_WPNav/AC_Circle.cpp:197-201`. -/
def update_cms (p : Params) (s : State) (w : World) (inp : Inputs) (climb_rate_cms : Binary32 := (Binary32.ofBits 0x00000000 /- 0.0f -/)) : State × World × Bool := Id.run do
