  let cos_yaw : Binary32 := Musl.cosf.cosf att_target_euler_rad.z
  return Vector3f.init_float3 ((Binary32.ofBits 0x411ce80a /- 9.80665016 -/) * (-cos_yaw * sin_pitch * cos_roll - sin_yaw * sin_roll) / Copter_lib.MAX_float2 (cos_roll * cos_pitch) (Binary32.ofBits 0x3dcccccd /- 0.1f -/)) ((Binary32.ofBits 0x411ce80a /- 9.80665016 -/) * (-sin_yaw * sin_pitch * cos_roll + cos_yaw * sin_roll) / Copter_lib.MAX_float2 (cos_roll * cos_pitch) (Binary32.ofBits 0x3dcccccd /- 0.1f -/)) (-(Binary32.ofBits 0x411ce80a /- 9.80665016 -/))

