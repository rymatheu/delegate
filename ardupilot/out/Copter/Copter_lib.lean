  let mut pos := pos
  let mut vel := vel
  let mut delta_pos : Binary32 := vel * dt + accel * (Binary32.ofBits 0x3f000000 /- 0.5f -/) * sq_float dt
  if is_positive_float (delta_pos * limit) && is_positive_float (pos_error * limit) then
    delta_pos := (Binary32.ofBits 0x00000000 /- 0.0 -/)
  pos := pos + Binary32.toBinary64 delta_pos
  vel := update_vel_accel vel accel dt limit vel_error
  return (pos, vel)

