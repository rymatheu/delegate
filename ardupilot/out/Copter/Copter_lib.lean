/-- C++ `bool AC_AttitudeControl::body_to_euler_derivative(const Quaternion & att, const Vector3f & body_derivative_rads, Vector3f & euler_derivative_rads)`, `AC_AttitudeControl/AC_AttitudeControl.cpp:1323-1342` (a member of `AC_AttitudeControl`, translated for `AC_AttitudeControl_Multi`). -/
def body_to_euler_derivative (att : Quaternion.State) (body_derivative_rads : Vector3f.State) (euler_derivative_rads : Vector3f.State) : Vector3f.State × Bool := Id.run do
  let mut euler_derivative_rads := euler_derivative_rads
  let theta : Binary32 := Quaternion.get_euler_pitch att
  let phi : Binary32 := Quaternion.get_euler_roll att
  let sin_theta : Binary32 := Musl.sinf.sinf theta
  let cos_theta : Binary32 := Musl.cosf.cosf theta
  let sin_phi : Binary32 := Musl.sinf.sinf phi
  let cos_phi : Binary32 := Musl.cosf.cosf phi
  if Copter_lib.is_zero_float cos_theta then
    return (euler_derivative_rads, false)
  euler_derivative_rads := { euler_derivative_rads with x := body_derivative_rads.x + sin_phi * (sin_theta / cos_theta) * body_derivative_rads.y + cos_phi * (sin_theta / cos_theta) * body_derivative_rads.z }
  euler_derivative_rads := { euler_derivative_rads with y := cos_phi * body_derivative_rads.y - sin_phi * body_derivative_rads.z }
  euler_derivative_rads := { euler_derivative_rads with z := (sin_phi / cos_theta) * body_derivative_rads.y + (cos_phi / cos_theta) * body_derivative_rads.z }
  return (euler_derivative_rads, true)

end AC_AttitudeControl_Multi

