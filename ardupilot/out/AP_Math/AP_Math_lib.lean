  let d : Binary64 := det s
  if AP_Math_lib.is_zero_double d then
    return (inv, false)
  inv := { inv with a.x := (s.b.y * s.c.z - s.c.y * s.b.z) / d }
  inv := { inv with a.y := (s.a.z * s.c.y - s.a.y * s.c.z) / d }
  inv := { inv with a.z := (s.a.y * s.b.z - s.a.z * s.b.y) / d }
  inv := { inv with b.x := (s.b.z * s.c.x - s.b.x * s.c.z) / d }
  inv := { inv with b.y := (s.a.x * s.c.z - s.a.z * s.c.x) / d }
  inv := { inv with b.z := (s.b.x * s.a.z - s.a.x * s.b.z) / d }
  inv := { inv with c.x := (s.b.x * s.c.y - s.c.x * s.b.y) / d }
  inv := { inv with c.y := (s.c.x * s.a.y - s.a.x * s.c.y) / d }
  inv := { inv with c.z := (s.a.x * s.b.y - s.b.x * s.a.y) / d }
