def from_axis_angle (s : State) (v : Vector3p.State) (theta : Binary64) : State := Id.run do
  let mut s := s
  let C : Binary64 := Musl.cos.cos theta
  let S : Binary64 := Musl.sin.sin theta
  let t : Binary64 := (Binary64.ofBits 0x3ff0000000000000 /- 1.0f -/) - C
  let normv : Vector3p.State := Vector3p.normalized v
  let x : Binary64 := normv.x
  let y : Binary64 := normv.y
  let z : Binary64 := normv.z
  s := { s with a.x := t * x * x + C }
  s := { s with a.y := t * x * y - z * S }
  s := { s with a.z := t * x * z + y * S }
  s := { s with b.x := t * x * y + z * S }
  s := { s with b.y := t * y * y + C }
  s := { s with b.z := t * y * z - x * S }
  s := { s with c.x := t * x * z - y * S }
  s := { s with c.y := t * y * z + x * S }
  s := { s with c.z := t * z * z + C }
  return s

end Matrix3p

