  let mut roll := roll
  let mut pitch := pitch
  let mut yaw := yaw
  if pitch'given then
    pitch := -(AP_Math_lib.safe_asin_float s.c.x)
  if roll'given then
    roll := Musl.atan2f.atan2f s.c.y s.c.z
  if yaw'given then
    yaw := Musl.atan2f.atan2f s.b.x s.a.x
  return (roll, pitch, yaw)

