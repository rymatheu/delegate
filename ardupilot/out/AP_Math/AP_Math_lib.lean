/-- C++ `QuaternionT<float> QuaternionT<float>::operator*(const QuaternionT<float> & v) const`, `AP_Math/quaternion.cpp:712-731`. -/
def op_mul_Quaternion (s : State) (v : Quaternion.State) : Quaternion.State := Id.run do
  let mut ret : Quaternion.State := Quaternion.init_void
  let w1 : Float32 := s.q1
  let x1 : Float32 := s.q2
  let y1 : Float32 := s.q3
  let z1 : Float32 := s.q4
  let w2 : Float32 := v.q1
  let x2 : Float32 := v.q2
  let y2 : Float32 := v.q3
  let z2 : Float32 := v.q4
  ret := { ret with q1 := w1 * w2 - x1 * x2 - y1 * y2 - z1 * z2 }
  ret := { ret with q2 := w1 * x2 + x1 * w2 + y1 * z2 - z1 * y2 }
  ret := { ret with q3 := w1 * y2 - x1 * z2 + y1 * w2 + z1 * x2 }
  ret := { ret with q4 := w1 * z2 + x1 * y2 - y1 * x2 + z1 * w2 }
  return ret

/-- C++ `Vector3<float> QuaternionT<float>::operator*(const Vector3<float> & v) const`, `AP_Math/quaternion.cpp:738-759`. -/
def op_mul_Vector3f (s : State) (v : Vector3f.State) : Vector3f.State := Id.run do
  let mut ret : Vector3f.State := v
  let mut uv : Array Float32 := #[s.q3 * v.z - s.q4 * v.y, s.q4 * v.x - s.q2 * v.z, s.q2 * v.y - s.q3 * v.x]
  uv := uv.set! (Int32.toNatClampNeg (0 : Int32)) (uv[Int32.toNatClampNeg (0 : Int32)]! + uv[Int32.toNatClampNeg (0 : Int32)]!)
  uv := uv.set! (Int32.toNatClampNeg (1 : Int32)) (uv[Int32.toNatClampNeg (1 : Int32)]! + uv[Int32.toNatClampNeg (1 : Int32)]!)
  uv := uv.set! (Int32.toNatClampNeg (2 : Int32)) (uv[Int32.toNatClampNeg (2 : Int32)]! + uv[Int32.toNatClampNeg (2 : Int32)]!)
  ret := { ret with x := ret.x + (s.q1 * uv[Int32.toNatClampNeg (0 : Int32)]! + s.q3 * uv[Int32.toNatClampNeg (2 : Int32)]! - s.q4 * uv[Int32.toNatClampNeg (1 : Int32)]!) }
  ret := { ret with y := ret.y + (s.q1 * uv[Int32.toNatClampNeg (1 : Int32)]! + s.q4 * uv[Int32.toNatClampNeg (0 : Int32)]! - s.q2 * uv[Int32.toNatClampNeg (2 : Int32)]!) }
  ret := { ret with z := ret.z + (s.q1 * uv[Int32.toNatClampNeg (2 : Int32)]! + s.q2 * uv[Int32.toNatClampNeg (1 : Int32)]! - s.q3 * uv[Int32.toNatClampNeg (0 : Int32)]!) }
  return ret

