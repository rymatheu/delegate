  let x : Binary32 := normv.x
  let y : Binary32 := normv.y
  let z : Binary32 := normv.z
  s := { s with a.x := t * x * x + C }
  s := { s with a.y := t * x * y - z * S }
  s := { s with a.z := t * x * z + y * S }
  s := { s with b.x := t * x * y + z * S }
  s := { s with b.y := t * y * y + C }
  s := { s with b.z := t * y * z - x * S }
  s := { s with c.x := t * x * z - y * S }
  s := { s with c.y := t * y * z + x * S }
  s := { s with c.z := t * z * z + C }
  return s

