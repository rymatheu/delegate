/-- C++ `void QuaternionT<float>::from_euler(float roll, float pitch, float yaw)`, `AP_Math/quaternion.cpp:421-434`. -/
def from_euler_float3 (s : State) (roll : Binary32) (pitch : Binary32) (yaw : Binary32) : State := Id.run do
  let mut s := s
  let cr2 : Binary32 := Binary64.toBinary32 (Musl.cos.cos (Binary32.toBinary64 roll * (Binary64.ofBits 0x3fe0000000000000 /- 0.5 -/)))
  let cp2 : Binary32 := Binary64.toBinary32 (Musl.cos.cos (Binary32.toBinary64 pitch * (Binary64.ofBits 0x3fe0000000000000 /- 0.5 -/)))
  let cy2 : Binary32 := Binary64.toBinary32 (Musl.cos.cos (Binary32.toBinary64 yaw * (Binary64.ofBits 0x3fe0000000000000 /- 0.5 -/)))
  let sr2 : Binary32 := Binary64.toBinary32 (Musl.sin.sin (Binary32.toBinary64 roll * (Binary64.ofBits 0x3fe0000000000000 /- 0.5 -/)))
  let sp2 : Binary32 := Binary64.toBinary32 (Musl.sin.sin (Binary32.toBinary64 pitch * (Binary64.ofBits 0x3fe0000000000000 /- 0.5 -/)))
  let sy2 : Binary32 := Binary64.toBinary32 (Musl.sin.sin (Binary32.toBinary64 yaw * (Binary64.ofBits 0x3fe0000000000000 /- 0.5 -/)))
  s := { s with q1 := cr2 * cp2 * cy2 + sr2 * sp2 * sy2 }
  s := { s with q2 := sr2 * cp2 * cy2 - cr2 * sp2 * sy2 }
  s := { s with q3 := cr2 * sp2 * cy2 + sr2 * cp2 * sy2 }
  s := { s with q4 := cr2 * cp2 * sy2 - sr2 * sp2 * cy2 }
  return s

