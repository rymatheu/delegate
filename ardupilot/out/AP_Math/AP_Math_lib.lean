  let mut m : Matrix3f.State := Matrix3f.init_void
  m := rotation_matrix_Matrix3f s m
  v := Matrix3f.op_mul_Vector3f m v
  return v

/-- C++ `void QuaternionT<float>::from_euler(float roll, float pitch, float yaw)`, `AP_Math/quaternion.cpp:421-434`. -/
def from_euler_float3 (s : State) (roll : Float32) (pitch : Float32) (yaw : Float32) : State := Id.run do
  let mut s := s
  let cr2 : Float32 := Float.toFloat32 (Float.cos (Float32.toFloat roll * (0.5 : Float)))
  let cp2 : Float32 := Float.toFloat32 (Float.cos (Float32.toFloat pitch * (0.5 : Float)))
  let cy2 : Float32 := Float.toFloat32 (Float.cos (Float32.toFloat yaw * (0.5 : Float)))
  let sr2 : Float32 := Float.toFloat32 (Float.sin (Float32.toFloat roll * (0.5 : Float)))
  let sp2 : Float32 := Float.toFloat32 (Float.sin (Float32.toFloat pitch * (0.5 : Float)))
  let sy2 : Float32 := Float.toFloat32 (Float.sin (Float32.toFloat yaw * (0.5 : Float)))
  s := { s with q1 := cr2 * cp2 * cy2 + sr2 * sp2 * sy2 }
  s := { s with q2 := sr2 * cp2 * cy2 - cr2 * sp2 * sy2 }
  s := { s with q3 := cr2 * sp2 * cy2 + sr2 * cp2 * sy2 }
  s := { s with q4 := cr2 * cp2 * sy2 - sr2 * sp2 * cy2 }
  return s

/-- C++ `void QuaternionT<float>::from_euler(const Vector3<float> & v)`, `AP_Math/quaternion.cpp:436-439`. -/
def from_euler_Vector3f (s : State) (v : Vector3f.State) : State := Id.run do
  let mut s := s
  s := from_euler_float3 s v.x v.y v.z
  return s

/-- C++ `void QuaternionT<float>::from_axis_angle(const Vector3<float> & axis, float theta)`, `AP_Math/quaternion.cpp:469-483`. -/
def from_axis_angle_Vector3f_float (s : State) (axis : Vector3f.State) (theta : Float32) : State := Id.run do
  let mut s := s
  if AP_Math_lib.is_zero_float theta then
    s := { s with q1 := (1.0 : Float32) }
    s := { s with q4 := (0.0 : Float32) }
    s := { s with q3 := s.q4 }
    s := { s with q2 := s.q3 }
    return s
  let st2 : Float32 := Float.toFloat32 (Float.sin ((0.5 : Float) * Float32.toFloat theta))
  s := { s with q1 := Float.toFloat32 (Float.cos ((0.5 : Float) * Float32.toFloat theta)) }
  s := { s with q2 := axis.x * st2 }
  s := { s with q3 := axis.y * st2 }
  s := { s with q4 := axis.z * st2 }
  return s

end Quaternion

