  let mut z_vec : Vector3f.State := Vector3f.init_float3 (Binary32.ofBits 0x00000000 /- 0.0f -/) (Binary32.ofBits 0x00000000 /- 0.0f -/) (Binary32.ofBits 0x3f800000 /- 1.0f -/)
