/-- C++ `void QuaternionT<float>::rotation_matrix(Matrix3f & m) const`, `AP_Math/quaternion.cpp:59-80`. -/
def rotation_matrix_Matrix3f (s : State) (m : Matrix3f.State) : Matrix3f.State := Id.run do
  let mut m := m
  let q3q3 : Float32 := s.q3 * s.q3
  let q3q4 : Float32 := s.q3 * s.q4
  let q2q2 : Float32 := s.q2 * s.q2
  let q2q3 : Float32 := s.q2 * s.q3
  let q2q4 : Float32 := s.q2 * s.q4
  let q1q2 : Float32 := s.q1 * s.q2
  let q1q3 : Float32 := s.q1 * s.q3
  let q1q4 : Float32 := s.q1 * s.q4
  let q4q4 : Float32 := s.q4 * s.q4
  m := { m with a.x := (1.0 : Float32) - (2.0 : Float32) * (q3q3 + q4q4) }
  m := { m with a.y := (2.0 : Float32) * (q2q3 - q1q4) }
  m := { m with a.z := (2.0 : Float32) * (q2q4 + q1q3) }
  m := { m with b.x := (2.0 : Float32) * (q2q3 + q1q4) }
  m := { m with b.y := (1.0 : Float32) - (2.0 : Float32) * (q2q2 + q4q4) }
  m := { m with b.z := (2.0 : Float32) * (q3q4 - q1q2) }
  m := { m with c.x := (2.0 : Float32) * (q2q4 - q1q3) }
  m := { m with c.y := (2.0 : Float32) * (q3q4 + q1q2) }
  m := { m with c.z := (1.0 : Float32) - (2.0 : Float32) * (q2q2 + q3q3) }
  return m

