/-- C++ `void QuaternionT<float>::normalize()`, `AP_Math/quaternion.cpp:662-675`. -/
def normalize (s : State) : State := Id.run do
  let mut s := s
  let quatMag : Float32 := length s
  if !(AP_Math_lib.is_zero_float quatMag) then
    let quatMagInv : Float32 := (1.0 : Float32) / quatMag
    s := { s with q1 := s.q1 * quatMagInv }
    s := { s with q2 := s.q2 * quatMagInv }
    s := { s with q3 := s.q3 * quatMagInv }
    s := { s with q4 := s.q4 * quatMagInv }
  else
