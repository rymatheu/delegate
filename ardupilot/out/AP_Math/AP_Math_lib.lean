  m := { m with c.y := (Binary32.ofBits 0x40000000 /- 2.0f -/) * (q3q4 + q1q2) }
  m := { m with c.z := (Binary32.ofBits 0x3f800000 /- 1.0f -/) - (Binary32.ofBits 0x40000000 /- 2.0f -/) * (q2q2 + q3q3) }
