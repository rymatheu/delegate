  let (t'1, _) := op_div_assign s (length s)
  s := t'1
  return s

/-- C++ `Vector3<double> Vector3<double>::normalized() const`, `AP_Math/vector3.h:235-238`. -/
def normalized (s : State) : Vector3p.State := Id.run do
  return op_div s (length s)

/-- C++ `bool Vector3<double>::is_nan() const`, `AP_Math/vector3.cpp:364-367`. -/
def is_nan (s : State) : Bool := Id.run do
  return Float.isNaN s.x || Float.isNaN s.y || Float.isNaN s.z

/-- C++ `bool Vector3<double>::is_zero() const`, `AP_Math/vector3.h:325-327`. -/
def is_zero (s : State) : Bool := Id.run do
  return AP_Math_lib.is_zero_double s.x && AP_Math_lib.is_zero_double s.y && AP_Math_lib.is_zero_double s.z

/-- C++ `Vector3<float> Vector3<double>::tofloat() const`, `AP_Math/vector3.h:277-279`. -/
def tofloat (s : State) : Vector3f.State := Id.run do
  return Vector3f.init_float3 (Float.toFloat32 s.x) (Float.toFloat32 s.y) (Float.toFloat32 s.z)

/-- C++ `Vector3<double> Vector3<double>::todouble() const`, `AP_Math/vector3.h:280-282`. -/
def todouble (s : State) : Vector3p.State := Id.run do
  return Vector3p.init_double3 s.x s.y s.z

end Vector3p

end AP_Math_lib
