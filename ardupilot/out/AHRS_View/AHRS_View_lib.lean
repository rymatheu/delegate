  get_rotation_body_to_ned : Matrix3f.State := {}
  /-- `ahrs.get_gyro()` (first read at `ardupilot/ahrs/AP_AHRS_View.cpp:64`). -/
  get_gyro : Vector3f.State := {}
deriving Inhabited

/-- C++ `AP_AHRS_View::AP_AHRS_View(AP_AHRS & _ahrs)`, `ardupilot/ahrs/AP_AHRS_View_decls.h:28`. -/
def init : State := Id.run do
  let mut s : State := {}
  s := { s with rot_view := Matrix3f.init_void }
  s := { s with rot_view_T := Matrix3f.init_void }
  s := { s with rot_body_to_ned := Matrix3f.init_void }
  s := { s with gyro := Vector3f.init_void }
  return s

/-- C++ `void AP_AHRS_View::update()`, `ardupilot/ahrs/AP_AHRS_View.cpp:61-83`. -/
def update (s : State) (inp : Inputs) : State := Id.run do
  let mut s := s
  s := { s with rot_body_to_ned := inp.get_rotation_body_to_ned }
  s := { s with gyro := inp.get_gyro }
  if !(AHRS_View_lib.is_zero_float (s.y_angle + s._pitch_trim_deg)) then
    s := { s with rot_body_to_ned := Matrix3f.op_mul_Matrix3f s.rot_body_to_ned s.rot_view_T }
    s := { s with gyro := Matrix3f.op_mul_Vector3f s.rot_view s.gyro }
  let (t'1, t'2, t'3) := Matrix3f.to_euler s.rot_body_to_ned true s.roll true s.pitch true s.yaw
  s := { s with roll := t'1 }
  s := { s with pitch := t'2 }
  s := { s with yaw := t'3 }
  s := { s with roll_sensor := Binary32.toInt32 (AHRS_View_lib.degrees s.roll * (Binary32.ofBits 0x42c80000 /- 100 -/)) }
  s := { s with pitch_sensor := Binary32.toInt32 (AHRS_View_lib.degrees s.pitch * (Binary32.ofBits 0x42c80000 /- 100 -/)) }
  s := { s with yaw_sensor := Binary32.toInt32 (AHRS_View_lib.degrees s.yaw * (Binary32.ofBits 0x42c80000 /- 100 -/)) }
  if s.yaw_sensor < (0 : Int32) then
    s := { s with yaw_sensor := s.yaw_sensor + (36000 : Int32) }
  let (t'4, t'5, t'6, t'7, t'8, t'9) := AHRS_View_lib.AP_AHRS_calc_trig s.rot_body_to_ned s.trig.cos_roll s.trig.cos_pitch s.trig.cos_yaw s.trig.sin_roll s.trig.sin_pitch s.trig.sin_yaw
  s := { s with trig.cos_roll := t'4 }
  s := { s with trig.cos_pitch := t'5 }
  s := { s with trig.cos_yaw := t'6 }
  s := { s with trig.sin_roll := t'7 }
  s := { s with trig.sin_pitch := t'8 }
  s := { s with trig.sin_yaw := t'9 }
  return s

end AP_AHRS_View

end AHRS_View_lib
