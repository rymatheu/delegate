  w := t'23
  results := { results with terrain_alt_variance := t'24 }
  results := { results with terrain_alt_variance_valid := t'25 }
  let (t'26, t'27, t'28) := NavEKF3.getEkfControlLimits w.EKF3 w results.control_ground_speed_limit_ms results.control_gain_scaler_XY
  w := t'26
  results := { results with control_ground_speed_limit_ms := t'27 }
  results := { results with control_gain_scaler_XY := t'28 }
  results := { results with control_gain_scaler_Z := (Binary32.ofBits 0x3f800000 /- 1 -/) }
  let (t'29, t'30) := NavEKF3.getHeightControlLimit w.EKF3 w results.control_height_limit_m
  results := { results with control_height_limit_m := t'29 }
