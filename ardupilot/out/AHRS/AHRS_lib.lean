def setYawSource (s : State) (inp : Inputs) : State := Id.run do
  let mut s := s
  let mut yaw_source : AP_NavEKF_Source.SourceYaw := (inp.getYawSource_at.getD (UInt8.toNat s.core_index) AP_NavEKF_Source.SourceYaw.NONE)
  if s.wasLearningCompass_ms > Int32.toUInt32 (0 : Int32) then
