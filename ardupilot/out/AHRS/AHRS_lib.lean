/-- C++ `void AP_AHRS_DCM::drift_correction_yaw()`, `AP_AHRS/AP_AHRS_DCM.cpp:650-774`. -/
def drift_correction_yaw (s : State) (w : World) (o : Outputs) (inp : Inputs) : State × World × Outputs := Id.run do
