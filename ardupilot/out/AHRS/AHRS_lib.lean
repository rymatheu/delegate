/-- C++ `bool AP_AHRS_NavEKF3::synthetic_airspeed_EAS(const Estimates & results, float & airspeed_ret, AirspeedEstimateType & type)`, `AP_AHRS/AP_AHRS_NavEKF3.cpp:250-273`. -/
def synthetic_airspeed_EAS (w : World) (inp : Inputs) (results : AP_AHRS_Backend.Estimates.State) (airspeed_ret : Binary32) (type : AP_AHRS_Backend.AirspeedEstimateType) : Binary32 × AP_AHRS_Backend.AirspeedEstimateType × Bool := Id.run do
