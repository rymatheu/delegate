/-- C++ `static bool AP_Declination::get_mag_field_ef(float latitude_deg, float longitude_deg, float & intensity_gauss, float & declination_deg, float & inclination_deg)`, `AP_Declination/AP_Declination.cpp:35-116`. -/
def get_mag_field_ef (latitude_deg longitude_deg intensity_gauss declination_deg inclination_deg : Binary32) : Binary32 × Binary32 × Binary32 × Bool := Id.run do
  let mut intensity_gauss := intensity_gauss
  let mut declination_deg := declination_deg
  let mut inclination_deg := inclination_deg
  let mut valid_input_data : Bool := true
  let mut min_lat : Binary32 := Int32.toBinary32 (Binary32.toInt32 (Int32.toBinary32 (Binary32.toInt32 (Binary32.floor (latitude_deg / SAMPLING_RES))) * SAMPLING_RES))
  let mut min_lon : Binary32 := Int32.toBinary32 (Binary32.toInt32 (Int32.toBinary32 (Binary32.toInt32 (Binary32.floor (longitude_deg / SAMPLING_RES))) * SAMPLING_RES))
  if latitude_deg ≤ SAMPLING_MIN_LAT then
    min_lat := Int32.toBinary32 (Binary32.toInt32 SAMPLING_MIN_LAT)
    valid_input_data := false
  if latitude_deg ≥ SAMPLING_MAX_LAT then
    min_lat := Int32.toBinary32 (Binary32.toInt32 (Int32.toBinary32 (Binary32.toInt32 (latitude_deg / SAMPLING_RES)) * SAMPLING_RES - SAMPLING_RES))
    valid_input_data := false
  if longitude_deg ≤ SAMPLING_MIN_LON then
    min_lon := Int32.toBinary32 (Binary32.toInt32 SAMPLING_MIN_LON)
    valid_input_data := false
  if longitude_deg ≥ SAMPLING_MAX_LON then
    min_lon := Int32.toBinary32 (Binary32.toInt32 (Int32.toBinary32 (Binary32.toInt32 (longitude_deg / SAMPLING_RES)) * SAMPLING_RES - SAMPLING_RES))
    valid_input_data := false
  let min_lat_index : UInt32 := Int32.toUInt32 (AHRS_lib.constrain_int32 (UInt32.toInt32 (Binary32.toUInt32 ((-SAMPLING_MIN_LAT + min_lat) / SAMPLING_RES))) (0 : Int32) (UInt32.toInt32 (LAT_TABLE_SIZE - Int32.toUInt32 (2 : Int32))))
  let min_lon_index : UInt32 := Int32.toUInt32 (AHRS_lib.constrain_int32 (UInt32.toInt32 (Binary32.toUInt32 ((-SAMPLING_MIN_LON + min_lon) / SAMPLING_RES))) (0 : Int32) (UInt32.toInt32 (LON_TABLE_SIZE - Int32.toUInt32 (2 : Int32))))
  let mut data_sw : Binary32 := (intensity_table[UInt32.toNat min_lat_index]!)[UInt32.toNat min_lon_index]!
  let mut data_se : Binary32 := (intensity_table[UInt32.toNat min_lat_index]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  let mut data_ne : Binary32 := (intensity_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  let mut data_nw : Binary32 := (intensity_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat min_lon_index]!
  let mut data_min : Binary32 := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_se - data_sw) + data_sw
  let mut data_max : Binary32 := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_ne - data_nw) + data_nw
  intensity_gauss := ((latitude_deg - min_lat) / SAMPLING_RES) * (data_max - data_min) + data_min
  data_sw := (declination_table[UInt32.toNat min_lat_index]!)[UInt32.toNat min_lon_index]!
  data_se := (declination_table[UInt32.toNat min_lat_index]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  data_ne := (declination_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  data_nw := (declination_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat min_lon_index]!
  data_min := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_se - data_sw) + data_sw
  data_max := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_ne - data_nw) + data_nw
  declination_deg := ((latitude_deg - min_lat) / SAMPLING_RES) * (data_max - data_min) + data_min
  data_sw := (inclination_table[UInt32.toNat min_lat_index]!)[UInt32.toNat min_lon_index]!
  data_se := (inclination_table[UInt32.toNat min_lat_index]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  data_ne := (inclination_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat (min_lon_index + Int32.toUInt32 (1 : Int32))]!
  data_nw := (inclination_table[UInt32.toNat (min_lat_index + Int32.toUInt32 (1 : Int32))]!)[UInt32.toNat min_lon_index]!
  data_min := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_se - data_sw) + data_sw
  data_max := ((longitude_deg - min_lon) / SAMPLING_RES) * (data_ne - data_nw) + data_nw
  inclination_deg := ((latitude_deg - min_lat) / SAMPLING_RES) * (data_max - data_min) + data_min
  return (intensity_gauss, declination_deg, inclination_deg, valid_input_data)

end AP_Declination

