  | .TAKEOFF_EXPECTED => (2048 : Int32)
  | .TOUCHDOWN_EXPECTED => (4096 : Int32)
  | .USING_GPS => (8192 : Int32)
  | .GPS_GLITCHING => (16384 : Int32)
