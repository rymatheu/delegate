    if inp.millis - s._last_consistent_heading > Int32.toUInt32 (2000 : Int32) then
      return (s, false)
  else
    s := { s with _last_consistent_heading := inp.millis }
  return (s, true)

/-- C++ `float AP_AHRS_DCM::_P_gain(float spin_rate)`, `AP_AHRS/AP_AHRS_DCM.cpp:556-566`. -/
def _P_gain (spin_rate : Binary32) : Binary32 := Id.run do
  if spin_rate < AHRS_lib.radians_int32_t (50 : Int32) then
    return (Binary32.ofBits 0x3f800000 /- 1.0f -/)
  if spin_rate > AHRS_lib.radians_int32_t (500 : Int32) then
    return (Binary32.ofBits 0x41200000 /- 10.0f -/)
  return spin_rate / AHRS_lib.radians_int32_t (50 : Int32)

