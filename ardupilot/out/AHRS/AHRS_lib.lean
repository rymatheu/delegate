/-- C++ `void NavEKF3_core::setAidingMode()`, `AP_NavEKF3/AP_NavEKF3_Control.cpp:239-513`. -/
def setAidingMode (s : State) (w : World) (inp : Inputs) : State := Id.run do
  let mut s := s
