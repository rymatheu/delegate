    ekfGndSpdLimit := Binary64.toBinary32 (Binary32.toBinary64 (AHRS_lib.MAX_float2 (w.EKF3'p._maxFlowRate - (Binary32.ofBits 0x3f800000 /- 1.0f -/)) (Binary32.ofBits 0x00000000 /- 0.0f -/)) * AHRS_lib.MAX_double2 (s.terrainState - s.statesArray[9]!) s.rngOnGnd)
    let gainHgt : Binary64 := Binary32.toBinary64 (AHRS_lib.MAX_float2 w.EKF3'p._flowNavGainHgt (Binary32.ofBits 0x3f800000 /- 1.0f -/))
    ekfNavVelGainScaler := Binary64.toBinary32 (gainHgt / AHRS_lib.MAX_double2 (s.terrainState - s.statesArray[9]!) gainHgt)
  else
    ekfGndSpdLimit := (Binary32.ofBits 0x43c80000 /- 400.0f -/)
    ekfNavVelGainScaler := (Binary32.ofBits 0x3f800000 /- 1.0f -/)
