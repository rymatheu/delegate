/-- C++ `bool AP_AHRS_DCM::use_compass()`, `AP_AHRS/AP_AHRS_DCM.cpp:611-645`. -/
def use_compass (s : State) (w : World) (inp : Inputs) : State × Bool := Id.run do
  let mut s := s
  if !inp.use_for_yaw then
    return (s, false)
  if !(AP_AHRS.get_fly_forward w.ahrs) || !(have_gps w inp) then
    return (s, true)
  if inp.ground_speed < (Binary32.ofBits 0x40400000 /- (float)3 -/) then
    return (s, true)
  let error : Binary32 := Binary32.abs (AHRS_lib.wrap_180_float (AHRS_lib.degrees s.yaw - inp.ground_course))
