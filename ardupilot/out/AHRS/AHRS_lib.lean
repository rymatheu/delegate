      yaw_deltat := UInt32.toBinary32 (inp.last_fix_time_ms - s._gps_last_update) * (Binary32.ofBits 0x3a83126f /- 1.0e-3f -/)
      s := { s with _gps_last_update := inp.last_fix_time_ms }
      new_value := true
      let gps_course_rad : Binary32 := AHRS_lib.radians_float inp.ground_course
      let yaw_error_rad : Binary32 := AHRS_lib.wrap_PI_float (gps_course_rad - s.yaw)
      yaw_error := Musl.sinf.sinf yaw_error_rad
      if !s.have_initial_yaw || decide (yaw_deltat > (Binary32.ofBits 0x41a00000 /- 20 -/)) || (decide (inp.ground_speed ≥ (Binary32.ofBits 0x41100000 /- (float)9 -/)) && decide (Binary32.abs yaw_error_rad ≥ (Binary32.ofBits 0x3f860419 /- 1.047f -/))) then
        s := { s with _dcm_matrix := Matrix3f.from_euler s._dcm_matrix s.roll s.pitch gps_course_rad }
        s := { s with _omega_yaw_P := Vector3f.zero s._omega_yaw_P }
        s := { s with have_initial_yaw := true }
        yaw_error := (Binary32.ofBits 0x00000000 /- 0 -/)
