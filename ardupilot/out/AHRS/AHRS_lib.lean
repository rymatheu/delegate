    s := { s with _last_lng := inp.location.lng }
    s := { s with _last_pos_ms := inp.millis }
    s := { s with _position_offset_north := (Binary32.ofBits 0x00000000 /- 0 -/) }
    s := { s with _position_offset_east := (Binary32.ofBits 0x00000000 /- 0 -/) }
