/-- The construction of the file-scope objects, in definition order (C++ static initialization). -/
def World.init : World := Id.run do
  let mut w : World := {}
  let (t'p, t's, t'w) := NavEKF3.init w
  w := { t'w with EKF3'p := t'p, EKF3 := t's }
  let (t'p, t's) := AP_AHRS.construct w w.ahrs'inp (Int8.toUInt8 (Int32.toInt8 (0 : Int32)))
  w := { w with ahrs'p := t'p, ahrs := t's }
  return w

end AHRS_lib
