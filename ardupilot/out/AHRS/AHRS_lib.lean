  let relyingOnFlowData : Bool := (decide (s.imuSampleTime_ms - s.bodyOdm.prevFuseTime_ms > Int32.toUInt32 (1000 : Int32))) && (decide (s.imuSampleTime_ms - s.flowValidMeaTime_ms ≤ Int32.toUInt32 (10000 : Int32)))
