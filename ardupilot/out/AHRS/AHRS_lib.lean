def op_mod (s : State) (v : Vector3p.State) : Vector3p.State := Id.run do
  let temp : Vector3p.State := Vector3p.init_double3 (s.y * v.z - s.z * v.y) (s.z * v.x - s.x * v.z) (s.x * v.y - s.y * v.x)
