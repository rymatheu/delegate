      w := t'5
      s := w.ahrs  -- this object's state as the call left it
      p := w.ahrs'p  -- this object's state as the call left it
      s := { s with ekf3 := t'4 }
  | .ahrs'dcm =>  -- C++ `ahrs.dcm`
      w := { w with ahrs := s, ahrs'p := p }  -- this object's state into the World: the call reaches it
      let (t'6, t'7, t'8) := AP_AHRS_DCM.update s.dcm w o.dcm inp.dcm
      w := t'7
      s := w.ahrs  -- this object's state as the call left it
      p := w.ahrs'p  -- this object's state as the call left it
      s := { s with dcm := t'6 }
      o := { o with dcm := t'8 }
  | .ahrs'sim =>  -- C++ `ahrs.sim`
      pure ()  -- C++ `AP_AHRS_SIM::update`: an empty body
