def getEkfControlLimits (s : State) (w : World) (ekfGndSpdLimit : Binary32) (ekfNavVelGainScaler : Binary32) : Binary32 × Binary32 := Id.run do
  let mut ekfGndSpdLimit := ekfGndSpdLimit
