    if decide (s.EKFGSF_yaw_reset_request_ms > Int32.toUInt32 (0 : Int32)) && decide (s.imuSampleTime_ms - s.EKFGSF_yaw_reset_request_ms < Int32.toUInt32 (5000 : Int32)) then
