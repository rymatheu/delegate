/-- C++ `void AP_AHRS::update(bool skip_ins_update)`, `AP_AHRS/AP_AHRS.cpp:550-667`. -/
def update (p : Params) (s : State) (w : World) (o : Outputs) (inp : Inputs) (skip_ins_update : Bool := false) : Params × State × World × Outputs := Id.run do
