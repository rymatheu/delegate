  let spin_rate : Binary32 := Vector3f.length s._omega
  if w.ahrs'p._kp_yaw < (Binary32.ofBits 0x3d4ccccd /- 0.0500000007 -/) then
    w := { w with ahrs'p._kp_yaw := (Binary32.ofBits 0x3d4ccccd /- 0.0500000007 -/) }
  s := { s with _omega_yaw_P.z := error_z * _P_gain spin_rate * w.ahrs'p._kp_yaw * _yaw_gain s }
  if use_fast_gains s inp then
    s := { s with _omega_yaw_P.z := s._omega_yaw_P.z * (Binary32.ofBits 0x41000000 /- 8 -/) }
  if decide (yaw_deltat < (Binary32.ofBits 0x40000000 /- 2.0f -/)) && decide (spin_rate < AHRS_lib.radians_int32_t (20 : Int32)) then
    s := { s with _omega_I_sum.z := s._omega_I_sum.z + error_z * _ki_yaw * yaw_deltat }
