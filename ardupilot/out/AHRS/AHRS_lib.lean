    s := { s with _omega_I_sum.y := AHRS_lib.constrain_value_line_float s._omega_I_sum.y (-change_limit) change_limit (Int32.toUInt32 (1114 : Int32)) }
    s := { s with _omega_I_sum.z := AHRS_lib.constrain_value_line_float s._omega_I_sum.z (-change_limit) change_limit (Int32.toUInt32 (1115 : Int32)) }
