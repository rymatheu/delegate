    s := { s with timing.dtIMUavg_min := Binary64.toBinary32 (AHRS_lib.MIN_float_double s.timing.dtIMUavg_min s.dtIMUavg) }
    s := { s with timing.dtEKFavg_max := Binary64.toBinary32 (AHRS_lib.MAX_float_double s.timing.dtEKFavg_max s.dtEkfAvg) }
    s := { s with timing.dtEKFavg_min := Binary64.toBinary32 (AHRS_lib.MIN_float_double s.timing.dtEKFavg_min s.dtEkfAvg) }
    s := { s with timing.delAngDT_max := Binary64.toBinary32 (AHRS_lib.MAX_float_double s.timing.delAngDT_max s.imuDataDelayed.delAngDT) }
    s := { s with timing.delAngDT_min := Binary64.toBinary32 (AHRS_lib.MIN_float_double s.timing.delAngDT_min s.imuDataDelayed.delAngDT) }
    s := { s with timing.delVelDT_max := Binary64.toBinary32 (AHRS_lib.MAX_float_double s.timing.delVelDT_max s.imuDataDelayed.delVelDT) }
    s := { s with timing.delVelDT_min := Binary64.toBinary32 (AHRS_lib.MIN_float_double s.timing.delVelDT_min s.imuDataDelayed.delVelDT) }
