def error (s : State) (o : Outputs) (e : AP_InternalError.error_t) (line : UInt16) : State × Outputs := Id.run do
  let mut s := s
  let mut o := o
  s := { s with internal_errors := s.internal_errors ||| AP_InternalError.error_t.toInt e }
  s := { s with total_error_count := s.total_error_count + (1 : UInt32) }
  s := { s with last_line := line }
  o := o.push (Output.hal_util_persistent_data_internal_errors s.internal_errors)
  o := o.push (Output.hal_util_persistent_data_internal_error_count (UInt32.toUInt16 s.total_error_count))
