{
 "translate": "ardupilot/translate_mission.sh",
 "out": "ardupilot/out/Mission",
 "namespace": "Mission_lib",
 "ref_flags": "AP_Mission/AP_Mission.cpp",
 "access_control": false,
 "cxx_flags": [
  "-I$HERE/ardupilot",
  "-DAP_SDCARD_STORAGE_ENABLED=0"
 ],
 "cxx_sources": [
  "AP_Mission/AP_Mission.cpp",
  "StorageManager/StorageManager.cpp",
  "AP_Param/AP_ParamT.cpp",
  "AP_Math/location.cpp",
  "AP_Common/Location.cpp",
  "AP_Math/AP_Math.cpp",
  "AP_HAL/Storage.cpp"
 ],
 "cxx_env": [
  "ardupilot/mission_env.cpp"
 ],
 "world": {
  "cxx_include": [
   "\"mission_driver.h\""
  ],
  "cxx_world": {
   "unity": "ardupilot/unity_mission.cpp"
  },
  "objects": [
   "tester"
  ],
  "globals": [
   "void cpp2lean_set_armed(bool b);",
   "extern uint32_t cpp2lean_millis;",
   "Location &cpp2lean_home();"
  ],
  "inputs": {
   "mission.get_soft_armed": "cpp2lean_set_armed(%s);",
   "mission.millis": "cpp2lean_millis = %s;",
   "mission.get_home.relative_alt": "cpp2lean_home().relative_alt = %s;",
   "mission.get_home.loiter_ccw": "cpp2lean_home().loiter_ccw = %s;",
   "mission.get_home.terrain_alt": "cpp2lean_home().terrain_alt = %s;",
   "mission.get_home.origin_alt": "cpp2lean_home().origin_alt = %s;",
   "mission.get_home.loiter_xtrack": "cpp2lean_home().loiter_xtrack = %s;",
   "mission.get_home.alt": "cpp2lean_home().alt = %s;",
   "mission.get_home.lat": "cpp2lean_home().lat = %s;",
   "mission.get_home.lng": "cpp2lean_home().lng = %s;"
  },
  "calls": 3000,
  "range_prob": 1.0,
  "domains": {
