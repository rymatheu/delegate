   ],
   "tester.t_replace.kind": [
    0,
    7
   ],
   "tester.t_raw.index": [
    0,
    60
   ],
   "tester.t_raw.tag": [
    0,
    7
   ],
   "tester.t_read.index": [
    0,
    60
   ],
   "tester.t_truncate.index": [
    0,
    60
   ],
   "tester.t_next.start": [
    0,
    60
   ],
   "tester.t_conv.kind": [
    0,
    15
   ],
   "tester.t_item.kind": [
    0,
    15
   ],
   "@relative_alt": [
    0,
    1
   ],
   "@loiter_ccw": [
    0,
    1
   ],
   "@terrain_alt": [
    0,
    1
