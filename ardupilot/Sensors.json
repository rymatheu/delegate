{
 "translate": "ardupilot/translate_sensors.sh",
 "out": "ardupilot/out/Sensors",
 "namespace": "Sensors_lib",
 "ref_flags": "AP_Baro/AP_Baro.cpp",
 "access_control": false,
 "skip_leaves": {
  "EstScheduler": [
   "_recs["
  ]
 },
 "cxx_sources": [
  "AP_Baro/AP_Baro.cpp",
  "AP_Baro/AP_Baro_Backend.cpp",
  "AP_Baro/AP_Baro_atmosphere.cpp",
  "AP_Param/AP_ParamT.cpp",
  "AP_Common/Location.cpp",
  "AP_HAL/Device.cpp",
  "Filter/DerivativeFilter.cpp",
  "Filter/LowPassFilter.cpp",
  "AP_Math/AP_Math.cpp",
  "AP_Math/vector2.cpp",
  "AP_Math/vector3.cpp",
  "AP_Math/matrix3.cpp",
  "AP_Math/quaternion.cpp",
  "AP_Math/location.cpp",
  "AP_HAL/Util.cpp",
  "AP_HAL/Scheduler.cpp",
  "AP_HAL/Semaphores.cpp",
  "AP_Compass/AP_Compass.cpp",
  "AP_Compass/AP_Compass_Backend.cpp",
  "AP_Compass/Compass_PerMotor.cpp",
  "AP_Declination/AP_Declination.cpp",
  "AP_Declination/tables.cpp",
  "AP_HAL/RCOutput.cpp",
  "AP_InertialSensor/AP_InertialSensor.cpp",
  "AP_InertialSensor/AP_InertialSensor_Backend.cpp",
  "AP_InertialSensor/AP_InertialSensor_Params.cpp",
  "AP_GPS/AP_GPS.cpp",
  "AP_GPS/GPS_Backend.cpp",
  "AP_GPS/AP_GPS_Params.cpp",
  "AP_RTC/AP_RTC.cpp",
  "AP_RTC/JitterCorrection.cpp",
  "Filter/LowPassFilter2p.cpp",
  "AP_HAL/UARTDriver.cpp",
  "AP_HAL/utility/BetterStream.cpp",
  "AP_HAL/utility/print_vprintf.cpp",
  "AP_HAL/utility/RingBuffer.cpp",
  "AP_Math/crc.cpp",
  "AP_HAL/utility/ftoa_engine.cpp",
  "AP_HAL/utility/utoa_invert.cpp"
 ],
 "cxx_env": [
  "reference/hal/sensors.cpp",
  "reference/hal/sensors_baro.cpp",
  "reference/hal/sensors_compass.cpp",
  "reference/hal/sensors_ins.cpp",
  "reference/hal/sensors_gps.cpp",
  "reference/hal/est_scheduler.cpp",
  "reference/hal/est_uart.cpp",
  "ardupilot/sensors_env.cpp"
 ],
 "world": {
  "cxx_include": [
   "<AP_Baro/AP_Baro.h>",
   "<AP_Baro/AP_Baro_SITL.h>",
   "<AP_Compass/AP_Compass.h>",
   "<AP_Compass/AP_Compass_SITL.h>",
   "<SITL/SITL.h>",
   "<AP_InertialSensor/AP_InertialSensor.h>",
   "<AP_InertialSensor/AP_InertialSensor_SITL.h>",
   "<AP_GPS/AP_GPS.h>",
   "<AP_GPS/AP_GPS_SITL.h>",
   "<AP_RTC/AP_RTC.h>",
   "\"est_scheduler.h\"",
   "\"est_uart.h\"",
   "\"cpp2lean_events.h\""
  ],
  "cxx_world": {
   "unity": "ardupilot/unity_sensors.cpp"
  },
  "globals": [
   "extern bool cpp2lean_watchdog_reset;",
   "extern Location cpp2lean_origin;",
   "extern bool cpp2lean_origin_ok;",
   "extern Location cpp2lean_location;",
   "extern bool cpp2lean_location_ok;",
   "extern float cpp2lean_current;",
   "extern bool cpp2lean_current_ok;",
   "void cpp2lean_set_armed(bool v);",
   "extern bool cpp2lean_find_serial[2];",
   "extern bool cpp2lean_gyro_id_loaded;",
   "extern bool cpp2lean_accel_id_loaded;"
  ],
  "inputs": {
   "barometer.was_watchdog_reset": "cpp2lean_watchdog_reset = %s;",
   "barometer.get_soft_armed": "cpp2lean_set_armed(%s);",
   "barometer.get_origin_ret.relative_alt": "cpp2lean_origin.relative_alt = %s;",
   "barometer.get_origin_ret.loiter_ccw": "cpp2lean_origin.loiter_ccw = %s;",
   "barometer.get_origin_ret.terrain_alt": "cpp2lean_origin.terrain_alt = %s;",
   "barometer.get_origin_ret.origin_alt": "cpp2lean_origin.origin_alt = %s;",
   "barometer.get_origin_ret.loiter_xtrack": "cpp2lean_origin.loiter_xtrack = %s;",
   "barometer.get_origin_ret.alt": "cpp2lean_origin.alt = %s;",
   "barometer.get_origin_ret.lat": "cpp2lean_origin.lat = %s;",
   "barometer.get_origin_ret.lng": "cpp2lean_origin.lng = %s;",
   "barometer.get_origin": "cpp2lean_origin_ok = %s;",
   "compass.get_location_loc.relative_alt": "cpp2lean_location.relative_alt = %s;",
   "compass.get_location_loc.loiter_ccw": "cpp2lean_location.loiter_ccw = %s;",
   "compass.get_location_loc.terrain_alt": "cpp2lean_location.terrain_alt = %s;",
   "compass.get_location_loc.origin_alt": "cpp2lean_location.origin_alt = %s;",
   "compass.get_location_loc.loiter_xtrack": "cpp2lean_location.loiter_xtrack = %s;",
   "compass.get_location_loc.alt": "cpp2lean_location.alt = %s;",
   "compass.get_location_loc.lat": "cpp2lean_location.lat = %s;",
   "compass.get_location_loc.lng": "cpp2lean_location.lng = %s;",
   "compass.get_location": "cpp2lean_location_ok = %s;",
   "compass._per_motor.find_channel_chan": "(void)(%s);   // read with COMPASS_PMOT_EN 1 only, which no call sets",
   "compass._per_motor.find_channel_k_motor1": "(void)(%s);   // read with COMPASS_PMOT_EN 1 only, which no call sets",
   "compass._per_motor.find_channel_k_motor2": "(void)(%s);   // read with COMPASS_PMOT_EN 1 only, which no call sets",
   "compass._per_motor.find_channel_k_motor3": "(void)(%s);   // read with COMPASS_PMOT_EN 1 only, which no call sets",
   "compass._per_motor.find_channel_k_motor4": "(void)(%s);   // read with COMPASS_PMOT_EN 1 only, which no call sets",
   "compass._per_motor.read_last_sent": "(void)(%s);   // read with COMPASS_PMOT_EN 1 only, which no call sets",
   "compass._per_motor.scale_esc_to_unity": "(void)(%s);   // read with COMPASS_PMOT_EN 1 only, which no call sets",
   "heap'AP_Compass_SITL.current_amps_current": "cpp2lean_current = %s;",
   "heap'AP_Compass_SITL.current_amps_0": "cpp2lean_current_ok = %s;",
   "ins.gyro_id__gyro_count_loaded": "cpp2lean_gyro_id_loaded = %s;",
   "ins.accel_id__accel_count_loaded": "cpp2lean_accel_id_loaded = %s;",
   "gps.find_serial_found_SerialProtocol_GPS_at1[1]": "cpp2lean_find_serial[1] = %s;"
  },
  "calls": 4000,
  "exclude": [
   "barometer.init",
   "barometer.calibrate",
   "barometer.register_sensor",
   "barometer._add_backend",
   "compass.init",
   "ins.init",
   "ins.init_gyro",
   "ins._init_gyro",
   "est_scheduler.feed_baro_lines"
  ],
  "exclude_note": "init (a second init registers more back ends than BARO_MAX_DRIVERS: AP_HAL::panic), calibrate (its second loop has no delay: it ends only when samples arrive, so it runs in the setup, after lines with samples are fed), register_sensor and _add_backend (beyond BARO_MAX_INSTANCES: panic) are called in the setup only; ins.init and its gyro calibration (it waits for samples until it converges or 30 s of lines pass) in the setup only",
  "domains": {
   "instance": [
    0,
    2
   ],
   "n0": [
    1,
    3
   ],
   "i": [
    0,
    2
   ],
   "loop_rate": [
    50,
    400
   ],
   "ms": [
    0,
    20
   ],
   "usec": [
    0,
    5000
   ],
   "us": [
    0,
    5000
   ],
   "n": [
    0,
    40
   ]
  },
  "ranges": {
   "pa": [
    90000,
    110000
   ],
   "dpa": [
    -2,
    2
   ],
   "degc": [
    -20,
    50
   ],
   "dt_us": [
    100,
    5000
   ],
   "k": [
    1,
    8
   ],
   "pressure": [
    90000,
    110000
   ],
   "base_pressure": [
    90000,
    110000
   ],
   "altitude": [
    -100,
    3000
   ],
   "hz": [
    400,
    2000
   ],
   "@barometer.get_origin_ret.alt": [
    0,
    100000
   ],
   "@barometer.get_origin_ret.lat": [
    -900000000,
    900000000
   ],
   "@barometer.get_origin_ret.lng": [
    -1800000000,
    1800000000
   ],
   "thr_pct": [
    0,
    1
   ],
   "voltage": [
    3,
    17
   ],
   "mx": [
    -600,
    600
   ],
   "my": [
    -600,
    600
   ],
   "mz": [
    -600,
    600
   ],
   "@heap'AP_Compass_SITL.current_amps_current": [
    0,
    30
   ],
   "@compass.get_location_loc.lat": [
    -900000000,
    900000000
   ],
   "@compass.get_location_loc.lng": [
    -1800000000,
    1800000000
   ]
  },
  "weights": {
   "est_scheduler.feed_line": 40,
   "est_scheduler.feed_baro_lines": 3,
   "barometer.update": 20,
   "est_scheduler.delay": 12,
   "est_scheduler.delay_microseconds": 8,
   "est_scheduler.delay_microseconds_boost": 2,
   "compass.read": 15,
   "est_scheduler.feed_imu_lines": 2,
   "ins.update": 15,
   "ins.wait_for_sample": 4,
   "gps.update": 10
  },
  "input_corners": "readers",
  "input_aliases": {
   "ins.was_watchdog_reset": "barometer.was_watchdog_reset",
   "rtc.get_soft_armed": "barometer.get_soft_armed",
   "heap'AP_InertialSensor_SITL.get_soft_armed": "barometer.get_soft_armed"
  },
  "input_aliases_note": "one C++ value read by several objects: the HAL's watchdog flag (the barometer, the inertial sensor's calibration timing) and armed flag (the barometer, AP_RTC, the IMU back end's convergence)",
  "const_inputs": {
   "gps.params_0_type_configured": "1",
   "gps.find_serial_found_SerialProtocol_GPS_at1[0]": "1"
  },
  "const_inputs_note": "what the environment returns: GPS1_TYPE stored in storage (AP_Param::configured() of gps.params[0].type, sensors_env.cpp), the GPS protocol's first port found (the GPS port stand-in est_uart, as the reference's SERIAL3)",
  "indexed_input_lengths": {
   "gps.find_serial_found_SerialProtocol_GPS_at1": 2
  },
  "unlogged_outputs": [
   "AP_Notify_flags_initialising",
   "AP_Notify_flags_gyro_calibrated",
   "AP_Notify_flags_gps_status",
   "AP_Notify_flags_gps_num_sats"
  ],
  "unlogged_outputs_note": "AP_Notify's LED and buzzer flags (a static struct of a class outside the World): the C++ side cannot observe a write to it",
  "state_params": {
   "gps.params[0].type._value": "100"
  },
  "guards": {
   "ins.update": {
    "cxx": "est_scheduler._count >= 16",
    "lean": "w.est_scheduler._count.toNat \u2265 16"
   },
   "ins.wait_for_sample": {
    "cxx": "est_scheduler._count >= 16",
    "lean": "w.est_scheduler._count.toNat \u2265 16"
   }
  },
  "guards_note": "AP_InertialSensor::wait_for_sample (also inside update) loops until IMU samples arrive: called only while at least 16 input records are fed (every random line has an IMU sample); random barometer-only lines (feed_baro_lines) are fed in the setups only"
 },
 "world_runs": [
  {
   "run": "calibrated",
   "setup": [
    "est_scheduler.feed_baro_lines 900 4 47b893d4 3d4ccccd 41a00000",
    "barometer.init",
    "compass.init",
    "gps.init",
    "barometer.calibrate 1",
    "est_scheduler.feed_imu_lines 300 4 3c23d70a bc23d70a c11ce80a 3a83126f ba83126f 3b03126f 47b893d4 41a00000",
    "ins.init 400"
   ],
   "range_prob": 1.0,
   "run_note": "plausible samples: 900 lines with a pressure sample every 4th (about 94500 Pa, 20 deg C) before init and calibrate, GPS1_TYPE 100 (the GPS stand-in), then 300 lines with three samples of each IMU (level, small gyro rates) for the gyro calibration of ins.init(400), then random lines (at least one IMU sample each), updates, delays and getters with values in the ranges"
  },
  {
   "run": "wild",
   "setup": [
    "est_scheduler.feed_baro_lines 900 3 47c35000 bf800000 c1a00000",
    "barometer.init",
    "compass.init",
    "gps.init",
    "barometer.calibrate 0",
    "est_scheduler.feed_imu_lines 300 3 00000000 00000000 c11ce80a 00000000 00000000 00000000 47c35000 c1a00000",
    "ins.init 400"
   ],
   "range_prob": 0.85,
   "run_note": "the same with 15% of the random values outside the ranges (NaN, infinities, huge values) and the corner values of every argument and input"
  },
  {
   "run": "two_imus",
   "setup": [
    "est_scheduler.feed_baro_lines 900 4 47b893d4 3d4ccccd 41a00000",
    "barometer.init",
    "compass.init",
    "gps.init",
    "barometer.calibrate 1",
    "est_scheduler.feed_imu_lines 300 4 3c23d70a bc23d70a c11ce80a 3a83126f ba83126f 3b03126f 47b893d4 41a00000",
    "ins.init 400"
   ],
   "state_params": {
    "sitl.imu_count._value": "2",
    "gps.params[0].type._value": "100",
    "gps.params[1].type._value": "100"
   },
   "range_prob": 1.0,
   "run_note": "two IMUs (SIM_IMU_COUNT 2: two IMU stand-ins, the second's samples in the lines' second IMU) and two GPS receivers of type 100 (the second without a port when its input says so)"
  }
 ]
}
