# The AP_Math functions cpp2lean translates (ardupilot/translate_ap_math.sh, --use @AP_Math.use):
# what the hand port ../AP_Math/*.lean covers, plus wrap_180/wrap_360, linear_interpolate and the
# double versions of the wrap functions. One entry per line: a function name (every overload and
# template specialization in the translation unit), or Class<args>::member, optionally with the
# parameter types. Everything these call is translated with them.

# ftype.h, AP_Math.h, AP_Math.cpp
is_zero(float)
is_zero(double)
is_positive
is_negative
is_equal(float, float)
constrain_value_line
safe_sqrt(float)
safe_asin(float)
sq(float)
norm(float, float)
norm(float, float, float)
radians(float)
cd_to_rad
rad_to_cd
degrees
wrap_180(float)
wrap_180(double)
wrap_360(float)
wrap_360(double)
wrap_2PI(float)
wrap_2PI(double)
wrap_PI(float)
wrap_PI(double)
linear_interpolate
calc_lowpass_alpha_dt

