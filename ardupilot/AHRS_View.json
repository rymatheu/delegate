{
 "translate": "ardupilot/translate_ahrs_view.sh",
 "out": "ardupilot/out/AHRS_View",
 "namespace": "AHRS_View_lib",
 "cxx_flags": [
  "-std=gnu++11",
  "-O2",
  "-ffp-contract=off",
  "-fno-fast-math",
  "-ftrapping-math",
  "-fsigned-char",
  "-fno-exceptions",
  "-fno-rtti",
  "-Wno-unused-parameter",
  "-Wno-invalid-offsetof",
  "-cl-single-precision-constant",
  "-Wno-inconsistent-missing-override",
  "-Wno-gnu-designator",
  "-Wno-vla-extension",
  "-Wno-expansion-to-defined",
  "-Wno-trigraphs",
  "-fno-builtin-sinf",
  "-fno-builtin-cosf",
  "-DCONFIG_HAL_BOARD=HAL_BOARD_SITL",
  "-DCONFIG_HAL_BOARD_SUBTYPE=HAL_BOARD_SUBTYPE_NONE",
  "-DAP_SCRIPTING_CHECKS=1",
  "-DAP_BARO_PROBE_EXTERNAL_I2C_BUSES=1",
  "-DHAL_NAVEKF2_AVAILABLE=1",
  "-DARDUPILOT_BUILD",
  "-DAPM_BUILD_DIRECTORY=APM_BUILD_ArduCopter",
  "-DAP_BUILD_TARGET_NAME=\"ArduCopter\"",
  "-DFRAME_CONFIG=MULTICOPTER_FRAME",
  "-D__AP_LINE__=__LINE__",
  "-DHAL_WITH_POSTYPE_DOUBLE=1",
  "-DHAL_WITH_EKF_DOUBLE=1",
  "-DAP_FILTER_ENABLED=0",
  "-I$STUBS",
  "-I$L/AP_Common/missing",
  "-I$L",
  "-I$HERE/ardupilot",
  "-include",
  "ap_config.h"
 ],
 "cxx_sources": [],
 "cxx_env": [
  "ardupilot/unity_ahrs_view.cpp",
  "ardupilot/ahrs_view_env.cpp"
 ],
 "cxx_env_note": "the unity file is the C++ side too: the copies of update and calc_trig need the declarations of ardupilot/ahrs/AP_AHRS_View_decls.h before them; it also includes the AP_Math sources",
 "classes": [
  {
   "class": "AP_AHRS_View",
   "cxx_include": [
    "\"ahrs/AP_AHRS_View_decls.h\""
   ],
   "globals": [
    "extern Matrix3f ahrs_rot;",
    "extern Vector3f ahrs_gyro;",
    "static AP_AHRS ahrs_obj;   // the boundary: its estimate is the driver's input"
   ],
   "ctor": [],
   "boundary_args": [
    "ahrs_obj"
   ],
   "inputs": {
    "get_rotation_body_to_ned.a.x": "ahrs_rot.a.x = %s;",
    "get_rotation_body_to_ned.a.y": "ahrs_rot.a.y = %s;",
    "get_rotation_body_to_ned.a.z": "ahrs_rot.a.z = %s;",
    "get_rotation_body_to_ned.b.x": "ahrs_rot.b.x = %s;",
    "get_rotation_body_to_ned.b.y": "ahrs_rot.b.y = %s;",
    "get_rotation_body_to_ned.b.z": "ahrs_rot.b.z = %s;",
    "get_rotation_body_to_ned.c.x": "ahrs_rot.c.x = %s;",
    "get_rotation_body_to_ned.c.y": "ahrs_rot.c.y = %s;",
    "get_rotation_body_to_ned.c.z": "ahrs_rot.c.z = %s;",
    "get_gyro.x": "ahrs_gyro.x = %s;",
    "get_gyro.y": "ahrs_gyro.y = %s;",
    "get_gyro.z": "ahrs_gyro.z = %s;"
   },
   "state_from_line": true,
   "rotation_inputs": {
    "get_rotation_body_to_ned": 0.9
   },
   "ranges": {
    "get_rotation_body_to_ned": [
     -1,
     1
    ],
    "get_gyro": [
     -5,
     5
    ],
    "y_angle": [
     0,
     0
    ],
    "_pitch_trim_deg": [
     0,
     0
    ],
    "rot_view": [
     -1,
     1
    ],
    "rot_view_T": [
     -1,
     1
    ],
    "rot_body_to_ned": [
     -1,
     1
    ],
    "trig": [
     -1,
     1
    ],
    "roll": [
     -3.1416,
     3.1416
    ],
    "pitch": [
     -1.5708,
     1.5708
    ],
    "yaw": [
     -3.1416,
     3.1416
    ],
    "gyro": [
     -5,
     5
    ]
   },
   "range_prob": 0.6,
   "calls": 20000,
   "range_note": "y_angle and _pitch_trim_deg are 0 (ROTATION_NONE, no trim) on 60% of the lines, random otherwise (the rotated-view branch); 90% of the rotation inputs are rotation matrices, a tenth of them at pitch +-90 degrees (calc_trig's fallback)"
  }
 ]
}
