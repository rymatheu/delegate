    |> Bytes.putU8 m.battery_function
    |> Bytes.putU8 m.«type»
    |> Bytes.putI8 m.battery_remaining
    |> Bytes.putI32 m.time_remaining
    |> Bytes.putU8 m.charge_state
    |> Bytes.putArray 4 Bytes.putU16 m.voltages_ext
    |> Bytes.putU8 m.mode
    |> Bytes.putU32 m.fault_bitmask

def decode (b : ByteArray) : BatteryStatus :=
  { current_consumed := Bytes.i32 b 0,
    energy_consumed := Bytes.i32 b 4,
    temperature := Bytes.i16 b 8,
    voltages := Bytes.array b 10 10 2 Bytes.u16,
    current_battery := Bytes.i16 b 30,
    id := Bytes.u8 b 32,
    battery_function := Bytes.u8 b 33,
    «type» := Bytes.u8 b 34,
    battery_remaining := Bytes.i8 b 35,
    time_remaining := Bytes.i32 b 36,
    charge_state := Bytes.u8 b 40,
    voltages_ext := Bytes.array b 41 4 2 Bytes.u16,
    mode := Bytes.u8 b 49,
    fault_bitmask := Bytes.u32 b 50 }

def toWords (m : BatteryStatus) : Array Int :=
  #[Int.ofNat m.id.toNat] ++
  #[Int.ofNat m.battery_function.toNat] ++
  #[Int.ofNat m.«type».toNat] ++
  #[m.temperature.toInt] ++
  (Bytes.padded 10 0 m.voltages).map (fun x => Int.ofNat x.toNat) ++
  #[m.current_battery.toInt] ++
  #[m.current_consumed.toInt] ++
  #[m.energy_consumed.toInt] ++
  #[m.battery_remaining.toInt] ++
  #[m.time_remaining.toInt] ++
  #[Int.ofNat m.charge_state.toNat] ++
  (Bytes.padded 4 0 m.voltages_ext).map (fun x => Int.ofNat x.toNat) ++
  #[Int.ofNat m.mode.toNat] ++
  #[Int.ofNat m.fault_bitmask.toNat]

def ofWords (ws : Array Int) : BatteryStatus :=
  { id := let x := ws.getD 0 0; UInt8.ofNat x.toNat,
    battery_function := let x := ws.getD 1 0; UInt8.ofNat x.toNat,
    «type» := let x := ws.getD 2 0; UInt8.ofNat x.toNat,
    temperature := let x := ws.getD 3 0; Int16.ofInt x,
    voltages := Array.ofFn (n := 10) fun i => let x := ws.getD (4 + i.val) 0; UInt16.ofNat x.toNat,
    current_battery := let x := ws.getD 14 0; Int16.ofInt x,
    current_consumed := let x := ws.getD 15 0; Int32.ofInt x,
    energy_consumed := let x := ws.getD 16 0; Int32.ofInt x,
    battery_remaining := let x := ws.getD 17 0; Int8.ofInt x,
    time_remaining := let x := ws.getD 18 0; Int32.ofInt x,
    charge_state := let x := ws.getD 19 0; UInt8.ofNat x.toNat,
    voltages_ext := Array.ofFn (n := 4) fun i => let x := ws.getD (20 + i.val) 0; UInt16.ofNat x.toNat,
    mode := let x := ws.getD 24 0; UInt8.ofNat x.toNat,
    fault_bitmask := let x := ws.getD 25 0; UInt32.ofNat x.toNat }

end BatteryStatus

/-- AUTOPILOT_VERSION (#148, CRC_EXTRA 178, payload 60..78 bytes). Version and capability of autopilot software. -/
structure AutopilotVersion where
  /-- uint64_t: Bitmap of capabilities. -/
  capabilities : UInt64 := 0
  /-- uint32_t: Firmware version number. -/
  flight_sw_version : UInt32 := 0
  /-- uint32_t: Middleware version number. -/
  middleware_sw_version : UInt32 := 0
  /-- uint32_t: Operating system version number. -/
  os_sw_version : UInt32 := 0
  /-- uint32_t: HW / board version (last 8 bits should be silicon ID, if any). -/
  board_version : UInt32 := 0
  /-- uint8_t[8]: Custom version field, commonly the first 8 bytes of the git hash. -/
  flight_custom_version : Array UInt8 := #[]
  /-- uint8_t[8]: Custom version field, commonly the first 8 bytes of the git hash. -/
  middleware_custom_version : Array UInt8 := #[]
  /-- uint8_t[8]: Custom version field, commonly the first 8 bytes of the git hash. -/
  os_custom_version : Array UInt8 := #[]
  /-- uint16_t: ID of the board vendor. -/
  vendor_id : UInt16 := 0
  /-- uint16_t: ID of the product. -/
  product_id : UInt16 := 0
  /-- uint64_t: UID if provided by hardware (see uid2). -/
  uid : UInt64 := 0
  /-- uint8_t[18] (extension): UID if provided by hardware (supersedes the uid field. -/
  uid2 : Array UInt8 := #[]
  deriving Inhabited

namespace AutopilotVersion

def encode (m : AutopilotVersion) : ByteArray :=
  ByteArray.empty
    |> Bytes.putU64 m.capabilities
    |> Bytes.putU64 m.uid
    |> Bytes.putU32 m.flight_sw_version
    |> Bytes.putU32 m.middleware_sw_version
    |> Bytes.putU32 m.os_sw_version
    |> Bytes.putU32 m.board_version
    |> Bytes.putU16 m.vendor_id
    |> Bytes.putU16 m.product_id
    |> Bytes.putArray 8 Bytes.putU8 m.flight_custom_version
    |> Bytes.putArray 8 Bytes.putU8 m.middleware_custom_version
    |> Bytes.putArray 8 Bytes.putU8 m.os_custom_version
    |> Bytes.putArray 18 Bytes.putU8 m.uid2

def decode (b : ByteArray) : AutopilotVersion :=
  { capabilities := Bytes.u64 b 0,
    uid := Bytes.u64 b 8,
    flight_sw_version := Bytes.u32 b 16,
    middleware_sw_version := Bytes.u32 b 20,
    os_sw_version := Bytes.u32 b 24,
    board_version := Bytes.u32 b 28,
    vendor_id := Bytes.u16 b 32,
    product_id := Bytes.u16 b 34,
    flight_custom_version := Bytes.array b 36 8 1 Bytes.u8,
    middleware_custom_version := Bytes.array b 44 8 1 Bytes.u8,
    os_custom_version := Bytes.array b 52 8 1 Bytes.u8,
    uid2 := Bytes.array b 60 18 1 Bytes.u8 }

def toWords (m : AutopilotVersion) : Array Int :=
  #[Int.ofNat m.capabilities.toNat] ++
  #[Int.ofNat m.flight_sw_version.toNat] ++
  #[Int.ofNat m.middleware_sw_version.toNat] ++
  #[Int.ofNat m.os_sw_version.toNat] ++
  #[Int.ofNat m.board_version.toNat] ++
  (Bytes.padded 8 0 m.flight_custom_version).map (fun x => Int.ofNat x.toNat) ++
  (Bytes.padded 8 0 m.middleware_custom_version).map (fun x => Int.ofNat x.toNat) ++
  (Bytes.padded 8 0 m.os_custom_version).map (fun x => Int.ofNat x.toNat) ++
  #[Int.ofNat m.vendor_id.toNat] ++
  #[Int.ofNat m.product_id.toNat] ++
  #[Int.ofNat m.uid.toNat] ++
  (Bytes.padded 18 0 m.uid2).map (fun x => Int.ofNat x.toNat)

def ofWords (ws : Array Int) : AutopilotVersion :=
  { capabilities := let x := ws.getD 0 0; UInt64.ofNat x.toNat,
    flight_sw_version := let x := ws.getD 1 0; UInt32.ofNat x.toNat,
    middleware_sw_version := let x := ws.getD 2 0; UInt32.ofNat x.toNat,
    os_sw_version := let x := ws.getD 3 0; UInt32.ofNat x.toNat,
    board_version := let x := ws.getD 4 0; UInt32.ofNat x.toNat,
    flight_custom_version := Array.ofFn (n := 8) fun i => let x := ws.getD (5 + i.val) 0; UInt8.ofNat x.toNat,
    middleware_custom_version := Array.ofFn (n := 8) fun i => let x := ws.getD (13 + i.val) 0; UInt8.ofNat x.toNat,
    os_custom_version := Array.ofFn (n := 8) fun i => let x := ws.getD (21 + i.val) 0; UInt8.ofNat x.toNat,
    vendor_id := let x := ws.getD 29 0; UInt16.ofNat x.toNat,
    product_id := let x := ws.getD 30 0; UInt16.ofNat x.toNat,
    uid := let x := ws.getD 31 0; UInt64.ofNat x.toNat,
    uid2 := Array.ofFn (n := 18) fun i => let x := ws.getD (32 + i.val) 0; UInt8.ofNat x.toNat }

end AutopilotVersion

/-- HOME_POSITION (#242, CRC_EXTRA 104, payload 52..60 bytes). Contains the home position. -/
structure HomePosition where
  /-- int32_t: Latitude (WGS84). -/
  latitude : Int32 := 0
  /-- int32_t: Longitude (WGS84). -/
  longitude : Int32 := 0
  /-- int32_t: Altitude (MSL). -/
  altitude : Int32 := 0
  /-- float: Local X position of this position in the local coordinate frame (NED). -/
  x : R := 0
  /-- float: Local Y position of this position in the local coordinate frame (NED). -/
  y : R := 0
  /-- float: Local Z position of this position in the local coordinate frame (NED: positive "down"). -/
  z : R := 0
  /-- float[4]: Quaternion indicating world-to-surface-normal and heading transformation of the takeoff position. -/
  q : Array R := #[]
  /-- float: Local X position of the end of the approach vector. -/
  approach_x : R := 0
  /-- float: Local Y position of the end of the approach vector. -/
  approach_y : R := 0
  /-- float: Local Z position of the end of the approach vector. -/
  approach_z : R := 0
  /-- uint64_t (extension): Timestamp (UNIX Epoch time or time since system boot). -/
  time_usec : UInt64 := 0
  deriving Inhabited

namespace HomePosition

def encode (m : HomePosition) : ByteArray :=
  ByteArray.empty
    |> Bytes.putI32 m.latitude
    |> Bytes.putI32 m.longitude
    |> Bytes.putI32 m.altitude
    |> Bytes.putF32 m.x
    |> Bytes.putF32 m.y
    |> Bytes.putF32 m.z
    |> Bytes.putArray 4 Bytes.putF32 m.q
    |> Bytes.putF32 m.approach_x
    |> Bytes.putF32 m.approach_y
    |> Bytes.putF32 m.approach_z
    |> Bytes.putU64 m.time_usec

def decode (b : ByteArray) : HomePosition :=
  { latitude := Bytes.i32 b 0,
    longitude := Bytes.i32 b 4,
    altitude := Bytes.i32 b 8,
    x := Bytes.f32 b 12,
    y := Bytes.f32 b 16,
    z := Bytes.f32 b 20,
    q := Bytes.array b 24 4 4 Bytes.f32,
    approach_x := Bytes.f32 b 40,
    approach_y := Bytes.f32 b 44,
    approach_z := Bytes.f32 b 48,
    time_usec := Bytes.u64 b 52 }

def toWords (m : HomePosition) : Array Int :=
  #[m.latitude.toInt] ++
  #[m.longitude.toInt] ++
  #[m.altitude.toInt] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.x).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.y).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.z).toNat] ++
  (Bytes.padded 4 (0 : R) m.q).map (fun x => Int.ofNat (ExecFloat.Binary.toBits32 x).toNat) ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.approach_x).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.approach_y).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.approach_z).toNat] ++
  #[Int.ofNat m.time_usec.toNat]

def ofWords (ws : Array Int) : HomePosition :=
  { latitude := let x := ws.getD 0 0; Int32.ofInt x,
    longitude := let x := ws.getD 1 0; Int32.ofInt x,
    altitude := let x := ws.getD 2 0; Int32.ofInt x,
    x := let x := ws.getD 3 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    y := let x := ws.getD 4 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    z := let x := ws.getD 5 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    q := Array.ofFn (n := 4) fun i => let x := ws.getD (6 + i.val) 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    approach_x := let x := ws.getD 10 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    approach_y := let x := ws.getD 11 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    approach_z := let x := ws.getD 12 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    time_usec := let x := ws.getD 13 0; UInt64.ofNat x.toNat }

end HomePosition

/-- MESSAGE_INTERVAL (#244, CRC_EXTRA 95, payload 6..6 bytes). The interval between messages for a particular MAVLink message ID. -/
structure MessageInterval where
  /-- uint16_t: The ID of the requested MAVLink message. -/
  message_id : UInt16 := 0
  /-- int32_t: The interval between two messages. -/
  interval_us : Int32 := 0
  deriving Inhabited

namespace MessageInterval

def encode (m : MessageInterval) : ByteArray :=
  ByteArray.empty
    |> Bytes.putI32 m.interval_us
    |> Bytes.putU16 m.message_id

def decode (b : ByteArray) : MessageInterval :=
  { interval_us := Bytes.i32 b 0,
    message_id := Bytes.u16 b 4 }

def toWords (m : MessageInterval) : Array Int :=
  #[Int.ofNat m.message_id.toNat] ++
  #[m.interval_us.toInt]

def ofWords (ws : Array Int) : MessageInterval :=
  { message_id := let x := ws.getD 0 0; UInt16.ofNat x.toNat,
    interval_us := let x := ws.getD 1 0; Int32.ofInt x }

end MessageInterval

/-- EXTENDED_SYS_STATE (#245, CRC_EXTRA 130, payload 2..2 bytes). Provides state for additional features. -/
structure ExtendedSysState where
  /-- uint8_t: The VTOL state if applicable. -/
  vtol_state : UInt8 := 0
  /-- uint8_t: The landed state. -/
  landed_state : UInt8 := 0
  deriving Inhabited

namespace ExtendedSysState

def encode (m : ExtendedSysState) : ByteArray :=
  ByteArray.empty
    |> Bytes.putU8 m.vtol_state
    |> Bytes.putU8 m.landed_state

def decode (b : ByteArray) : ExtendedSysState :=
  { vtol_state := Bytes.u8 b 0,
    landed_state := Bytes.u8 b 1 }

def toWords (m : ExtendedSysState) : Array Int :=
  #[Int.ofNat m.vtol_state.toNat] ++
  #[Int.ofNat m.landed_state.toNat]

def ofWords (ws : Array Int) : ExtendedSysState :=
  { vtol_state := let x := ws.getD 0 0; UInt8.ofNat x.toNat,
    landed_state := let x := ws.getD 1 0; UInt8.ofNat x.toNat }

end ExtendedSysState

/-- STATUSTEXT (#253, CRC_EXTRA 83, payload 51..54 bytes). Status text message. -/
structure Statustext where
  /-- uint8_t: Severity of status. -/
  severity : UInt8 := 0
  /-- char[50]: Status text message, without null termination character. -/
  text : ByteArray := ByteArray.empty
  /-- uint16_t (extension): Unique (opaque) identifier for this statustext message. -/
  id : UInt16 := 0
  /-- uint8_t (extension): This chunk's sequence number; indexing is from zero. -/
  chunk_seq : UInt8 := 0
  deriving Inhabited

namespace Statustext

def encode (m : Statustext) : ByteArray :=
  ByteArray.empty
    |> Bytes.putU8 m.severity
    |> Bytes.putChars 50 m.text
    |> Bytes.putU16 m.id
    |> Bytes.putU8 m.chunk_seq

def decode (b : ByteArray) : Statustext :=
  { severity := Bytes.u8 b 0,
    text := Bytes.chars b 1 50,
    id := Bytes.u16 b 51,
    chunk_seq := Bytes.u8 b 53 }

def toWords (m : Statustext) : Array Int :=
  #[Int.ofNat m.severity.toNat] ++
  (Bytes.charsPadded 50 m.text).map (fun x => Int.ofNat x.toNat) ++
  #[Int.ofNat m.id.toNat] ++
  #[Int.ofNat m.chunk_seq.toNat]

def ofWords (ws : Array Int) : Statustext :=
  { severity := let x := ws.getD 0 0; UInt8.ofNat x.toNat,
    text := ByteArray.mk (Array.ofFn (n := 50) fun i => let x := ws.getD (1 + i.val) 0; UInt8.ofNat x.toNat),
    id := let x := ws.getD 51 0; UInt16.ofNat x.toNat,
    chunk_seq := let x := ws.getD 52 0; UInt8.ofNat x.toNat }

end Statustext

/-- PARAM_ERROR (#345, CRC_EXTRA 209, payload 21..21 bytes). Parameter set/get error. -/
structure ParamError where
  /-- uint8_t: System ID. -/
  target_system : UInt8 := 0
  /-- uint8_t: Component ID. -/
  target_component : UInt8 := 0
  /-- char[16]: Parameter id. -/
  param_id : ByteArray := ByteArray.empty
  /-- int16_t: Parameter index. -/
  param_index : Int16 := 0
  /-- uint8_t: Error being returned to client. -/
  error : UInt8 := 0
  deriving Inhabited

namespace ParamError

def encode (m : ParamError) : ByteArray :=
  ByteArray.empty
    |> Bytes.putI16 m.param_index
    |> Bytes.putU8 m.target_system
    |> Bytes.putU8 m.target_component
    |> Bytes.putChars 16 m.param_id
    |> Bytes.putU8 m.error

def decode (b : ByteArray) : ParamError :=
  { param_index := Bytes.i16 b 0,
    target_system := Bytes.u8 b 2,
    target_component := Bytes.u8 b 3,
    param_id := Bytes.chars b 4 16,
    error := Bytes.u8 b 20 }

def toWords (m : ParamError) : Array Int :=
  #[Int.ofNat m.target_system.toNat] ++
  #[Int.ofNat m.target_component.toNat] ++
  (Bytes.charsPadded 16 m.param_id).map (fun x => Int.ofNat x.toNat) ++
  #[m.param_index.toInt] ++
  #[Int.ofNat m.error.toNat]

def ofWords (ws : Array Int) : ParamError :=
  { target_system := let x := ws.getD 0 0; UInt8.ofNat x.toNat,
    target_component := let x := ws.getD 1 0; UInt8.ofNat x.toNat,
    param_id := ByteArray.mk (Array.ofFn (n := 16) fun i => let x := ws.getD (2 + i.val) 0; UInt8.ofNat x.toNat),
    param_index := let x := ws.getD 18 0; Int16.ofInt x,
    error := let x := ws.getD 19 0; UInt8.ofNat x.toNat }

end ParamError

