  | .missionRequest _ => 40
  | .missionSetCurrent _ => 41
  | .missionCurrent _ => 42
  | .missionRequestList _ => 43
  | .missionCount _ => 44
  | .missionClearAll _ => 45
  | .missionItemReached _ => 46
  | .missionAck _ => 47
  | .gpsGlobalOrigin _ => 49
  | .missionRequestInt _ => 51
  | .navControllerOutput _ => 62
  | .requestDataStream _ => 66
  | .missionItemInt _ => 73
  | .vfrHud _ => 74
