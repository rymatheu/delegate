  | .heartbeat _ => 0
  | .sysStatus _ => 1
  | .systemTime _ => 2
  | .ping _ => 4
  | .setMode _ => 11
  | .paramRequestRead _ => 20
  | .paramRequestList _ => 21
  | .paramValue _ => 22
  | .paramSet _ => 23
  | .gpsRawInt _ => 24
  | .attitude _ => 30
  | .attitudeQuaternion _ => 31
  | .localPositionNed _ => 32
  | .globalPositionInt _ => 33
