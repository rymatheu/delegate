  | gpsRawInt (m : GpsRawInt)
  | attitude (m : Attitude)
  | attitudeQuaternion (m : AttitudeQuaternion)
  | localPositionNed (m : LocalPositionNed)
  | globalPositionInt (m : GlobalPositionInt)
  | missionItem (m : MissionItem)
  | missionRequest (m : MissionRequest)
  | missionSetCurrent (m : MissionSetCurrent)
