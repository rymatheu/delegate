/-- ATTITUDE_QUATERNION (#31, CRC_EXTRA 246, payload 32..48 bytes). The attitude in the aeronautical frame (right-handed, Z-down, X-front, Y-right), expressed as quaternion. -/
structure AttitudeQuaternion where
  /-- uint32_t: Timestamp (time since system boot). -/
  time_boot_ms : UInt32 := 0
  /-- float: Quaternion component 1, w (1 in null-rotation). -/
  q1 : R := 0
  /-- float: Quaternion component 2, x (0 in null-rotation). -/
  q2 : R := 0
  /-- float: Quaternion component 3, y (0 in null-rotation). -/
  q3 : R := 0
  /-- float: Quaternion component 4, z (0 in null-rotation). -/
  q4 : R := 0
  /-- float: Roll angular speed. -/
  rollspeed : R := 0
  /-- float: Pitch angular speed. -/
  pitchspeed : R := 0
  /-- float: Yaw angular speed. -/
  yawspeed : R := 0
  /-- float[4] (extension): Rotation offset by which the attitude quaternion and angular speed vector should be rotated for user display (quaternion with [w, x, y, z] order, zero-rotation is [1, 0, 0, 0], send [0, 0, 0, 0] if field not supported). -/
  repr_offset_q : Array R := #[]
  deriving Inhabited

namespace AttitudeQuaternion

def encode (m : AttitudeQuaternion) : ByteArray :=
  ByteArray.empty
    |> Bytes.putU32 m.time_boot_ms
    |> Bytes.putF32 m.q1
    |> Bytes.putF32 m.q2
    |> Bytes.putF32 m.q3
    |> Bytes.putF32 m.q4
    |> Bytes.putF32 m.rollspeed
    |> Bytes.putF32 m.pitchspeed
    |> Bytes.putF32 m.yawspeed
    |> Bytes.putArray 4 Bytes.putF32 m.repr_offset_q

def decode (b : ByteArray) : AttitudeQuaternion :=
  { time_boot_ms := Bytes.u32 b 0,
    q1 := Bytes.f32 b 4,
    q2 := Bytes.f32 b 8,
    q3 := Bytes.f32 b 12,
    q4 := Bytes.f32 b 16,
    rollspeed := Bytes.f32 b 20,
    pitchspeed := Bytes.f32 b 24,
    yawspeed := Bytes.f32 b 28,
    repr_offset_q := Bytes.array b 32 4 4 Bytes.f32 }

def toWords (m : AttitudeQuaternion) : Array Int :=
  #[Int.ofNat m.time_boot_ms.toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.q1).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.q2).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.q3).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.q4).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.rollspeed).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.pitchspeed).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.yawspeed).toNat] ++
  (Bytes.padded 4 (0 : R) m.repr_offset_q).map (fun x => Int.ofNat (ExecFloat.Binary.toBits32 x).toNat)

def ofWords (ws : Array Int) : AttitudeQuaternion :=
  { time_boot_ms := let x := ws.getD 0 0; UInt32.ofNat x.toNat,
    q1 := let x := ws.getD 1 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    q2 := let x := ws.getD 2 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    q3 := let x := ws.getD 3 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    q4 := let x := ws.getD 4 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    rollspeed := let x := ws.getD 5 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    pitchspeed := let x := ws.getD 6 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    yawspeed := let x := ws.getD 7 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat),
    repr_offset_q := Array.ofFn (n := 4) fun i => let x := ws.getD (8 + i.val) 0; ExecFloat.Binary.ofBits32 (UInt32.ofNat x.toNat) }

end AttitudeQuaternion

