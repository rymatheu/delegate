  | .attitudeQuaternion _ => "ATTITUDE_QUATERNION"
  | .localPositionNed _ => "LOCAL_POSITION_NED"
  | .globalPositionInt _ => "GLOBAL_POSITION_INT"
  | .missionItem _ => "MISSION_ITEM"
  | .missionRequest _ => "MISSION_REQUEST"
