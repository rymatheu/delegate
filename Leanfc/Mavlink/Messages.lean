def toWords (m : Attitude) : Array Int :=
  #[Int.ofNat m.time_boot_ms.toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.roll).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.pitch).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.yaw).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.rollspeed).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.pitchspeed).toNat] ++
  #[Int.ofNat (ExecFloat.Binary.toBits32 m.yawspeed).toNat]

