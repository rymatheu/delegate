  | .messageInterval _ => "MESSAGE_INTERVAL"
  | .extendedSysState _ => "EXTENDED_SYS_STATE"
  | .statustext _ => "STATUSTEXT"
  | .paramError _ => "PARAM_ERROR"

/-- Message id and full (untruncated) payload in wire order. -/
def encode : Msg → UInt32 × ByteArray
  | .heartbeat m => (0, m.encode)
  | .sysStatus m => (1, m.encode)
  | .systemTime m => (2, m.encode)
  | .ping m => (4, m.encode)
  | .setMode m => (11, m.encode)
  | .paramRequestRead m => (20, m.encode)
  | .paramRequestList m => (21, m.encode)
  | .paramValue m => (22, m.encode)
