/-! ## Transposes -/

theorem sqZ_transpose {n : ℕ} (p : ℕ) (M : Matrix (Fin n) (Fin n) ℤ) :
    sqZ^[p] Mᵀ = (sqZ^[p] M)ᵀ := by
  rw [sqZ_iter, sqZ_iter, transpose_pow]

/-- The response of the transposed model is the forward trajectory. -/
theorem resp_transpose {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (D : Fin n → ℝ) (m : ℕ) (j : Fin n) :
    resp Aᵀ D m j = rsp A (Pi.single j 1) D m := by
  simp only [resp, rsp, ← transpose_pow, dotProduct_mulVec, vecMul_transpose]
  rw [dotProduct_comm]
  exact dotProduct_mulVec _ _ _

theorem forward_transpose {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (D : Fin n → ℝ) (m : ℕ) :
    D ᵥ* Aᵀ ^ m = A ^ m *ᵥ D := by
  rw [← transpose_pow, vecMul_transpose]

/-- **A tail from a state**: `Σₘ |o A^{M+m} D| ≤ Σⱼ xbⱼ Gⱼ` when `|(A^M D)ⱼ| ≤ xbⱼ` and `Gⱼ` bounds
the ℓ1 gains of `o` per coordinate. -/
theorem tail_of_state {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (o D : Fin n → ℝ) (M : ℕ)
    (xb G : Fin n → ℝ) (hx : ∀ j, |(A ^ M *ᵥ D) j| ≤ xb j)
    (hG : ∀ j N, ∑ m ∈ range N, |resp A o m j| ≤ G j) (K : ℕ) :
    ∑ m ∈ range K, |rsp A o D (M + m)| ≤ ∑ j, xb j * G j := by
  have e : ∀ m, rsp A o D (M + m) = ∑ j, (A ^ M *ᵥ D) j * resp A o m j := by
    intro m
    rw [rsp, add_comm, pow_add, ← mulVec_mulVec, dot_mulVec_eq]
  calc ∑ m ∈ range K, |rsp A o D (M + m)|
      ≤ ∑ m ∈ range K, ∑ j, |(A ^ M *ᵥ D) j| * |resp A o m j| := Finset.sum_le_sum fun m _ => by
        rw [e]; refine (Finset.abs_sum_le_sum_abs _ _).trans (le_of_eq ?_)
        exact Finset.sum_congr rfl fun j _ => abs_mul _ _
    _ = ∑ j, |(A ^ M *ᵥ D) j| * ∑ m ∈ range K, |resp A o m j| := by
        rw [Finset.sum_comm]; simp only [Finset.mul_sum]
    _ ≤ ∑ j, xb j * G j := Finset.sum_le_sum fun j _ =>
        mul_le_mul (hx j) (hG j K) (Finset.sum_nonneg fun _ _ => abs_nonneg _)
          ((abs_nonneg _).trans (hx j))

/-- Groups of eight chunks give every chunk. -/
theorem chk_of_groups (f : ℕ → Bool) (G : ℕ) (h : ∀ g < G, allOK f 8 (8 * g) = true) :
    ∀ c < 8 * G, f c = true := by
  intro c hc
  have := allOK_spec f 8 (8 * (c / 8)) (h (c / 8) (by omega)) (c % 8) (Nat.mod_lt _ (by norm_num))
  rwa [show 8 * (c / 8) + c % 8 = c by omega] at this

