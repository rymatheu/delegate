    zS3 zP3 (GVHq 3) (PVHq 3) n1 n3 n2 n4 n5 n6 n7
  · intro i; rw [e1]; fin_cases i <;> simp [vec, outV, Sq]
  · intro j; rw [e2]; fin_cases j <;> rfl

theorem out4 : (∀ j N', ∑ m ∈ Finset.range N', |resp VerticalHi.AvR (outV 4) m j| ≤ (GVHq 4 j : ℝ)) ∧
    ∀ j m, |resp VerticalHi.AvR (outV 4) m j| ≤ (PVHq 4 j : ℝ) := by
  obtain ⟨i1, i2⟩ := init4
  have e1 := eqT_spec _ _ i1
  have e2 := eqU_spec _ _ i2
  obtain ⟨n1, n2, n3, n4, n5, n6, n7⟩ := num4
  refine gain_assemble VerticalHi.Ahat VerticalHi.DAz VerticalHi.AvR (by decide) hA (R := Rq)
    (lam := VerticalHi.lamv) (by norm_num [Rq]) (by norm_num [VerticalHi.lamv])
    (by norm_num [VerticalHi.lamv]) hpow (outV 4) vec nat step ad mx
    step_spec ad_spec mx_spec zU eqT eqU eqT_spec eqU_spec 32 64 128 cp4 chk4 (by norm_num)
    (by norm_num) (S := Sq) (by norm_num [Sq]) ?_ ?_ ρ_check 11 64 Mn (by norm_num) Mn_check
    zS4 zP4 (GVHq 4) (PVHq 4) n1 n3 n2 n4 n5 n6 n7
  · intro i; rw [e1]; fin_cases i <;> simp [vec, outV, Sq]
  · intro j; rw [e2]; fin_cases j <;> rfl

end GainVHi

theorem peakVH' (o : Fin 5) (j : Fin 8) (m : ℕ) : |resp VerticalHi.AvR (outV o) m j| ≤ PVH o j := by
  simp only [PVH]
  fin_cases o
  · exact GainVHi.out0.2 j m
  · exact GainVHi.out1.2 j m
  · exact GainVHi.out2.2 j m
  · exact GainVHi.out3.2 j m
  · exact GainVHi.out4.2 j m

theorem gainVH' (o : Fin 5) (j : Fin 8) (N : ℕ) :
    ∑ m ∈ range N, |resp VerticalHi.AvR (outV o) m j| ≤ GVH o j := by
  simp only [GVH]
  fin_cases o
  · exact GainVHi.out0.1 j N
  · exact GainVHi.out1.1 j N
  · exact GainVHi.out2.1 j N
  · exact GainVHi.out3.1 j N
  · exact GainVHi.out4.1 j N

end

