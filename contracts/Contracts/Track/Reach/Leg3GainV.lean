theorem chk4 : ∀ c < 128, chkAt step ad mx zU eqT eqU 32 64 cp4 c = true := by
  intro c hc
  have h := Nat.div_add_mod c 8
  have hg : c / 8 < 16 := by omega
  have hr : c % 8 < 8 := Nat.mod_lt _ (by norm_num)
  have key : ∀ g < 16, allOK (chkAt step ad mx zU eqT eqU 32 64 cp4) 8 (8 * g) = true := by
    intro g hg
    interval_cases g
    · exact grp4_0
    · exact grp4_1
    · exact grp4_2
    · exact grp4_3
    · exact grp4_4
    · exact grp4_5
    · exact grp4_6
    · exact grp4_7
    · exact grp4_8
    · exact grp4_9
    · exact grp4_10
    · exact grp4_11
    · exact grp4_12
    · exact grp4_13
    · exact grp4_14
    · exact grp4_15
  have := allOK_spec _ 8 (8 * (c / 8)) (key _ hg) (c % 8) hr
  rwa [h] at this

theorem num4 : (∀ j, 0 ≤ zS4 j) ∧ (∀ j, 0 ≤ zP4 j) ∧
    (∀ j, ((fun i => ((nat (cp4 128).2.1 i : ℚ) - nat (cp4 64).2.1 i) / Sq + (32 * (128 - 64) : ℕ) * ρq)
      ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j + (zS4 ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j ≤ zS4 j) ∧
    (∀ j, ((fun i => (nat (cp4 128).2.2 i : ℚ) / Sq + ρq)
      ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j + (zP4 ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j ≤ zP4 j) ∧
    (∀ j, (nat (cp4 128).2.1 j : ℚ) / Sq + (32 * 128 : ℕ) * ρq + zS4 j ≤ GVHq 4 j) ∧
    (∀ j, (max (nat (cp4 64).2.2 j) (nat (cp4 128).2.2 j) : ℚ) / Sq + ρq ≤ PVHq 4 j) ∧
    (∀ j, zP4 j ≤ PVHq 4 j) := by
  decide +kernel

theorem hA : ∀ i j, (VerticalHi.Ahat i j : ℝ) = (VerticalHi.DAz : ℝ) * VerticalHi.AvR i j := by
  intro i j
  have h := VerticalHi.Ahat_spec i j
  have h' : ((VerticalHi.Ahat i j : ℚ) : ℝ) = ((VerticalHi.DAz * VerticalHi.Av i j : ℚ) : ℝ) := by
    rw [h]
  push_cast at h'
  simpa [VerticalHi.AvR] using h'

theorem castLp_inv : Vertical.castM VerticalHi.Lp * Vertical.castM VerticalHi.Lpinv = 1 := by
  rw [← Vertical.castM_mul, VerticalHi.Lp_mul_inv]
  ext i j
  simp only [Vertical.castM, Matrix.map_apply, Matrix.one_apply]
  split_ifs <;> simp

theorem coord (x : Fin 8 → ℝ) (i : Fin 8) : x i ^ 2 ≤ (Cq : ℝ) * VerticalHi.V x := by
  have h := coord_of_ldl VerticalHi.PvR (Vertical.castM VerticalHi.Lp)
    (Vertical.castM VerticalHi.Lpinv) (fun k => (VerticalHi.Dp k : ℝ))
    (fun k => by exact_mod_cast VerticalHi.Dp_pos k) (Vertical.castM_ldl VerticalHi.certP)
    castLp_inv x i
  have hc : (∑ k, (Vertical.castM VerticalHi.Lpinv) k i ^ 2 / (VerticalHi.Dp k : ℝ)) ≤ (Cq : ℝ) := by
    have := C_check i
    have h2 : (((∑ k, VerticalHi.Lpinv k i ^ 2 / VerticalHi.Dp k : ℚ)) : ℝ) ≤ (Cq : ℝ) := by
      exact_mod_cast this
    push_cast at h2
    simpa [Vertical.castM] using h2
  exact h.trans (mul_le_mul_of_nonneg_right hc (VerticalHi.V_nonneg x))

theorem V_single (j : Fin 8) : VerticalHi.V (Pi.single j 1) ≤ (Pmq : ℝ) := by
  have e : VerticalHi.V (Pi.single j 1) = (VerticalHi.Pv j j : ℝ) := by
    simp [VerticalHi.V, Vertical.qf, VerticalHi.PvR, Vertical.castM, mulVec, dotProduct,
      Pi.single_apply]
  rw [e]; exact_mod_cast Pm_check j

theorem hpow : ∀ p i j, |(VerticalHi.AvR ^ p) i j| ≤ (Rq : ℝ) * (VerticalHi.lamv : ℝ) ^ p := by
  intro p i j
  refine pow_entry_le VerticalHi.AvR VerticalHi.V (fun x => VerticalHi.V_A x) coord
    (by norm_num [Cq]) V_single (by norm_num [Rq]) ?_ (by norm_num [VerticalHi.lamv]) p i j
  have := R_check
  exact_mod_cast this

