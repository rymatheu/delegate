theorem chk4 : ∀ c < 128, chkAt step ad mx zU eqT eqU 32 64 cp4 c = true := by
  intro c hc
  have h := Nat.div_add_mod c 8
  have hg : c / 8 < 16 := by omega
  have hr : c % 8 < 8 := Nat.mod_lt _ (by norm_num)
  have key : ∀ g < 16, allOK (chkAt step ad mx zU eqT eqU 32 64 cp4) 8 (8 * g) = true := by
    intro g hg
    interval_cases g
    · exact grp4_0
    · exact grp4_1
    · exact grp4_2
    · exact grp4_3
    · exact grp4_4
    · exact grp4_5
    · exact grp4_6
    · exact grp4_7
    · exact grp4_8
    · exact grp4_9
    · exact grp4_10
    · exact grp4_11
    · exact grp4_12
    · exact grp4_13
    · exact grp4_14
    · exact grp4_15
  have := allOK_spec _ 8 (8 * (c / 8)) (key _ hg) (c % 8) hr
  rwa [h] at this

theorem num4 : (∀ j, 0 ≤ zS4 j) ∧ (∀ j, 0 ≤ zP4 j) ∧
    (∀ j, ((fun i => ((nat (cp4 128).2.1 i : ℚ) - nat (cp4 64).2.1 i) / Sq + (32 * (128 - 64) : ℕ) * ρq)
      ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j + (zS4 ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j ≤ zS4 j) ∧
    (∀ j, ((fun i => (nat (cp4 128).2.2 i : ℚ) / Sq + ρq)
      ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j + (zP4 ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j ≤ zP4 j) ∧
    (∀ j, (nat (cp4 128).2.1 j : ℚ) / Sq + (32 * 128 : ℕ) * ρq + zS4 j ≤ GHq 4 j) ∧
    (∀ j, (max (nat (cp4 64).2.2 j) (nat (cp4 128).2.2 j) : ℚ) / Sq + ρq ≤ PHq 4 j) ∧
    (∀ j, zP4 j ≤ PHq 4 j) := by
  decide +kernel

theorem hA : ∀ i j, (Horizontal.Ahat i j : ℝ) = (Horizontal.DAh : ℝ) * Horizontal.AhR i j := by
  intro i j
  have h := Horizontal.Ahat_spec i j
  have h' : ((Horizontal.Ahat i j : ℚ) : ℝ) = ((Horizontal.DAh * Horizontal.Ah i j : ℚ) : ℝ) := by rw [h]
  push_cast at h'
  simpa [Horizontal.AhR] using h'

theorem castLp_inv : Horizontal.castM Horizontal.Lp * Horizontal.castM Horizontal.Lpinv = 1 := by
  rw [← Horizontal.castM_mul, Horizontal.Lp_mul_inv]
  ext i j
  simp only [Horizontal.castM, Matrix.map_apply, Matrix.one_apply]
  split_ifs <;> simp

theorem coord (x : Fin 9 → ℝ) (i : Fin 9) : x i ^ 2 ≤ (Cq : ℝ) * Horizontal.V x := by
  have h := coord_of_ldl Horizontal.PhR (Horizontal.castM Horizontal.Lp) (Horizontal.castM Horizontal.Lpinv) (fun k => (Horizontal.Dp k : ℝ))
    (fun k => by exact_mod_cast Horizontal.Dp_pos k) (Horizontal.castM_ldl Horizontal.certP) castLp_inv x i
  have hc : (∑ k, (Horizontal.castM Horizontal.Lpinv) k i ^ 2 / (Horizontal.Dp k : ℝ)) ≤ (Cq : ℝ) := by
    have := C_check i
    have h2 : (((∑ k, Horizontal.Lpinv k i ^ 2 / Horizontal.Dp k : ℚ)) : ℝ) ≤ (Cq : ℝ) := by exact_mod_cast this
    push_cast at h2
    simpa [Horizontal.castM] using h2
  exact h.trans (mul_le_mul_of_nonneg_right hc (Horizontal.V_nonneg x))

theorem V_single (j : Fin 9) : Horizontal.V (Pi.single j 1) ≤ (Pmq : ℝ) := by
  have e : Horizontal.V (Pi.single j 1) = (Horizontal.Ph j j : ℝ) := by
    simp [Horizontal.V, Vertical.qf, Horizontal.PhR, Horizontal.castM, mulVec, dotProduct, Pi.single_apply]
  rw [e]; exact_mod_cast Pm_check j

theorem hpow : ∀ p i j, |(Horizontal.AhR ^ p) i j| ≤ (Rq : ℝ) * (Horizontal.lamh : ℝ) ^ p := by
  intro p i j
  refine pow_entry_le Horizontal.AhR Horizontal.V (fun x => Horizontal.V_A x) coord (by norm_num [Cq]) V_single
    (by norm_num [Rq]) ?_ (by norm_num [Horizontal.lamh]) p i j
  have := R_check
  exact_mod_cast this

theorem out0 : (∀ j N', ∑ m ∈ Finset.range N', |resp Horizontal.AhR (outH 0) m j| ≤ (GHq 0 j : ℝ)) ∧
    ∀ j m, |resp Horizontal.AhR (outH 0) m j| ≤ (PHq 0 j : ℝ) := by
  obtain ⟨i1, i2⟩ := init0
  have e1 := eqT_spec _ _ i1
  have e2 := eqU_spec _ _ i2
  obtain ⟨n1, n2, n3, n4, n5, n6, n7⟩ := num0
  refine gain_assemble Horizontal.Ahat Horizontal.DAh Horizontal.AhR (by decide) hA (R := Rq) (lam := Horizontal.lamh)
    (by norm_num [Rq]) (by norm_num [Horizontal.lamh]) (by norm_num [Horizontal.lamh]) hpow (outH 0) vec nat step ad mx
    step_spec ad_spec mx_spec zU eqT eqU eqT_spec eqU_spec 32 64 128 cp0 chk0 (by norm_num) (by norm_num)
    (S := Sq) (by norm_num [Sq]) ?_ ?_ ρ_check 11 64 Mn (by norm_num) Mn_check zS0 zP0 (GHq 0) (PHq 0)
    n1 n3 n2 n4 n5 n6 n7
  · intro i; rw [e1]; fin_cases i <;> simp [vec, outH, Sq]
  · intro j; rw [e2]; fin_cases j <;> rfl

