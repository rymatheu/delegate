      ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j + (zP4 ᵥ* Mn.map (fun k => (k : ℚ) / 2 ^ 64)) j ≤ zP4 j) ∧
    (∀ j, (nat (cp4 64).2.1 j : ℚ) / Sq + (32 * 64 : ℕ) * ρq + zS4 j ≤ GVq 4 j) ∧
    (∀ j, (max (nat (cp4 32).2.2 j) (nat (cp4 64).2.2 j) : ℚ) / Sq + ρq ≤ PVq 4 j) ∧
    (∀ j, zP4 j ≤ PVq 4 j) := by
  decide +kernel

theorem hA : ∀ i j, (Vertical.Ahat i j : ℝ) = (Vertical.DAz : ℝ) * Vertical.AvR i j := by
  intro i j
  have h := Vertical.Ahat_spec i j
  have h' : ((Vertical.Ahat i j : ℚ) : ℝ) = ((Vertical.DAz * Vertical.Av i j : ℚ) : ℝ) := by rw [h]
  push_cast at h'
  simpa [Vertical.AvR] using h'

theorem castLp_inv : Vertical.castM Vertical.Lp * Vertical.castM Vertical.Lpinv = 1 := by
  rw [← Vertical.castM_mul, Vertical.Lp_mul_inv]
  ext i j
  simp only [Vertical.castM, Matrix.map_apply, Matrix.one_apply]
  split_ifs <;> simp

theorem coord (x : Fin 8 → ℝ) (i : Fin 8) : x i ^ 2 ≤ (Cq : ℝ) * Vertical.V x := by
  have h := coord_of_ldl Vertical.PvR (Vertical.castM Vertical.Lp) (Vertical.castM Vertical.Lpinv) (fun k => (Vertical.Dp k : ℝ))
    (fun k => by exact_mod_cast Vertical.Dp_pos k) (Vertical.castM_ldl Vertical.certP) castLp_inv x i
  have hc : (∑ k, (Vertical.castM Vertical.Lpinv) k i ^ 2 / (Vertical.Dp k : ℝ)) ≤ (Cq : ℝ) := by
    have := C_check i
    have h2 : (((∑ k, Vertical.Lpinv k i ^ 2 / Vertical.Dp k : ℚ)) : ℝ) ≤ (Cq : ℝ) := by exact_mod_cast this
    push_cast at h2
    simpa [Vertical.castM] using h2
  exact h.trans (mul_le_mul_of_nonneg_right hc (Vertical.V_nonneg x))

theorem V_single (j : Fin 8) : Vertical.V (Pi.single j 1) ≤ (Pmq : ℝ) := by
  have e : Vertical.V (Pi.single j 1) = (Vertical.Pv j j : ℝ) := by
    simp [Vertical.V, Vertical.qf, Vertical.PvR, Vertical.castM, mulVec, dotProduct, Pi.single_apply]
  rw [e]; exact_mod_cast Pm_check j

theorem hpow : ∀ p i j, |(Vertical.AvR ^ p) i j| ≤ (Rq : ℝ) * (Vertical.lamv : ℝ) ^ p := by
  intro p i j
  refine pow_entry_le Vertical.AvR Vertical.V (fun x => Vertical.V_A x) coord (by norm_num [Cq]) V_single
    (by norm_num [Rq]) ?_ (by norm_num [Vertical.lamv]) p i j
  have := R_check
  exact_mod_cast this

theorem out0 : (∀ j N', ∑ m ∈ Finset.range N', |resp Vertical.AvR (outV 0) m j| ≤ (GVq 0 j : ℝ)) ∧
    ∀ j m, |resp Vertical.AvR (outV 0) m j| ≤ (PVq 0 j : ℝ) := by
  obtain ⟨i1, i2⟩ := init0
  have e1 := eqT_spec _ _ i1
  have e2 := eqU_spec _ _ i2
  obtain ⟨n1, n2, n3, n4, n5, n6, n7⟩ := num0
  refine gain_assemble Vertical.Ahat Vertical.DAz Vertical.AvR (by decide) hA (R := Rq) (lam := Vertical.lamv)
    (by norm_num [Rq]) (by norm_num [Vertical.lamv]) (by norm_num [Vertical.lamv]) hpow (outV 0) vec nat step ad mx
    step_spec ad_spec mx_spec zU eqT eqU eqT_spec eqU_spec 32 32 64 cp0 chk0 (by norm_num) (by norm_num)
    (S := Sq) (by norm_num [Sq]) ?_ ?_ ρ_check 10 64 Mn (by norm_num) Mn_check zS0 zP0 (GVq 0) (PVq 0)
    n1 n3 n2 n4 n5 n6 n7
  · intro i; rw [e1]; fin_cases i <;> simp [vec, outV, Sq]
  · intro j; rw [e2]; fin_cases j <;> rfl

