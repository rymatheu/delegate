    eqE ((vtC.getD c []).getD 32 (0, 0, 0)) ((vtC.getD (c + 1) []).getD 0 (0, 0, 0)) &&
    GainV.eqT (runC 32 (cp c) (vtC.getD c [])) (cp (c + 1))

