/-! ### From the stored response to the model -/

/-- The integer input of one step. -/
def inpZ (e e' : E3) (r : Fin 8) : ℤ :=
  2 ^ 24 * (e.2.2 * DBv r - (if r = 0 then Vertical.DAz * (e'.1 - e.1) - Dh * e.2.1 - Dh2 * e.2.2 else 0) -
    (if r = 1 then Vertical.DAz * (e'.2.1 - e.2.1) - Dh * e.2.2 else 0))

theorem fstep_spec (x : Z8) (e e' : E3) (r : Fin 8) :
    GainV.vec (fstep x e e') r = (∑ j, Vertical.Ahat r j * GainV.vec x j + inpZ e e' r) / Vertical.DAz := by
  obtain ⟨x0, x1, x2, x3, x4, x5, x6, x7⟩ := x
  obtain ⟨P, V, A⟩ := e
  obtain ⟨P2, V2, A2⟩ := e'
  fin_cases r <;>
    simp only [fstep, GainV.vec, inpZ, DBv, Dh, Dh2, Fin.sum_univ_succ, Fin.sum_univ_zero, Vertical.Ahat,
      Vertical.DAz, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_succ,
      Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.cons_val, Fin.isValue, Fin.zero_eta, Fin.mk_one,
      Fin.reduceFinMk] <;>
    norm_num <;> ring_nf

theorem DBv_spec : ∀ r, (DBv r : ℚ) = Vertical.DAz * Vertical.Bv r := by decide +kernel
theorem Dh_spec : (Dh : ℚ) = Vertical.DAz * Vertical.per := by decide +kernel
theorem Dh2_spec : (Dh2 : ℚ) = Vertical.DAz * (Vertical.per ^ 2 / 2) := by decide +kernel

theorem inpZ_real (i : ℕ) (r : Fin 8) :
    (inpZ (vt i) (vt (i + 1)) r : ℝ) = (2 ^ 64 : ℝ) * Vertical.DAz * Vertical.forceOf vtRef i r := by
  have hB : ∀ r, ((DBv r : ℤ) : ℝ) = (Vertical.DAz : ℝ) * Vertical.BvR r := by
    intro r
    have h : ((DBv r : ℚ) : ℝ) = ((Vertical.DAz * Vertical.Bv r : ℚ) : ℝ) := by rw [DBv_spec]
    push_cast at h; simpa [Vertical.BvR] using h
  have hh : ((Dh : ℤ) : ℝ) = (Vertical.DAz : ℝ) * (Vertical.per : ℝ) := by
    have h : ((Dh : ℚ) : ℝ) = ((Vertical.DAz * Vertical.per : ℚ) : ℝ) := by rw [Dh_spec]
    push_cast at h; exact h
  have hh2 : ((Dh2 : ℤ) : ℝ) = (Vertical.DAz : ℝ) * ((Vertical.per : ℝ) ^ 2 / 2) := by
    have h : ((Dh2 : ℚ) : ℝ) = ((Vertical.DAz * (Vertical.per ^ 2 / 2) : ℚ) : ℝ) := by rw [Dh2_spec]
    push_cast at h; exact h
  simp only [inpZ, Vertical.forceOf, Vertical.defect₁, Vertical.defect₂, vtRef, Vertical.e0, Vertical.e1,
    Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  push_cast
  rw [hB r, hh, hh2]
  fin_cases r <;> simp <;> ring

/-- `x.1 = vec x 0`. -/
theorem fst_eq_vec (x : Z8) : x.1 = GainV.vec x 0 := by
  obtain ⟨x0, x1, x2, x3, x4, x5, x6, x7⟩ := x; rfl

/-- **The legs 1–7 response**: within `10⁻¹³` of the stored one. -/
theorem resp_close (i : ℕ) :
    |Vertical.errResp vtRef i 0 - ((Xf i).1 : ℝ) / 2 ^ 64| ≤ 1 / 10 ^ 13 := by
  have h := round_err_fwd Vertical.Ahat Vertical.DAz Vertical.AvR (by decide) GainV.hA
    (fun i => GainV.vec (Xf i)) (fun i => inpZ (vt i) (vt (i + 1))) (Vertical.forceOf vtRef)
    (S := 2 ^ 64) (by norm_num) (by norm_num [GainV.Rq]) (by norm_num [Vertical.lamv])
    (by norm_num [Vertical.lamv]) GainV.hpow (by funext r; fin_cases r <;> rfl)
    (fun i r => by simp only [Xf]; exact fstep_spec _ _ _ r) (fun i r => inpZ_real i r) i 0
  rw [fst_eq_vec]
  refine h.trans ?_
  norm_num [GainV.Rq, Vertical.lamv]

