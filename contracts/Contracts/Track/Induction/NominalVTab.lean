theorem chkC_all : ∀ c < 169, chkC c = true := by
  intro c hc
  have g : ∀ q < 13, allOK chkC 13 (13 * q) = true := by
    intro q hq
    match q, hq with
    | 0, _ => exact chkG0
    | 1, _ => exact chkG1
    | 2, _ => exact chkG2
    | 3, _ => exact chkG3
    | 4, _ => exact chkG4
    | 5, _ => exact chkG5
    | 6, _ => exact chkG6
    | 7, _ => exact chkG7
    | 8, _ => exact chkG8
    | 9, _ => exact chkG9
    | 10, _ => exact chkG10
    | 11, _ => exact chkG11
    | 12, _ => exact chkG12
  have := allOK_spec chkC 13 (13 * (c / 13)) (g _ (by omega)) (c % 13) (Nat.mod_lt _ (by norm_num))
  rwa [Nat.div_add_mod] at this

theorem vt_zero : vt 0 = (0, 0, 0) := by decide +kernel

theorem runC_spec : ∀ (n : ℕ) (i : ℕ) (l : List E3), (∀ j ≤ n, l.getD j (0, 0, 0) = vt (i + j)) →
    n + 1 ≤ l.length → runC n (Xf i) l = Xf (i + n)
  | 0, i, l, _, _ => by simp [runC]
  | n + 1, i, l, hl, hlen => by
    rcases l with _ | ⟨e, _ | ⟨e', rest⟩⟩
    · simp at hlen
    · simp at hlen
    · have h0 := hl 0 (by omega)
      have h1 := hl 1 (by omega)
      simp only [List.getD_cons_zero, add_zero, List.getD_cons_succ] at h0 h1
      have ih := runC_spec n (i + 1) (e' :: rest) (fun j hj => by
        have := hl (j + 1) (by omega)
        simp only [List.getD_cons_succ] at this
        rw [this]; congr 1; omega) (by simp at hlen ⊢; omega)
      simp only [runC]
      rw [h0, show fstep (Xf i) (vt i) e' = fstep (Xf i) (vt i) (vt (i + 1)) by rw [h1],
        show fstep (Xf i) (vt i) (vt (i + 1)) = Xf (i + 1) from rfl, ih]
      congr 1; omega

theorem chunk_entries (c : ℕ) (hc : c < 169) : ∀ j ≤ 32, (vtC.getD c []).getD j (0, 0, 0) = vt (32 * c + j) := by
  intro j hj
  have h := chkC_all c hc
  simp only [chkC, Bool.and_eq_true, beq_iff_eq] at h
  rcases (by omega : j < 32 ∨ j = 32) with hj | hj
  · simp only [vt]
    rw [show (32 * c + j) / 32 = c by omega, show (32 * c + j) % 32 = j by omega]
  · subst hj
    rw [eqE_spec _ _ h.1.2]
    simp only [vt]
    rw [show (32 * c + 32) / 32 = c + 1 by omega, show (32 * c + 32) % 32 = 0 by omega]

theorem cp_eq : ∀ c ≤ 169, cp c = Xf (32 * c) := by
  intro c hc
  induction c with
  | zero => exact GainV.eqT_spec _ _ (by decide +kernel : GainV.eqT (cp 0) (0, 0, 0, 0, 0, 0, 0, 0) = true)
  | succ c ih =>
    have h := chkC_all c (by omega)
    simp only [chkC, Bool.and_eq_true, beq_iff_eq] at h
    rw [← GainV.eqT_spec _ _ h.2, ih (by omega), runC_spec 32 (32 * c) _ (chunk_entries c (by omega))
      (by omega)]
    congr 1

/-- The window check: along chunk `c`, the stored first coordinate is in `[lo, hi]` on `[a, b]`. -/
def runB (a b : ℕ) (lo hi : ℤ) : ℕ → ℕ → Z8 → List E3 → Bool
  | n + 1, i, x, e :: e' :: rest =>
      (!(decide (a ≤ i ∧ i ≤ b)) || (decide (lo ≤ x.1) && decide (x.1 ≤ hi))) &&
        runB a b lo hi n (i + 1) (fstep x e e') (e' :: rest)
  | _, _, _, _ => true

theorem runB_spec (a b : ℕ) (lo hi : ℤ) : ∀ (n i : ℕ) (l : List E3),
    (∀ j ≤ n, l.getD j (0, 0, 0) = vt (i + j)) → n + 1 ≤ l.length →
    runB a b lo hi n i (Xf i) l = true → ∀ j < n, a ≤ i + j → i + j ≤ b →
      lo ≤ (Xf (i + j)).1 ∧ (Xf (i + j)).1 ≤ hi
  | 0, _, _, _, _, _, j, hj, _, _ => absurd hj (Nat.not_lt_zero _)
  | n + 1, i, l, hl, hlen, h, j, hj, ha, hb => by
    rcases l with _ | ⟨e, _ | ⟨e', rest⟩⟩
    · simp at hlen
    · simp at hlen
    · have h0 := hl 0 (by omega)
      have h1 := hl 1 (by omega)
      simp only [List.getD_cons_zero, add_zero, List.getD_cons_succ] at h0 h1
      subst h0 h1
      simp only [runB, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
        decide_eq_true_eq] at h
      rcases j with _ | j
      · rcases h.1 with h' | h'
        · exact absurd ⟨by omega, by omega⟩ h'
        · simpa using h'
      · rw [show fstep (Xf i) (vt i) (vt (i + 1)) = Xf (i + 1) from rfl] at h
        have := runB_spec a b lo hi n (i + 1) (vt (i + 1) :: rest) (fun j hj => by
          have := hl (j + 1) (by omega)
          simp only [List.getD_cons_succ] at this
          rw [this]; congr 1; omega) (by simp at hlen ⊢; omega) h.2 j (by omega) (by omega) (by omega)
        rwa [show i + 1 + j = i + (j + 1) by omega] at this

def chkW (a b : ℕ) (lo hi : ℤ) (c : ℕ) : Bool := runB a b lo hi 32 (32 * c) (cp c) (vtC.getD c [])

set_option maxHeartbeats 0 in
theorem window (a b : ℕ) (lo hi : ℤ) (c0 nc : ℕ) (hc : c0 + nc ≤ 169) (h0 : 32 * c0 ≤ a)
    (h1 : b < 32 * (c0 + nc)) (hW : allOK (chkW a b lo hi) nc c0 = true) (i : ℕ) (hi1 : a ≤ i)
    (hi2 : i ≤ b) : lo ≤ (Xf i).1 ∧ (Xf i).1 ≤ hi := by
  have hci := allOK_spec _ nc c0 hW (i / 32 - c0) (by omega)
  rw [show c0 + (i / 32 - c0) = i / 32 by omega] at hci
  simp only [chkW] at hci
  rw [cp_eq _ (by omega)] at hci
  have := runB_spec a b lo hi 32 (32 * (i / 32)) _ (chunk_entries _ (by omega)) (by
    have h := chkC_all (i / 32) (by omega)
    simp only [chkC, Bool.and_eq_true, beq_iff_eq] at h
    omega) hci (i % 32) (Nat.mod_lt _ (by norm_num)) (by omega) (by omega)
  rwa [Nat.div_add_mod] at this

