/-! ## Bang-bang pattern sums -/

/-- The stored first components (`ez` of the step response). -/
def Elist : List ℕ := trajA.map (fun v => v.1)

/-- `|dz a - dz b - dz c + dz d| ≤ B` on the first `n` entries (in `ℕ`, the offsets cancel). -/
def allB (B : ℕ) : ℕ → List ℕ → List ℕ → List ℕ → List ℕ → Bool
  | n + 1, a :: as, b :: bs, c :: cs, d :: ds =>
      (Nat.ble (a + d) (b + c + B) && Nat.ble (b + c) (a + d + B)) && allB B n as bs cs ds
  | _, _, _, _, _ => true

/-- The pattern `(G1, 160, G3)`: `E k - E (k - G1) - E (k - G1 - 160) + E (k - G1 - 160 - G3)`
for `k < 1736`. -/
def patOK (B G1 G3 : ℕ) : Bool :=
  allB B 1736 Elist (List.replicate G1 OFFz ++ Elist) (List.replicate (G1 + 160) OFFz ++ Elist)
    (List.replicate (G1 + 160 + G3) OFFz ++ Elist)

/-- The pattern bound, `0.08485 · Sz`. -/
