/-! ## ℓ1 sum, maxima and tails -/

/-- `Σ_{m < n} |E (m+1) - E m|` (in `ℕ`). -/
def l1sum : ℕ → List ℕ → ℕ
  | n + 1, a :: tl => (match tl with | b :: _ => (max a b - min a b) | [] => 0) + l1sum n tl
  | _, _ => 0

def L1z : ℕ := 1275048659150438

theorem l1_check : l1sum 3000 Elist ≤ L1z := by decide +kernel

/-- `|E_V m| ≤ 0.000632` on the stored range. -/
def BVz : ℕ := 6948913487544

def allAbsLe (B : ℕ) : List ℕ → Bool
  | [] => true
  | a :: tl => (Nat.ble a (OFFz + B) && Nat.ble OFFz (a + B)) && allAbsLe B tl

theorem EV_check : allAbsLe BVz (trajV.map (fun v => v.1)) = true := by decide +kernel

/-- Rational vector of a stored state. -/
def vecQ (v : V8) : Fin 8 → ℚ := fun i => (vecOf v i : ℚ) / Sz

/-- The steady state of the unit-step response: `Av X∞ + Bv = X∞`. -/
def Xinf : Fin 8 → ℚ := ![0, 0, 0, 0, 1 / amax, -(1 / amax), -(1 / amax), -(1 / amax)]

theorem Xinf_fixed : Av *ᵥ Xinf + Bv = Xinf := by decide +kernel

def qfQ (P : Matrix (Fin 8) (Fin 8) ℚ) (v : Fin 8 → ℚ) : ℚ := v ⬝ᵥ (P *ᵥ v)

/-- Tail of the pattern sums: `V (y 1000 - X∞)`. -/
theorem tailA_check : qfQ Pv (vecQ (trajA.getD 1000 default) - Xinf) ≤ 1 / gamv * (18 / 100000) := by
  decide +kernel

/-- Tail of the ℓ1 sum: `V (y 3001 - y 3000)`. -/
theorem tailG_check : qfQ Pv (vecQ (trajA.getD 3001 default) - vecQ (trajA.getD 3000 default)) ≤
    1 / gamv * (4 / 10 ^ 14) := by
  decide +kernel

/-- Tail of `E_V`: `V (yV 800)`. -/
theorem tailV_check : qfQ Pv (vecQ (trajV.getD 800 default)) ≤ 1 / gamv * (21 / 10 ^ 9) := by
  decide +kernel

/-- `E_P` from its start: `γ V (-(h²/2) e₀) ≤ 10⁻¹⁰`. -/
def vP : Fin 8 → ℚ := ![-(per ^ 2 / 2), 0, 0, 0, 0, 0, 0, 0]

theorem EP_check : gamv * qfQ Pv vP ≤ 1 / 10 ^ 10 := by
  decide +kernel

end

