noncomputable abbrev castM {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℚ) : Matrix (Fin m) (Fin n) ℝ :=
  M.map (Rat.castHom ℝ)

set_option maxHeartbeats 4000000 in
theorem jtick_eq0 (x : Fin 14 → ℝ) (u : Fin 7 → ℝ) :
    jtick 0 x u = castM Aj0 *ᵥ x + castM Bj *ᵥ u := by
  funext i
  fin_cases i <;>
    simp [jtick, Aj0, Bj, castM, mulVec, dotProduct, Fin.sum_univ_succ, hc, hp, aE, kpPos, kpH,
      kiH, kdH, aT, kpR, kiR, kdR, kP, kv, bR] <;> ring

set_option maxHeartbeats 4000000 in
theorem jtick_eq1 (x : Fin 14 → ℝ) (u : Fin 7 → ℝ) :
    jtick 1 x u = castM Aj1 *ᵥ x + castM Bj *ᵥ u := by
  funext i
  fin_cases i <;>
    simp [jtick, Aj1, Bj, castM, mulVec, dotProduct, Fin.sum_univ_succ, hc, hp, aE, kpPos, kpH,
