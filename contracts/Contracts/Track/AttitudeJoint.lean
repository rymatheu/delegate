import Contracts.Track.Vertical

/-!
# The joint per-axis model of the horizontal and attitude loops (milestone M4 with M6)

One horizontal NED axis of the closed loop, in the linear regime, at the period `h = 1/400`:
the position controller (`AC_P_2D` and `AC_PID_2D`, as in `Horizontal.lean`), the attitude input
shaping (`attitude_command_model` in its linear zone, with the `sqrt_controller_accel` switch
`σ ∈ {0, 1}`), the angle P controller (`sqrt_controller` linear zone, `kP = 9`), the rate PID
(`AC_PID`: 20 Hz target and derivative filters, `FLTE = 0`), the QUAD-X mixer and the rigid body's
attitude and position rows (exact zero-order-hold integration of the linearized dynamics). The
attitude quantities are scaled by `g`, so that a tilt is the horizontal acceleration it produces
(`s = g·θ`, m/s²): the desired tilt is the command `c` itself.

State `x : Fin 14 → ℝ`:

| # | state | code / plant |
|---|---|---|
| 0 | `e = p - sp` | position against `_pos_target_ned_m` |
| 1 | `ev = v - vsp` | velocity against `_vel_desired_ned_ms` |
| 2–4 | `E, D, I` | `_pid_vel_ne_m` (5 Hz error and derivative filters, integrator) |
| 5 | `sT` | the attitude target's tilt before this tick's `update_attitude_target` |
| 6 | `om` | the shaped target rate `_ang_vel_target_rads` (body axis) |
| 7 | `a` | attitude error `θT - θ` (the angle P controller's input) |
| 8 | `v` | rate error `ωT - ω` |
| 9–12 | `Tt, Er, Dr, Ir` | rate PID: target filter (relative to `om`), error, derivative, integrator |
| 13 | `bt` | the rate target of the previous tick minus `om`: `_ang_vel_body_rads - ωT` |

Inputs `u : Fin 7 → ℝ`: `asp` (target acceleration, feedforward), `d₁, d₂` (the target sequence's
defects, as in `Vertical.lean`), and the perturbations `dal` (shaping acceleration: jerk/accel clamp
defect, float error), `dw` (rate: gyroscopic torque, plant remainder), `ds` (tilt), `db` (rate target:
feedforward projection, float error).
-/

namespace Contracts.Track.AttJ

open Matrix

/-! ## Constants (exact rationals: the `float` values the code computes) -/

/-- The code's `dt` (`0.0025f`). -/
def hc : ℚ := 5368709 / 2147483648
/-- The plant period. -/
def hp : ℚ := 1 / 400
/-- 5 Hz filter coefficient of `AC_PID_2D`. -/
def aE : ℚ := 4886901 / 67108864
def kpPos : ℚ := 3 / 2
def kpH : ℚ := 6
def kiH : ℚ := 1
def kdH : ℚ := 1 / 2
/-- 20 Hz filter coefficient of the rate PID (target and derivative). -/
def aT : ℚ := 16042859 / 67108864
def kpR : ℚ := 9059697 / 67108864
def kiR : ℚ := 9059697 / 67108864
def kdR : ℚ := 7730941 / 2147483648
/-- Angle P (`ATC_ANG_RLL_P = ATC_ANG_PIT_P = 9`). -/
def kP : ℚ := 9
/-- Shaping gain `k_v = 1 / ATC_INPUT_TC`. -/
def kv : ℚ := 20
/-- Roll/pitch angular acceleration per unit mixer input, `2 · lever · fmax / Jx`. -/
def bR : ℚ := 2 * (28 / 1000) * ((9 / 4) * (196133 / 20000) * (27 / 1000) / 4) / (14 / 1000000)

/-! ## The tick -/

/-- One tick of the joint per-axis model (the order of `Vehicle.tick`: rate PID and mixer on the
previous tick's rate target, then the position controller, the shaping, the angle P controller; then
the plant over the period). `σ` is the `sqrt_controller_accel` switch (`0` or `1`). -/
noncomputable def jtick (σ : ℝ) (x : Fin 14 → ℝ) (u : Fin 7 → ℝ) : Fin 14 → ℝ :=
  let e := x 0; let ev := x 1; let E := x 2; let D := x 3; let I := x 4
  let sT := x 5; let om := x 6; let a := x 7; let v := x 8
  let Tt := x 9; let Er := x 10; let Dr := x 11; let Ir := x 12; let bt := x 13
  let asp := u 0; let d1 := u 1; let d2 := u 2; let dal := u 3; let dw := u 4; let ds := u 5
  let db := u 6
  -- AC_P_2D + AC_PID_2D
  let Ep := (1 - aE) * E + aE * (-kpPos * e - ev)
  let Dp := (1 - aE) * D + aE / hc * (Ep - E)
  let Ip := I + kiH * hc * Ep
  let c := kpH * Ep + Ip + kdH * Dp + asp
  -- rate PID (target ωb of the previous tick, measurement ω)
  let That := (1 - aT) * Tt + aT * bt
  let Erp := That + v
  let Drp := (1 - aT) * Dr + aT / hc * (Erp - Er)
  let Irp := Ir + kiR * hc * Erp
  let uu := kpR * Erp + kdR * Drp + Irp
  -- update_attitude_target, attitude_command_model, angle P
  let thT := sT + hc * om
  let es := c - thT
  let al := kv * kv * es - kv * (1 + σ) * om + dal
  let omp := om + hc * al
  let btp := kP * a + db
  let Ttp := That - hc * al
  -- the plant: tilt s = θT - a, rate w = ωT - v
  let s := thT - a
  let w := om - v
  let wp := w + hp * bR * uu + dw
  let sp := s + hp * w + hp ^ 2 / 2 * bR * uu + ds
  let evp := ev + hp * s + hp ^ 2 / 2 * w + hp ^ 3 / 6 * bR * uu - hp * asp - d2
  let ep := e + hp * ev + hp ^ 2 / 2 * s + hp ^ 3 / 6 * w + hp ^ 4 / 24 * bR * uu
    - hp ^ 2 / 2 * asp - d1
  let thTn := thT + hc * omp
  ![ep, evp, Ep, Dp, Ip, thT, omp, thTn - sp, omp - wp, Ttp, Erp, Drp, Irp, btp]

