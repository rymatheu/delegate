def crosstrack_error_m (s : State) : Float32 := Id.run do
  let pos_error : Vector2f.State := Vector2p.tofloat (Vector2p.op_sub_Vector2p ({ x := s._pos_target_ned_m.x, y := s._pos_target_ned_m.y } : Vector2p.State) (Vector3p.xy s._pos_estimate_ned_m))
  if AC_PosControl_lib.is_zero_float (Vector2f.length_squared ({ x := s._vel_desired_ned_ms.x, y := s._vel_desired_ned_ms.y } : Vector2f.State)) then
    return Vector2f.length pos_error
  else
    let vel_unit : Vector2f.State := Vector2f.normalized ({ x := s._vel_desired_ned_ms.x, y := s._vel_desired_ned_ms.y } : Vector2f.State)
    let dot_error : Float32 := Vector2f.op_mul_Vector2f pos_error vel_unit
    return AC_PosControl_lib.safe_sqrt_float (AC_PosControl_lib.MAX_float2 (Vector2f.length_squared pos_error - AC_PosControl_lib.sq_float dot_error) (Float.toFloat32 (0.0 : Float)))

