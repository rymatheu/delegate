  o := t'4
  return (s, o)

/-- C++ `bool AP_MotorsMatrix::init(uint8_t expected_num_motors)`, `AP_Motors/AP_MotorsMatrix.cpp:45-95`. -/
def init_uint8_t (s : State) (o : Outputs) (expected_num_motors : UInt8) : State × Outputs × Bool := Id.run do
  let mut s := s
  let mut o := o
  if UInt32.toInt32 (AP_Motors.motor_frame_class.toInt s._active_frame_class) != UInt32.toInt32 (AP_Motors.motor_frame_class.toInt AP_Motors.motor_frame_class.MOTOR_FRAME_SCRIPTING_MATRIX) then
    return (s, o, false)
  let mut num_motors : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  for i' in [0:32] do
    let i : UInt8 := Nat.toUInt8 i'
    if s.motor_enabled[UInt8.toNat i]! then
      num_motors := num_motors + (1 : UInt8)
  s := set_initialised_ok s (UInt32.toInt32 (UInt8.toUInt32 expected_num_motors) == UInt32.toInt32 (UInt8.toUInt32 num_motors))
  if !(initialised_ok s) then
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_GENERIC }
    return (s, o, false)
  let t'1 := UInt32.toInt32 (UInt8.toUInt32 num_motors)
  if t'1 == (3 : Int32) then
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_TRICOPTER }
  else if t'1 == (4 : Int32) then
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_QUADROTOR }
  else if t'1 == (6 : Int32) then
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_HEXAROTOR }
  else if t'1 == (8 : Int32) then
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_OCTOROTOR }
  else if t'1 == (10 : Int32) then
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_DECAROTOR }
  else if t'1 == (12 : Int32) then
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_DODECAROTOR }
  else
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_GENERIC }
  s := normalise_rpy_factors s
  let (t'2, t'3) := set_update_rate s o s._speed_hz
  s := t'2
  o := t'3
  return (s, o, true)

/-- C++ `bool AP_MotorsMatrix::set_throttle_factor(int8_t motor_num, float throttle_factor)`, `AP_Motors/AP_MotorsMatrix.cpp:98-112`. -/
def set_throttle_factor (s : State) (motor_num : Int8) (throttle_factor : Float32) : State × Bool := Id.run do
  let mut s := s
  if (UInt32.toInt32 (AP_Motors.motor_frame_class.toInt s._active_frame_class) != UInt32.toInt32 (AP_Motors.motor_frame_class.toInt AP_Motors.motor_frame_class.MOTOR_FRAME_SCRIPTING_MATRIX)) then
    return (s, false)
  if initialised_ok s || !s.motor_enabled[Int8.toNatClampNeg motor_num]! then
    return (s, false)
  s := { s with _throttle_factor := s._throttle_factor.set! (Int8.toNatClampNeg motor_num) throttle_factor }
  return (s, true)

/-- C++ `void AP_MotorsMatrix::set_frame_class_and_type(motor_frame_class frame_class, motor_frame_type frame_type)`, `AP_Motors/AP_MotorsMatrix.cpp:131-142`. -/
def set_frame_class_and_type (s : State) (o : Outputs) (frame_class : AP_Motors.motor_frame_class) (frame_type : AP_Motors.motor_frame_type) : State × Outputs := Id.run do
  let mut s := s
  let mut o := o
  if armed_void s || (UInt32.toInt32 (AP_Motors.motor_frame_class.toInt frame_class) == UInt32.toInt32 (AP_Motors.motor_frame_class.toInt s._active_frame_class) && UInt32.toInt32 (AP_Motors.motor_frame_type.toInt s._active_frame_type) == UInt32.toInt32 (AP_Motors.motor_frame_type.toInt frame_type)) then
    return (s, o)
  s := { s with _active_frame_class := frame_class }
  s := { s with _active_frame_type := frame_type }
  let (t'1, t'2) := init_motor_frame_class_motor_frame_type s o frame_class frame_type
  s := t'1
  o := t'2
  return (s, o)

/-- C++ `bool AP_MotorsMatrix::output_test_num(uint8_t motor, int16_t pwm)`, `AP_Motors/AP_MotorsMatrix.cpp:483-501`. -/
def output_test_num (s : State) (o : Outputs) (output_channel : UInt8) (pwm : Int16) : Outputs × Bool := Id.run do
  let mut o := o
  if !(armed_void s) then
    return (o, false)
  if UInt32.toInt32 (UInt8.toUInt32 output_channel) > (32 : Int32) - (1 : Int32) then
    return (o, false)
  if !s.motor_enabled[UInt8.toNat output_channel]! then
    return (o, false)
  o := o.push (Output.rc_write output_channel (Int16.toUInt16 pwm))
  return (o, true)

