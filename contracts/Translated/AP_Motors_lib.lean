/-- C++ `void AP_MotorsMatrix::normalise_rpy_factors()`, `AP_Motors/AP_MotorsMatrix.cpp:1354-1388`. -/
def normalise_rpy_factors (s : State) : State := Id.run do
  let mut s := s
  let mut roll_fac : Float32 := (0.0 : Float32)
  let mut pitch_fac : Float32 := (0.0 : Float32)
  let mut yaw_fac : Float32 := (0.0 : Float32)
  let mut throttle_fac : Float32 := (0.0 : Float32)
  for i' in [0:32] do
    let i : UInt8 := Nat.toUInt8 i'
    if s.motor_enabled[UInt8.toNat i]! then
      roll_fac := AP_Motors_lib.MAX_float2 roll_fac (Float32.abs s._roll_factor[UInt8.toNat i]!)
      pitch_fac := AP_Motors_lib.MAX_float2 pitch_fac (Float32.abs s._pitch_factor[UInt8.toNat i]!)
      yaw_fac := AP_Motors_lib.MAX_float2 yaw_fac (Float32.abs s._yaw_factor[UInt8.toNat i]!)
      throttle_fac := AP_Motors_lib.MAX_float2 throttle_fac (AP_Motors_lib.MAX_float2 (0.0 : Float32) s._throttle_factor[UInt8.toNat i]!)
  for i' in [0:32] do
    let i : UInt8 := Nat.toUInt8 i'
    if s.motor_enabled[UInt8.toNat i]! then
      if !(AP_Motors_lib.is_zero_float roll_fac) then
        s := { s with _roll_factor := s._roll_factor.set! (UInt8.toNat i) ((0.5 : Float32) * s._roll_factor[UInt8.toNat i]! / roll_fac) }
      if !(AP_Motors_lib.is_zero_float pitch_fac) then
        s := { s with _pitch_factor := s._pitch_factor.set! (UInt8.toNat i) ((0.5 : Float32) * s._pitch_factor[UInt8.toNat i]! / pitch_fac) }
      if !(AP_Motors_lib.is_zero_float yaw_fac) then
        s := { s with _yaw_factor := s._yaw_factor.set! (UInt8.toNat i) ((0.5 : Float32) * s._yaw_factor[UInt8.toNat i]! / yaw_fac) }
      if !(AP_Motors_lib.is_zero_float throttle_fac) then
        s := { s with _throttle_factor := s._throttle_factor.set! (UInt8.toNat i) (AP_Motors_lib.MAX_float2 (0.0 : Float32) (s._throttle_factor[UInt8.toNat i]! / throttle_fac)) }
  return s

/-- C++ `void AP_MotorsMatrix::setup_motors(motor_frame_class frame_class, motor_frame_type frame_type)`, `AP_Motors/AP_MotorsMatrix.cpp:1291-1350`. -/
def setup_motors (s : State) (o : Outputs) (frame_class : AP_Motors.motor_frame_class) (frame_type : AP_Motors.motor_frame_type) : State × Outputs := Id.run do
  let mut s := s
  let mut o := o
  for i' in [0:32] do
    let i : Int8 := Nat.toInt8 i'
    s := remove_motor s i
  s := set_initialised_ok s false
  let mut success : Bool := true
  match frame_class with
  | .MOTOR_FRAME_QUAD =>
    let (t'1, t'2, t'3) := setup_quad_matrix s o frame_type
    s := t'1
    o := t'2
    success := t'3
  | .MOTOR_FRAME_HEXA =>
    let (t'4, t'5, t'6) := setup_hexa_matrix s o frame_type
    s := t'4
    o := t'5
    success := t'6
  | .MOTOR_FRAME_OCTA =>
    let (t'7, t'8, t'9) := setup_octa_matrix s o frame_type
    s := t'7
    o := t'8
    success := t'9
  | .MOTOR_FRAME_OCTAQUAD =>
    let (t'10, t'11, t'12) := setup_octaquad_matrix s o frame_type
    s := t'10
    o := t'11
    success := t'12
  | .MOTOR_FRAME_DODECAHEXA =>
    let (t'13, t'14, t'15) := setup_dodecahexa_matrix s o frame_type
    s := t'13
    o := t'14
    success := t'15
  | .MOTOR_FRAME_Y6 =>
    let (t'16, t'17, t'18) := setup_y6_matrix s o frame_type
    s := t'16
    o := t'17
    success := t'18
  | .MOTOR_FRAME_DECA =>
    let (t'19, t'20, t'21) := setup_deca_matrix s o frame_type
    s := t'19
    o := t'20
    success := t'21
  | _ =>
    success := false
    s := { s with _mav_type := MAV_TYPE.MAV_TYPE_GENERIC }
  s := normalise_rpy_factors s
  if !success then
    s := { s with _frame_class_string := "UNSUPPORTED" }
  s := set_initialised_ok s success
  return (s, o)

