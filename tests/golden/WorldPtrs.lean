namespace Store

/-- C++ `void Store::note(float v)`, `examples/worldptr.cpp:202`. -/
def note (s : State) (v : Binary32) : State := Id.run do
  let mut s := s
  s := { s with _last := v }
  s := { s with _n := s._n + (1 : UInt32) }
  return s

/-- C++ `float Store::last() const`, `examples/worldptr.cpp:203`. -/
def last (s : State) : Binary32 := Id.run do
  return s._last

/-- C++ `static Store * Store::get_singleton()`, `examples/worldptr.cpp:196-201`. -/
def get_singleton (w : World) : World × WPtr := Id.run do
  let mut w := w
  if !(w.Store'_singleton != WPtr.null) then
    let t'1 := w.heap'Store.size
    w := { w with heap'Store := w.heap'Store.push ({} : Store.State) }
    w := { w with Store'_singleton := (WPtr.heap'Store t'1) }
  return (w, w.Store'_singleton)

end Store

namespace Core

/-- C++ `Core::Core(Filter * frontend, uint8_t idx)`, `examples/worldptr.cpp:217`. -/
def init (frontend : WPtr) (idx : UInt8) : State := Id.run do
  let mut s : State := {}
  s := { s with frontend := frontend }
  s := { s with _idx := idx }
  return s

/-- C++ `void Core::step(float x)`, `examples/worldptr.cpp:255-258`. -/
def step (s : State) (w : World) (x : Binary32) : State := Id.run do
  let mut s := s
  s := { s with _x := s._x + (w.filter.gain * (x - s._x) + UInt8.toBinary32 s._idx) }
  return s

/-- C++ `float Core::state() const`, `examples/worldptr.cpp:219`. -/
def state (s : State) : Binary32 := Id.run do
  return s._x

end Core

namespace Filter

/-- C++ `bool Filter::init(uint8_t n)`, `examples/worldptr.cpp:228-241`. -/
def init (s : State) (w : World) (n : UInt8) : State × World × Bool := Id.run do
  let mut s := s
  let mut w := w
  if s.core != WPtr.null || UInt32.toInt32 (UInt8.toUInt32 n) == (0 : Int32) || decide (UInt32.toInt32 (UInt8.toUInt32 n) > (2 : Int32)) then
    return (s, w, false)
  let t'1 := w.heap'Core.size
  w := { w with heap'Core := w.heap'Core ++ Array.replicate (UInt64.toNat (UInt8.toUInt64 n)) ({} : Core.State) }  -- C++ `(Core *)malloc(sizeof(Core) * n)`: k slots, constructed by placement new
  s := { s with core := (WPtr.heap'Core t'1) }
  if s.core == WPtr.null then
    return (s, w, false)
  s := { s with num_cores := n }
  let mut i : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    if !(decide (UInt32.toInt32 (UInt8.toUInt32 i) < UInt32.toInt32 (UInt8.toUInt32 s.num_cores))) then break
    let t'2 := Core.init WPtr.filter i
    w := { w with heap'Core := w.heap'Core.set! ((WPtr.index s.core) + (UInt8.toNat i)) t'2 }
    i := i + (1 : UInt8)
  return (s, w, true)

/-- C++ `void Filter::update(float x)`, `examples/worldptr.cpp:242-247`. -/
def update (s : State) (w : World) (x : Binary32) : State × World := Id.run do
  let mut s := s
  let mut w := w
  let mut i : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  for _ in [0:2^64] do  -- C loop without a constant trip count (--general-loops)
    if !(decide (UInt32.toInt32 (UInt8.toUInt32 i) < UInt32.toInt32 (UInt8.toUInt32 s.num_cores))) then break
    w := { w with filter := s }  -- this object's state into the World: the call reaches it
    w := { w with heap'Core := w.heap'Core.set! ((WPtr.index s.core) + (UInt8.toNat i)) (Core.step w.heap'Core[((WPtr.index s.core) + (UInt8.toNat i))]! w x) }
    s := w.filter  -- this object's state as the call left it
    i := i + (1 : UInt8)
  let (t'1, t'2) := Store.get_singleton w
  w := t'1
  let t'3 := (WPtr.index t'2)
  w := { w with heap'Store := w.heap'Store.set! t'3 (Store.note w.heap'Store[t'3]! x) }
  return (s, w)

/-- C++ `float Filter::core_state(uint8_t i) const`, `examples/worldptr.cpp:248`. -/
def core_state (s : State) (w : World) (i : UInt8) : Binary32 := Id.run do
  return if UInt32.toInt32 (UInt8.toUInt32 i) < UInt32.toInt32 (UInt8.toUInt32 s.num_cores) then Core.state w.heap'Core[((WPtr.index s.core) + (UInt8.toNat i))]! else (Binary32.ofBits 0x00000000 /- 0.0f -/)

end Filter

/-- The construction of the file-scope objects, in definition order (C++ static initialization). -/
def World.init : World := Id.run do
  let mut w : World := {}
  w := { w with barometer := Baro.construct }
  return w

end WorldPtrs
