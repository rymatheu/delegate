    turn_vel := t'11
    turn_accel := t'12
    let (t'13, t'14, t'15, t'16) := SCurve.move_from_time_pos_vel_accel next_leg (time_to_destination * (0.5 : Float32)) turn_pos turn_vel turn_accel
