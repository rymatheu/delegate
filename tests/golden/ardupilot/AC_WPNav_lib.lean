    let (t'1, _) := Vector3p.op_add_assign pos (Vector3f.todouble delta_pos)
    pos := t'1
    let mut arc_tangent_ne : Vector2f.State := Vector2f.op_mul_float (Vector2f.init_float2 (-center_to_pos_ne.y) center_to_pos_ne.x) turn_dir
    let (t'3, _) := Vector2f.op_div_assign arc_tangent_ne s.arc.radius_ne
    arc_tangent_ne := t'3
    let horiz_ds : Float32 := s.arc.length_ne / s.seg_length
    let path_unit : Vector3f.State := Vector3f.init_float3 (arc_tangent_ne.x * horiz_ds) (arc_tangent_ne.y * horiz_ds) dz_ds
    let (t'5, _) := Vector3f.op_add_assign vel (Vector3f.op_mul_float path_unit scurve_V1)
    vel := t'5
    let (t'7, _) := Vector3f.op_add_assign accel (Vector3f.op_mul_float path_unit scurve_A1)
    accel := t'7
    let (t'9, _) := Vector2f.op_sub_assign ({ x := accel.x, y := accel.y } : Vector2f.State) (Vector2f.op_mul_float center_to_pos_ne (AC_WPNav_lib.sq_float (scurve_V1 * horiz_ds / s.arc.radius_ne)))
    accel := { accel with x := t'9.x, y := t'9.y }
    return (s, pos, vel, accel)
  let path_unit : Vector3f.State := Vector3f.normalized s.seg_delta
  let (t'11, _) := Vector3p.op_add_assign pos (Vector3p.op_mul_double (Vector3f.todouble path_unit) (Float32.toFloat scurve_P1))
  pos := t'11
  let (t'13, _) := Vector3f.op_add_assign vel (Vector3f.op_mul_float path_unit scurve_V1)
  vel := t'13
  let (t'15, _) := Vector3f.op_add_assign accel (Vector3f.op_mul_float path_unit scurve_A1)
  accel := t'15
  return (s, pos, vel, accel)

