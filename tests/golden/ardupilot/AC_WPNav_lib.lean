def kinematic_limit_float5 (dir_xy dir_z max_xy max_z_neg max_z_pos : Float32) : Float32 := Id.run do
  let mut dir_xy := dir_xy
  let mut dir_z := dir_z
  if is_negative_float dir_xy || !(is_positive_float max_xy) || !(is_positive_float max_z_pos) || !(is_positive_float max_z_neg) then
    return Float.toFloat32 (0.0 : Float)
  let dir_length : Float32 := safe_sqrt_float (sq_float dir_xy + sq_float dir_z)
  if !(is_positive_float dir_length) then
    return Float.toFloat32 (0.0 : Float)
  if is_zero_float dir_xy then
    return if is_positive_float dir_z then max_z_pos else max_z_neg
  if is_zero_float dir_z then
    return max_xy
  dir_xy := dir_xy / dir_length
  dir_z := dir_z / dir_length
  let slope : Float32 := dir_z / dir_xy
  if is_positive_float slope then
    if slope < max_z_pos / max_xy then
      return max_xy / dir_xy
    return max_z_pos / dir_z
  if -slope < max_z_neg / max_xy then
    return max_xy / dir_xy
  return -max_z_neg / dir_z

