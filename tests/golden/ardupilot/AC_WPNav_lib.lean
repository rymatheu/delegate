  let mut accel := accel
  if AC_WPNav_lib.is_zero_float s.seg_length then
    return (s, pos, vel, accel)
  if s.is_arc_segment then
    if !(AC_WPNav_lib.is_positive_float s.arc.radius_ne) then
      pure ()  -- C++ `printf(...)`: left out (--drop)
      pure ()  -- C++ `AP_InternalError::error(...)`: left out (--drop)
      s := init s
      return (s, pos, vel, accel)
    let mut center_to_pos_ne : Vector2f.State := Vector2f.op_sub_void s.arc.center_ne
    let turn_dir : Float32 := if AC_WPNav_lib.is_negative_float s.arc.angle_rad then -(1.0 : Float32) else (1.0 : Float32)
    center_to_pos_ne := Vector2f.rotate center_to_pos_ne (turn_dir * Float32.abs s.arc.angle_rad * (scurve_P1 / s.seg_length))
