/-- C++ `void Dal::start_frame(uint32_t t)`, `examples/ekfdal.cpp:39-48`. -/
def start_frame (s : State) (w : World) (t : UInt32) : State × World := Id.run do
  let mut s := s
  let mut w := w
  if t != s._last then
    s := { s with _last := t }
    s := { s with _frames := s._frames + (1 : UInt32) }
    for i' in [0:3] do
      let i : UInt8 := Nat.toUInt8 i'
      s := { s with _loc := s._loc.set! (UInt8.toNat i) (s._loc[UInt8.toNat i]! + UInt8.toBinary32 i + (Binary32.ofBits 0x3f000000 /- 0.5f -/)) }
  w := { w with Dal'force_write := !w.Dal'force_write }
  return (s, w)

/-- C++ `const float & Dal::location(uint8_t i) const`, `examples/ekfdal.cpp:54`. -/
def location (s : State) (i : UInt8) : Binary32 := Id.run do
