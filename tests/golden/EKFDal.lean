namespace Front

/-- C++ `bool Front::init(uint8_t n)`, `examples/ekfdal.cpp:107-118`. -/
def init (s : State) (w : World) (n : UInt8) : State × World × Bool := Id.run do
  let mut s := s
  let mut w := w
  if s.core != WPtr.null || UInt32.toInt32 (UInt8.toUInt32 n) == (0 : Int32) || decide (UInt32.toInt32 (UInt8.toUInt32 n) > (2 : Int32)) then
    return (s, w, false)
  let t'1 := w.heap'Core.size
  w := { w with heap'Core := w.heap'Core ++ Array.replicate (UInt64.toNat (UInt8.toUInt64 n)) ({} : Core.State) }  -- C++ `(Core *)malloc(sizeof(Core) * n)`: k slots, constructed by placement new
  s := { s with core := (WPtr.heap'Core t'1) }
  s := { s with num_cores := n }
  let t'2 : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  let t'3 : Int32 := UInt32.toInt32 (UInt8.toUInt32 s.num_cores)
  for i' in [0:(t'3.toInt - (Int.ofNat t'2.toNat)).toNat] do  -- C++ loop bounded by a runtime value (--runtime-loops)
    let i : UInt8 := t'2 + Nat.toUInt8 i'
    let t'4 := Core.init WPtr.front
    w := { w with heap'Core := w.heap'Core.set! ((WPtr.index s.core) + (UInt8.toNat i)) t'4 }
    w := { w with heap'Core := w.heap'Core.set! ((WPtr.index s.core) + (UInt8.toNat i)) (Core.set_lim w.heap'Core[((WPtr.index s.core) + (UInt8.toNat i))]! i) }
  return (s, w, true)

/-- C++ `void Front::update(uint32_t t, float x)`, `examples/ekfdal.cpp:119-129`. -/
def update (s : State) (w : World) (t : UInt32) (x : Binary32) : State × World := Id.run do
  let mut s := s
  let mut w := w
  let (t'1, t'2) := Dal.start_frame w.heap'Dal[(WPtr.index w.Dal'_singleton)]! w t
  w := t'2
  w := { w with heap'Dal := w.heap'Dal.set! (WPtr.index w.Dal'_singleton) t'1 }
  pure ()  -- C++ `static uint32_t lastTime`: a World field (a static local)
  if w.Front_update'lastTime == Int32.toUInt32 (0 : Int32) || decide (x > (Binary32.ofBits 0x40a00000 /- 5.0f -/)) then
    w := { w with Front_update'lastTime := t }
  s := { s with selected := decide ((t - w.Front_update'lastTime) > Int32.toUInt32 (1000 : Int32)) }
  let t'3 : UInt8 := Int8.toUInt8 (Int32.toInt8 (0 : Int32))
  let t'4 : Int32 := UInt32.toInt32 (UInt8.toUInt32 s.num_cores)
  for i' in [0:(t'4.toInt - (Int.ofNat t'3.toNat)).toNat] do  -- C++ loop bounded by a runtime value (--runtime-loops)
    let i : UInt8 := t'3 + Nat.toUInt8 i'
    w := { w with front := s }  -- this object's state into the World: the call reaches it
    w := { w with heap'Core := w.heap'Core.set! ((WPtr.index s.core) + (UInt8.toNat i)) (Core.update w.heap'Core[((WPtr.index s.core) + (UInt8.toNat i))]! w t x) }
    s := w.front  -- this object's state as the call left it
  return (s, w)

/-- C++ `void Front::move_origin(float d)`, `examples/ekfdal.cpp:130`. -/
def move_origin (s : State) (w : World) (d : Binary32) : State × World := Id.run do
  let mut s := s
  let mut w := w
  s := { s with origin.alt := s.origin.alt + d }
  let (t'1, t'2) := Dal.log_event w.heap'Dal[(WPtr.index w.Dal'_singleton)]! w d
  w := t'2
  w := { w with heap'Dal := w.heap'Dal.set! (WPtr.index w.Dal'_singleton) t'1 }
  return (s, w)

/-- C++ `Front::Front()`, `examples/ekfdal.cpp:106`. -/
def construct (w : World) : State × World := Id.run do
  let mut s : State := {}
  let mut w := w
  let (t'1, t'2) := Dal.get_singleton w
  w := t'1
  let t'3 := (WPtr.index t'2)
  return (s, w)

end Front

/-- The construction of the file-scope objects, in definition order (C++ static initialization). -/
def World.init : World := Id.run do
  let mut w : World := {}
  let (t's, t'w) := Front.construct w
  w := { t'w with front := t's }
  return w

