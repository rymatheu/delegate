  let pkt : log_REC := { head := Int8.toUInt8 (Int32.toInt8 (7 : Int32)), value := v, quat := Quat.init, _end := (0 : UInt8) }
  s := { s with _rec := pkt }
  w := { w with Dal'events := w.Dal'events + (1 : UInt32) }
  return (s, w)

/-- C++ `static Dal * Dal::get_singleton()`, `examples/ekfdal.cpp:33-38`. -/
def get_singleton (w : World) : World × WPtr := Id.run do
  let mut w := w
  if !(w.Dal'_singleton != WPtr.null) then
    let t'1 := w.heap'Dal.size
    w := { w with heap'Dal := w.heap'Dal.push ({} : Dal.State) }
    w := { w with Dal'_singleton := (WPtr.heap'Dal t'1) }
  return (w, w.Dal'_singleton)

